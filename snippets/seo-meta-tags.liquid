{%- comment -%}
  Global search and social metadata.

  Shopify's content_for_header currently supplies a canonical URL and, on
  some product pages, an Open Graph image. Check that output before rendering
  either tag so the page never contains conflicting duplicates.
{%- endcomment -%}

{%- liquid
  assign seo_title = page_title | default: shop.name

  assign seo_description = page_description
  if seo_description == blank
    case request.page_type
      when 'index'
        assign seo_description = settings.default_meta_description
      when 'product'
        assign seo_description = product.description | strip_html
        if seo_description == blank
          capture seo_description
            echo 'Shop '
            echo product.title
            echo ' at Typewriters.com. Find expert product guidance, dependable service, and typewriter support.'
          endcapture
        endif
      when 'collection'
        assign seo_description = collection.description | strip_html
        if seo_description == blank
          capture seo_description
            echo 'Shop '
            echo collection.title
            echo ' at Typewriters.com. Find dependable typewriters, supplies, parts, and expert support for your machine.'
          endcapture
        endif
      when 'page'
        case page.handle
          when 'typewriter-manuals'
            assign seo_description = 'Browse free typewriter manuals for IBM, Brother, Nakajima, and other machines. Search by brand or model and open the correct guide online.'
          when 'typewriter-comparison-chart'
            assign seo_description = 'Compare IBM, Nakajima, and Royal typewriters by paper capacity, memory, display, spell check, dimensions, weight, warranty, and price.'
          when 'our-21-step-reconditioning-process'
            assign seo_description = 'Explore the Typewriters.com 21-step reconditioning process, from inspection and cleaning through adjustment, testing, supplies, and protective packing.'
          when 'typewriters-maintenance-guide'
            assign seo_description = 'Learn how to clean, store, maintain, and troubleshoot manual, electric, and electronic typewriters with practical care guidance.'
          when 'contact'
            assign seo_description = 'Contact the experienced Typewriters.com team for help choosing a typewriter, matching supplies, finding parts, or supporting your current machine.'
          when 'shipping-returns'
            assign seo_description = 'Review Typewriters.com shipping estimates, delivery information, return eligibility, refund timing, and restocking-fee details before ordering.'
          when 'our-warranty', 'our-warranty-1'
            assign seo_description = 'Review the Typewriters.com 90-day warranty for eligible typewriters, including covered defects, exclusions, and how to request support.'
          else
            assign seo_description = page.content | strip_html
            if seo_description == blank
              capture seo_description
                echo 'Learn about '
                echo page.title
                echo ' at Typewriters.com. Find dependable typewriter information, expert guidance, and customer support.'
              endcapture
            endif
        endcase
      when 'blog'
        capture seo_description
          echo 'Read '
          echo blog.title
          echo ' from Typewriters.com for typewriter advice, maintenance guidance, product education, and typewriter history.'
        endcapture
      when 'article'
        assign seo_description = article.excerpt_or_content | strip_html
      when 'search'
        capture seo_description
          echo 'Search Typewriters.com for new and reconditioned typewriters, ribbons, printwheels, manuals, supplies, and IBM parts.'
        endcapture
      when 'cart'
        assign seo_description = 'Review the products in your Typewriters.com shopping cart and continue securely to checkout.'
      when '404'
        assign seo_description = 'The requested Typewriters.com page could not be found. Browse our typewriters, supplies, printwheels, manuals, and IBM parts.'
    endcase
  endif
  if seo_description == blank
    assign seo_description = settings.default_meta_description | default: shop.description
  endif
  assign seo_description = seo_description | strip_html | strip_newlines | replace: '  ', ' ' | strip | truncate: 160

  assign seo_url = canonical_url | default: request.origin
  assign seo_type = 'website'
  if request.page_type == 'product'
    assign seo_type = 'product'
  elsif request.page_type == 'article'
    assign seo_type = 'article'
  endif

  assign seo_image = page_image
  if seo_image == blank and request.page_type == 'product' and product.featured_media != blank
    assign seo_image = product.featured_media.preview_image
  elsif seo_image == blank and request.page_type == 'article' and article.image != blank
    assign seo_image = article.image
  elsif seo_image == blank and settings.social_share_image != blank
    assign seo_image = settings.social_share_image
  elsif seo_image == blank and shop.brand.logo != blank
    assign seo_image = shop.brand.logo
  endif

  assign platform_has_canonical = false
  if content_for_header contains 'rel="canonical"' or content_for_header contains "rel='canonical'"
    assign platform_has_canonical = true
  endif

  assign platform_has_og_image = false
  if content_for_header contains 'property="og:image"' or content_for_header contains "property='og:image'"
    assign platform_has_og_image = true
  endif
-%}

<title>
  {{- seo_title | escape -}}
  {%- if current_tags -%} &ndash; tagged &ldquo;{{ current_tags | join: ', ' | escape }}&rdquo;{%- endif -%}
  {%- if current_page != 1 -%} &ndash; Page {{ current_page }}{%- endif -%}
  {%- unless seo_title contains shop.name -%} &ndash; {{ shop.name | escape }}{%- endunless -%}
</title>

{%- if seo_description != blank -%}
  <meta name="description" content="{{ seo_description | escape }}">
{%- endif -%}

{%- unless platform_has_canonical -%}
  <link rel="canonical" href="{{ seo_url }}">
{%- endunless -%}

{%- if request.page_type == 'search'
  or request.page_type == 'cart'
  or request.page_type == '404'
  or template contains 'customers'
  or page.handle contains 'wishlist'
-%}
  <meta name="robots" content="noindex,follow">
{%- endif -%}

<meta property="og:site_name" content="{{ shop.name | escape }}">
<meta property="og:url" content="{{ seo_url }}">
<meta property="og:title" content="{{ seo_title | escape }}">
<meta property="og:type" content="{{ seo_type }}">
{%- if seo_description != blank -%}
  <meta property="og:description" content="{{ seo_description | escape }}">
{%- endif -%}

{%- if seo_image != blank and platform_has_og_image == false -%}
  {%- assign seo_image_url = seo_image | image_url: width: 1200 -%}
  {%- unless seo_image_url contains 'http' -%}
    {%- assign seo_image_url = seo_image_url | prepend: 'https:' -%}
  {%- endunless -%}
  <meta property="og:image" content="{{ seo_image_url }}">
  <meta property="og:image:secure_url" content="{{ seo_image_url }}">
  <meta property="og:image:width" content="{{ seo_image.width }}">
  <meta property="og:image:height" content="{{ seo_image.height }}">
  <meta property="og:image:alt" content="{{ seo_image.alt | default: seo_title | escape }}">
{%- endif -%}

{%- if request.page_type == 'product' -%}
  <meta property="product:price:amount" content="{{ product.selected_or_first_available_variant.price | money_without_currency | strip_html }}">
  <meta property="product:price:currency" content="{{ cart.currency.iso_code | default: shop.currency }}">
  <meta property="product:availability" content="{% if product.available %}in stock{% else %}out of stock{% endif %}">
{%- elsif request.page_type == 'article' -%}
  <meta property="article:published_time" content="{{ article.published_at | date: '%Y-%m-%dT%H:%M:%S%z' }}">
  <meta property="article:modified_time" content="{{ article.updated_at | date: '%Y-%m-%dT%H:%M:%S%z' }}">
  {%- if article.author != blank -%}
    <meta property="article:author" content="{{ article.author | escape }}">
  {%- endif -%}
{%- endif -%}

<meta name="twitter:card" content="{% if seo_image != blank %}summary_large_image{% else %}summary{% endif %}">
<meta name="twitter:title" content="{{ seo_title | escape }}">
{%- if seo_description != blank -%}
  <meta name="twitter:description" content="{{ seo_description | escape }}">
{%- endif -%}
{%- if seo_image != blank -%}
  {%- assign twitter_image_url = seo_image | image_url: width: 1200 -%}
  {%- unless twitter_image_url contains 'http' -%}
    {%- assign twitter_image_url = twitter_image_url | prepend: 'https:' -%}
  {%- endunless -%}
  <meta name="twitter:image" content="{{ twitter_image_url }}">
  <meta name="twitter:image:alt" content="{{ seo_image.alt | default: seo_title | escape }}">
{%- endif -%}