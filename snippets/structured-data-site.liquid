{%- comment -%}
  Site-level structured data (JSON-LD): Organization + WebSite.

  Rendered once, in the <head> of every page via theme.liquid. Gives Google a
  canonical record of the business (name, logo, phone, social profiles) and
  enables a sitelinks search box for the storefront search.

  Usage (in layout/theme.liquid, before </head>):
    {% render 'structured-data-site' %}
{%- endcomment -%}

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": {{ shop.name | json }},
    "url": {{ shop.url | json }},
    "logo": {
  "@type": "ImageObject",
  "url": "https://cdn.shopify.com/s/files/1/0653/0262/6407/files/Monroe_Logo_1200x628_510a887b-6a4d-4e01-9bad-94e8e50c880b.png?v=1783430311",
  "contentUrl": "https://cdn.shopify.com/s/files/1/0653/0262/6407/files/Monroe_Logo_1200x628_510a887b-6a4d-4e01-9bad-94e8e50c880b.png?v=1783430311",
  "width": 1200,
  "height": 628
},
"image": {
  "@type": "ImageObject",
  "url": "https://cdn.shopify.com/s/files/1/0653/0262/6407/files/Monroe_M_logo_512x512_bdc672eb-b443-4e82-a5c6-8f017d0850bd.png?v=1786555404",
  "contentUrl": "https://cdn.shopify.com/s/files/1/0653/0262/6407/files/Monroe_M_logo_512x512_bdc672eb-b443-4e82-a5c6-8f017d0850bd.png?v=1786555404",
  "width": 512,
  "height": 512
},
    {%- if shop.description != blank %}
    "description": {{ shop.description | strip_html | json }},
    {%- endif %}
    "contactPoint": {
      "@type": "ContactPoint",
      "contactType": "customer service",
      "telephone": "+1-267-580-2600",
      "email": "csr@monroe-systems.com",
      "areaServed": "US",
      "availableLanguage": "English"
    },
    "sameAs": [
      "https://www.facebook.com/MonroeSystems/",
      "https://www.instagram.com/monroesystems/",
      "https://twitter.com/monroesystems",
      "https://www.youtube.com/c/Monroe-systems",
      "https://www.tiktok.com/@monroesystemsforbusiness",
      "https://www.linkedin.com/company/8446168"
    ]
  }
</script>

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": {{ shop.name | json }},
    "url": {{ shop.url | json }},
    "potentialAction": {
      "@type": "SearchAction",
      "target": {
        "@type": "EntryPoint",
        "urlTemplate": "{{ shop.url }}/search?q={search_term_string}"
      },
      "query-input": "required name=search_term_string"
    }
  }
</script>