{%- liquid
  assign card_heading_level = heading_level | default: 'h3'
  assign card_loading = loading | default: 'lazy'
  assign card_excerpt = show_excerpt
  if show_excerpt == nil
    assign card_excerpt = true
  endif
  assign card_alt = article.image.alt | default: article.title
-%}

<article class="tw-blog-card">
  <a class="tw-blog-card__media" href="{{ article.url }}" aria-label="Read {{ article.title | escape }}"{% if article.image != blank %} style="--tw-source-width: {{ article.image.width }}px; --tw-source-height: {{ article.image.height }}px;"{% endif %}>
    {%- if article.image != blank -%}
      {{ article.image | image_url: width: 1200 | image_tag:
        class: 'tw-blog-card__image', loading: card_loading,
        widths: '360, 540, 720, 960, 1200',
        sizes: '(min-width: 1200px) 370px, (min-width: 750px) 45vw, 100vw',
        alt: card_alt, width: article.image.width, height: article.image.height
      }}
    {%- else -%}
      {{ 'image' | placeholder_svg_tag: 'tw-blog-card__placeholder' }}
    {%- endif -%}
  </a>
  <div class="tw-blog-card__body">
    <p class="tw-blog-card__meta">
      {%- if article.author != blank -%}<span>{{ article.author | escape }}</span>{%- endif -%}
      {%- if article.author != blank and article.published_at != blank -%}<span aria-hidden="true">·</span>{%- endif -%}
      {%- if article.published_at != blank -%}<time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | date: '%b %d, %Y' }}</time>{%- endif -%}
    </p>
    <{{ card_heading_level }} class="tw-blog-card__title"><a href="{{ article.url }}">{{ article.title | escape }}</a></{{ card_heading_level }}>
    {%- if card_excerpt and article.excerpt_or_content != blank -%}<p class="tw-blog-card__excerpt">{{ article.excerpt_or_content | strip_html | truncatewords: 24 }}</p>{%- endif -%}
    <a class="tw-blog-card__link" href="{{ article.url }}">Read article<span class="visually-hidden">: {{ article.title | escape }}</span></a>
  </div>
</article>
