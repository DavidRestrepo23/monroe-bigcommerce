  <div class="ms-rib__intro" style="margin-top:16px;">
    <p>
      <em>Monroe P65M ribbon spools are universal ribbons.
      <a href="/products/monroe-p65m-premium-printing-calculator-ink-ribbon-spools-black-red-ink" target="_blank" rel="noopener">Click here</a>
      for full compatibility charts.</em>
      <br />
      <em>Compatible with Monroe 122PD calculators after serial number HK10XXXX.</em>
    </p>

    <p>
      <em>New style Monroe 7150 calculators are units with serial numbers starting with FL11 through FM.
      These calculators use Monroe P51S ribbon cartridges, whereas the older style is not compatible.</em>
    </p>

    <p>
      <em>Monroe 8125 calculators with serial numbers beginning with TS will only use a spool ribbon
      (<a href="/products/monroe-p65m-premium-printing-calculator-ink-ribbon-spools-black-red-ink" target="_blank" rel="noopener">Monroe P65M</a>).</em>
    </p>

    <p>
      If you do not see a ribbon listed for your machine, call <a href="tel:2675802600">267-580-2600</a>.
    </p>
  </div>

  <div class="ms-rib__bar" aria-hidden="true"></div>
</section>

<script>
/* =====================================================
   MONROE RIBBON COMPATIBILITY CHART (Interactive) – FULL JS
   Scoped: .ms-rib
   ===================================================== */
(function () {
  function qs(root, sel){ return root.querySelector(sel); }
  function qsa(root, sel){ return Array.prototype.slice.call(root.querySelectorAll(sel)); }
  function normalize(v){ return String(v || "").trim().toLowerCase(); }
  function setHidden(el, hidden){
    if(!el) return;
    if(hidden) el.setAttribute("hidden","");
    else el.removeAttribute("hidden");
  }

  function init(){
    var root = document.querySelector(".ms-rib");
    if(!root) return;

    var search = qs(root, ".ms-rib__search");
    var status = qs(root, ".ms-rib__status");
    var table  = qs(root, ".ms-rib__table");
    if(!table) return;

    var modelRows = qsa(table, "tbody tr.ms-rib__row");
    var groupRows = qsa(table, "tbody tr.ms-rib__groupRow");

    var filterInputs = qsa(root, ".ms-rib__filterInput");
    var ribbonFilters = filterInputs.filter(function(i){ return i.hasAttribute("data-ribbon"); });
    var groupFilters  = filterInputs.filter(function(i){ return i.hasAttribute("data-group"); });

    var chips = qsa(root, ".ms-rib__chip");

    var actionsWrap = qs(root, ".ms-rib__actions");
    var clearBtn = qs(root, '[data-action="clear-filters"]');

    /* ---------- Toggle button behavior (checkbox under hood) ---------- */
    var toggleLabels = qsa(root, ".ms-rib__toggle");

    function syncToggleAria(label){
      if(!label) return;
      var input = label.querySelector(".ms-rib__filterInput");
      if(!input) return;
      label.setAttribute("aria-pressed", input.checked ? "true" : "false");
    }

    toggleLabels.forEach(function(label){
      syncToggleAria(label);

      var input = label.querySelector(".ms-rib__filterInput");
      if(!input) return;

      /* Keep aria-pressed synced when checkbox changes */
      input.addEventListener("change", function(){
        syncToggleAria(label);
      });

      /* Enter / Space toggles like a button */
      label.addEventListener("keydown", function(e){
        var key = e.key || e.code;
        if(key === "Enter" || key === " " || key === "Spacebar"){
          e.preventDefault();
          input.checked = !input.checked;
          input.dispatchEvent(new Event("change", { bubbles:true }));
        }
      });

      /* If someone clicks the label, default behavior toggles the checkbox.
         After click, ensure aria updates even if browser timing differs. */
      label.addEventListener("click", function(){
        setTimeout(function(){ syncToggleAria(label); }, 0);
      });
    });

    function rowModelText(tr){
      var th = tr.querySelector("th");
      return normalize(th ? th.textContent : "");
    }

    function rowHasRibbon(tr, ribbon){
      var td = tr.querySelector('td[data-label="' + ribbon + '"]');
      if(!td) return false;
      var v = normalize(td.textContent);
      return v.indexOf("✔") !== -1 || v.indexOf("yes") !== -1;
    }

    function rowGroup(tr){
      return tr.getAttribute("data-group") || "";
    }

    function updateStatus(shown, total){
      if(!status) return;
      status.textContent = shown + " of " + total + " models shown";
    }

    function updateGroupHeaders(){
      groupRows.forEach(function(gr){
        var g = gr.getAttribute("data-group-row");
        if(!g) return;
        var anyVisible = modelRows.some(function(r){
          return rowGroup(r) === g && !r.hasAttribute("hidden");
        });
        setHidden(gr, !anyVisible);
      });
    }

    function activeRibbonFilters(){
      return ribbonFilters
        .filter(function(i){ return i.checked; })
        .map(function(i){ return i.getAttribute("data-ribbon"); });
    }

    function activeGroups(){
      var active = groupFilters
        .filter(function(i){ return i.checked; })
        .map(function(i){ return i.getAttribute("data-group"); });
      return active.length ? active : ["current","previous"];
    }

    function clearChipPressed(){
      chips.forEach(function(btn){ btn.setAttribute("aria-pressed","false"); });
    }

    function anyFilteringActive(){
      var hasSearch = search && normalize(search.value).length > 0;
      var hasFilters = filterInputs.some(function(i){ return i.checked; });
      var hasChip = chips.some(function(btn){ return btn.getAttribute("aria-pressed") === "true"; });
      return hasSearch || hasFilters || hasChip;
    }

    function updateClearButtonVisibility(){
      if(!actionsWrap) return;
      setHidden(actionsWrap, !anyFilteringActive());
    }

    function apply(){
      var q = search ? normalize(search.value) : "";
      var ribbons = activeRibbonFilters();
      var groups  = activeGroups();

      var shown = 0;

      modelRows.forEach(function(tr){
        var modelOk = !q || rowModelText(tr).indexOf(q) !== -1;
        var groupOk = groups.indexOf(rowGroup(tr)) !== -1;

        var ribbonsOk = true;
        for(var i = 0; i < ribbons.length; i++){
          if(!rowHasRibbon(tr, ribbons[i])){ ribbonsOk = false; break; }
        }

        var visible = modelOk && groupOk && ribbonsOk;
        setHidden(tr, !visible);
        if(visible) shown++;
      });

      updateGroupHeaders();
      updateStatus(shown, modelRows.length);
      updateClearButtonVisibility();
    }

    chips.forEach(function(btn){
      btn.addEventListener("click", function(){
        var token = (btn.getAttribute("data-chip") || "").trim();
        if(!token) return;

        var pressed = btn.getAttribute("aria-pressed") === "true";
        clearChipPressed();

        if(pressed){
          btn.setAttribute("aria-pressed","false");
          if(search) search.value = "";
        }else{
          btn.setAttribute("aria-pressed","true");
          if(search) search.value = token;
        }

        apply();
        if(search) search.focus();
      });
    });

    if(search){
      search.addEventListener("input", function(){
        clearChipPressed();
        apply();
      });
    }

    filterInputs.forEach(function(i){
      i.addEventListener("change", function(){
        /* keep aria pressed synced for any toggle label */
        var label = i.closest(".ms-rib__toggle");
        if(label) syncToggleAria(label);
        apply();
      });
    });

    if(clearBtn){
      clearBtn.addEventListener("click", function(){
        if(search) search.value = "";
        clearChipPressed();
        filterInputs.forEach(function(i){ i.checked = false; });

        /* reset aria-pressed on toggles */
        toggleLabels.forEach(function(label){ syncToggleAria(label); });

        apply();
        if(search) search.focus();
      });
    }

    root.addEventListener("keydown", function(e){
      if(e.key !== "Escape") return;
      if(search) search.value = "";
      clearChipPressed();
      filterInputs.forEach(function(i){ i.checked = false; });
      toggleLabels.forEach(function(label){ syncToggleAria(label); });
      apply();
    });

    apply();
  }

  if(document.readyState === "loading"){
    document.addEventListener("DOMContentLoaded", init);
  }else{
    init();
  }
})();
</script>

