<style>
/* =====================================================
   MONROE RIBBON COMPATIBILITY CHART (Interactive) – FULL CSS
   Scoped: .ms-rib
   Brand: #007681 accent. All text stays black.
   Implemented:
   - 18px body text, H2 max 40px
   - 5px borders, teal border color everywhere
   - No horizontal scrolling: desktop fits via fixed layout + wrapping, mobile becomes cards
   - Search bar overlap protection (theme-proof)
   - Filter buttons: no visible checkboxes, hover/active teal fill
   - Group buttons not narrow, consistent padding/min-width
   - Visual “pop” (soft background panel, shadows, header tint)
   - Clear button row styles (for JS-controlled visibility)
   ===================================================== */

.ms-rib{
  --msr-accent:#007681;
  --msr-border:#007681;
  --msr-soft: rgba(0,118,129,.08);
  --msr-soft2: rgba(0,118,129,.14);

  font-family: Roboto, sans-serif;
  font-size:18px;
  line-height:1.55;
  color:#000000;

  display:block;
  width:95%;
  max-width:95%;
  box-sizing:border-box;
  margin: 0 auto;
  padding: 0 16px;

  /* POP */
  background-color: rgba(0,118,129,.06);
  padding: 18px;
  border-radius: 18px;
}

.ms-rib *, .ms-rib *::before, .ms-rib *::after{ box-sizing:border-box; }

.ms-rib a{
  color:#000000;
  text-decoration:underline;
  text-decoration-thickness: 2px;
  text-underline-offset: 3px;
}
.ms-rib a:hover{ text-decoration:underline; }

/* Top/Bottom bars */
.ms-rib__bar{
  background: var(--msr-accent);
  height:35px;
  width:100%;
  margin:0 0 18px 0;
}

/* Title (H2 max 40px) */
.ms-rib__title{
  margin: 0 0 16px 0;
  text-align:center;
  font-size:40px;
  line-height:1.15;
  color:#000000;
  letter-spacing:.2px;
}

/* Intro */
.ms-rib__intro{ margin: 0 0 16px 0; }
.ms-rib__intro p{ margin: 0 0 12px 0; }
.ms-rib__intro p:last-child{ margin-bottom:0; }

/* SR helper */
.ms-rib__srOnly{
  position:absolute;
  width:1px;
  height:1px;
  padding:0;
  margin:-1px;
  overflow:hidden;
  clip:rect(0,0,0,0);
  white-space:nowrap;
  border:0;
}

/* =====================================================
   Controls
   ===================================================== */
.ms-rib__controls{
  border:5px solid var(--msr-border);
  padding:14px;
  margin:0 0 14px 0;
  background:#ffffff;

  /* Theme-proof + overlap fixes */
  position:relative;
  isolation:isolate;
  overflow:visible;

  width:100%;
  max-width:100%;
  box-sizing:border-box;

  /* POP */
  border-radius: 18px;
  box-shadow: 0 8px 22px rgba(0,0,0,.10);
}

.ms-rib__controlsRow{
  display:grid;
  grid-template-columns: 1fr;
  gap:12px;
  align-items:stretch;

  width:100%;
  max-width:100%;
  box-sizing:border-box;
}

/* Theme-proof label wrapper ONLY for the search field container */
.ms-rib__controls > .ms-rib__controlsRow > label{
  display:block !important;
  width:100% !important;
  max-width:100% !important;
  box-sizing:border-box !important;
  margin:0 !important;
  padding:0 !important;
  position:static !important;
  float:none !important;
  transform:none !important;
}

.ms-rib__fieldLabel{
  display:block;
  font-weight:700;
  margin:0 0 6px 0;
  font-size:18px;
  color:#000000;
}

.ms-rib__search{
  display:block;
  width:100%;
  max-width:100%;
  font-size:18px;
  padding:12px 14px;
  border:5px solid var(--msr-border);
  border-radius:14px;
  color:#000000;
  background:#ffffff;
  box-sizing:border-box;
  margin:0;

  /* Extra theme-proofing */
  position:relative !important;
  left:auto !important;
  right:auto !important;
  transform:none !important;
}

.ms-rib input[type="search"],
.ms-rib input[type="text"]{
  max-width:100% !important;
  box-sizing:border-box !important;
}

/* =====================================================
   Filter buttons
   - No visible checkboxes
   - Hover/active teal fill
   - Comfortable width for all pills
   ===================================================== */
.ms-rib__filters{
  display:flex !important;
  flex-wrap:wrap !important;
  gap:10px !important;
  width:100% !important;
  margin:0 !important;
  padding:0 !important;
  box-sizing:border-box !important;
}

.ms-rib__filter{
  display:inline-flex !important;
  align-items:center !important;
  justify-content:center !important;
  gap:10px !important;

  border:5px solid var(--msr-border);
  border-radius:999px;
  background:#ffffff;
  color:#000000;

  /* Size + spacing */
  font-size:16px;
  line-height:1.15;
  padding:12px 28px;
  min-height:52px;
  min-width:180px;

  cursor:pointer;
  box-sizing:border-box;
  overflow:hidden;

  transition:
    transform .15s ease,
    background-color .2s ease,
    color .2s ease,
    border-color .2s ease;
}

/* Hide checkbox input but keep functionality for JS */
.ms-rib__filter input{
  position:absolute !important;
  opacity:0 !important;
  pointer-events:none !important;
  width:1px !important;
  height:1px !important;
  margin:0 !important;
  padding:0 !important;
}

/* Hover state */
.ms-rib__filter:hover{
  background-color: var(--msr-accent);
  color:#ffffff;
  transform: translateY(-1px);
}
.ms-rib__filter:hover span{ color:#ffffff; }

/* Checked state mirrors hover */
.ms-rib__filter:has(input:checked){
  background-color: var(--msr-accent);
  color:#ffffff;
}
.ms-rib__filter:has(input:checked) span{ color:#ffffff; }

/* Mobile safety */
@media (max-width:520px){
  .ms-rib__filter{
    min-width:auto;
    padding:12px 18px;
    justify-content:flex-start;
  }
}

/* Slightly wider on desktop */
@media (min-width:980px){
  .ms-rib__filter{ min-width:200px; }
}

/* =====================================================
   Chips (quick picks)
   ===================================================== */
.ms-rib__chips{
  display:flex;
  flex-wrap:wrap;
  gap:10px;
  margin-top:12px;
}

.ms-rib__chip{
  appearance:none;
  border:5px solid var(--msr-border);
  background:#ffffff;
  color:#000000;
  border-radius:999px;

  font-size:16px;
  line-height:1.15;
  padding:12px 22px;
  min-height:52px;
  cursor:pointer;

  transition:
    transform .15s ease,
    background-color .2s ease,
    color .2s ease,
    border-color .2s ease;
}

.ms-rib__chip:hover{
  background-color: var(--msr-accent);
  color:#ffffff;
  transform: translateY(-1px);
}

.ms-rib__chip[aria-pressed="true"]{
  background-color: var(--msr-accent);
  color:#ffffff;
}

/* Status line */
.ms-rib__status{
  margin:10px 0 0 0;
  font-size:18px;
  color:#000000;
}

/* Clear button row (appears via JS when filtering active) */
.ms-rib__actions{
  margin-top:12px;
  display:flex;
  justify-content:flex-start;
}

/* Button base */
.ms-rib__btn,
.ms-rib__trayRemove,
.ms-rib__modalClose{
  border:5px solid var(--msr-border) !important;
  background:#ffffff !important;
  color:#000000 !important;
  font-weight:800 !important;
  border-radius:14px;
  padding:12px 16px;
  cursor:pointer;
  font-size:18px;
  line-height:1.1;
  text-decoration:none !important;

  transition:
    transform .15s ease,
    background-color .2s ease,
    color .2s ease,
    border-color .2s ease;
}

.ms-rib__btn:hover,
.ms-rib__trayRemove:hover,
.ms-rib__modalClose:hover{
  background: var(--msr-accent) !important;
  color:#ffffff !important;
  transform: translateY(-1px);
}

/* =====================================================
   Results wrapper
   - NO horizontal scrolling: overflow hidden
   ===================================================== */
.ms-rib__wrap{
  border:5px solid var(--msr-border);
  padding:12px;
  width:100%;
  max-width:100%;
  overflow:hidden;
  background:#ffffff;

  /* POP */
  border-radius: 18px;
  box-shadow: 0 8px 22px rgba(0,0,0,.10);
}

/* =====================================================
   Table (desktop)
   - fixed layout to fit container
   - wrap content
   ===================================================== */
.ms-rib__table{
  width:100%;
  max-width:100%;
  border-collapse:collapse;
  table-layout:fixed;
}

.ms-rib__table th,
.ms-rib__table td{
  border:5px solid var(--msr-border);
  padding:10px;
  text-align:center;
  vertical-align:middle;
  font-size:18px;
  color:#000000;
  background:#ffffff;

  white-space:normal;
  word-break:break-word;
  overflow-wrap:anywhere;
}

/* Column sizing: gives model column more room */
.ms-rib__table col.ms-rib__colModel{ width: 44%; }
.ms-rib__table col.ms-rib__colRibbon{ width: 14%; }

/* Header row tint */
.ms-rib__headRow th{
  font-weight:800;
  background: rgba(0,118,129,.10);
}

/* Group rows */
.ms-rib__groupRow th{
  background: rgba(0,118,129,.14);
  font-weight:800;
  text-align:center;
}

/* Optional zebra (your HTML uses this class on some rows) */
.ms-rib__zebra{ background: rgba(0,0,0,.03); }

/* Desktop hover aid */
@media (hover:hover){
  .ms-rib__row:hover{
    outline: 3px solid rgba(0,118,129,.35);
    outline-offset: 2px;
    border-radius: 14px;
  }
}

/* Checkmarks */
.ms-rib__yes{
  font-weight:900;
  font-size:20px;
  line-height:1;
}
.ms-rib__no{ opacity:.35; }

/* =====================================================
   Mobile: stacked cards (eliminates horizontal scrolling)
   ===================================================== */
@media (max-width: 860px){
  .ms-rib__wrap{ padding:10px; }

  .ms-rib__table,
  .ms-rib__table thead,
  .ms-rib__table tbody,
  .ms-rib__table tr,
  .ms-rib__table th,
  .ms-rib__table td{
    display:block;
    width:100%;
  }

  .ms-rib__table thead{ display:none; }

  .ms-rib__groupRow th{
    border:5px solid var(--msr-border);
    border-radius:14px;
    padding:12px;
    margin:12px 0 10px 0;
  }

  .ms-rib__row{
    border:5px solid var(--msr-border);
    border-radius:14px;
    padding:12px;
    margin:12px 0;
    background:#ffffff;
  }

  .ms-rib__table th,
  .ms-rib__table td{
    border:0;
    padding:10px 0;
    text-align:left;
  }

  .ms-rib__table td[data-label]{
    display:grid;
    grid-template-columns: minmax(160px, 220px) minmax(0, 1fr);
    gap:12px;
    align-items:start;
  }

  .ms-rib__table td[data-label]::before{
    content: attr(data-label);
    font-weight:800;
    color:#000000;
  }
}

/* =====================================================
   Motion safety
   ===================================================== */
@media (prefers-reduced-motion: reduce){
  .ms-rib *{
    scroll-behavior:auto !important;
    transition:none !important;
    animation:none !important;
  }
}
  .page-heading{
    color: #000000;
  }
  /* Toggle button accessibility: visible focus ring on the label-button */
.ms-rib__toggle:focus{
  outline: 3px solid rgba(0,118,129,.45);
  outline-offset: 3px;
}

/* Slightly stronger pressed styling for the “button” state */
.ms-rib__toggle[aria-pressed="true"]{
  background-color: var(--msr-accent);
  color:#ffffff;
}

.ms-rib__toggle[aria-pressed="true"] span{
  color:#ffffff;
}
</style>

