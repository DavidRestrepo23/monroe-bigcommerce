{{ 'section-calculator-classroom.css' | asset_url | stylesheet_tag }}
<script src="{{ 'section-calculator-classroom.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign primary_link = section.settings.primary_link | default: '/collections/printing-calculators-1'
  assign secondary_link = section.settings.secondary_link | default: '/pages/monroe-heavy-duty-calculator-chart'
-%}

{%- style -%}
  #CalculatorClassroom-{{ section.id }} {
    --cc-accent: {{ section.settings.accent_color }};
    --cc-accent-dark: {{ section.settings.accent_dark_color }};
    --cc-soft: {{ section.settings.soft_background_color }};
  }
{%- endstyle -%}

<section
  id="CalculatorClassroom-{{ section.id }}"
  class="calculator-classroom"
  data-calculator-classroom
>
  <div class="cc-shell">
    <header id="course-overview" class="cc-hero">
      <div class="cc-hero__content">
        {%- if section.settings.eyebrow != blank -%}
          <p class="cc-hero__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}

        <h1 class="cc-hero__title">{{ section.settings.heading | escape }}</h1>

        <div class="cc-hero__intro rte">
          {{ section.settings.intro }}
        </div>

        <div class="cc-hero__actions">
          {%- if primary_link != blank and section.settings.primary_label != blank -%}
            <a class="cc-button cc-button--primary" href="{{ primary_link }}">
              {{ section.settings.primary_label | escape }}
            </a>
          {%- endif -%}

          {%- if secondary_link != blank and section.settings.secondary_label != blank -%}
            <a class="cc-button cc-button--secondary" href="{{ secondary_link }}">
              {{ section.settings.secondary_label | escape }}
            </a>
          {%- endif -%}
        </div>

        <ul class="cc-hero__stats" aria-label="Course overview">
          <li><strong>3</strong><span>Chapters</span></li>
          <li><strong>60+</strong><span>Topics</span></li>
          <li><strong>Free</strong><span>Learning Resource</span></li>
        </ul>
      </div>

      <div class="cc-hero__visual" aria-hidden="true">
        {%- if section.settings.hero_image != blank -%}
          {{ section.settings.hero_image
            | image_url: width: 1200
            | image_tag:
              widths: '480, 720, 960, 1200',
              sizes: '(min-width: 990px) 42vw, 100vw',
              loading: 'eager',
              class: 'cc-hero__image'
          }}
        {%- else -%}
          <img
            class="cc-hero__image"
            src="https://cdn.shopify.com/s/files/1/0653/0262/6407/files/welcome-to-calculator-classroom4.png?v=1783531523"
            alt=""
            width="649"
            height="439"
            loading="eager"
          >
        {%- endif -%}
      </div>
    </header>

    <details class="cc-mobile-tools">
      <summary>
        <span>Browse course topics</span>
        <span aria-hidden="true">+</span>
      </summary>
      <div class="cc-mobile-tools__body">
        {%- if section.settings.enable_search -%}
          <label class="cc-search" for="CalculatorClassroomSearchMobile-{{ section.id }}">
            <span>Find a topic</span>
            <input
              id="CalculatorClassroomSearchMobile-{{ section.id }}"
              type="search"
              placeholder="Try “rounding” or “paper roll”"
              autocomplete="off"
              data-cc-search
            >
          </label>
        {%- endif -%}
        {% render 'calculator-classroom-toc' %}
      </div>
    </details>

    <div class="cc-layout">
      <aside class="cc-sidebar" aria-label="Course navigation">
        <div class="cc-sidebar__inner">
          <div class="cc-sidebar__heading">
            <p>Calculator Classroom</p>
            <h2>Course Contents</h2>
          </div>

          {%- if section.settings.enable_search -%}
            <label class="cc-search" for="CalculatorClassroomSearch-{{ section.id }}">
              <span>Find a topic</span>
              <input
                id="CalculatorClassroomSearch-{{ section.id }}"
                type="search"
                placeholder="Try “rounding” or “paper roll”"
                autocomplete="off"
                data-cc-search
              >
            </label>
            <p class="cc-search-status" aria-live="polite" data-cc-search-status></p>
          {%- endif -%}

          {% render 'calculator-classroom-toc' %}
        </div>
      </aside>

      <main class="cc-main" id="CalculatorClassroomContent-{{ section.id }}">
        {% render 'calculator-classroom-content' %}
      </main>
    </div>
  </div>

  <button class="cc-back-to-top" type="button" data-cc-back-to-top aria-label="Back to the top of Calculator Classroom">
    <span aria-hidden="true">↑</span>
  </button>
</section>

{% schema %}
{
  "name": "Calculator Classroom",
  "tag": "section",
  "class": "section-calculator-classroom",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Monroe Learning Center"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Monroe Printing Calculator Classroom"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Introduction",
      "default": "<p>Learn how business printing calculators work, which physical features matter, and how advanced functions can make accounting work faster and more accurate.</p><p>This course focuses on desktop printing calculators rather than handheld calculators.</p>"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero image"
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Primary button label",
      "default": "Shop Printing Calculators"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary button label",
      "default": "Compare Calculator Models"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Secondary button link"
    },
    {
      "type": "checkbox",
      "id": "enable_search",
      "label": "Enable topic search",
      "default": true
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#007681"
    },
    {
      "type": "color",
      "id": "accent_dark_color",
      "label": "Dark accent color",
      "default": "#073b40"
    },
    {
      "type": "color",
      "id": "soft_background_color",
      "label": "Soft background color",
      "default": "#eaf5f5"
    }
  ],
  "presets": [
    {
      "name": "Calculator Classroom"
    }
  ]
}
{% endschema %}