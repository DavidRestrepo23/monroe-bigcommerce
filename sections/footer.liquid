{{ 'component-footer.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign bg_color = section.settings.background_color | default: '#F4F6F6'
  assign bg_brightness = section.settings.background_color | color_brightness
  if bg_brightness < 128
    assign auto_text = '#FFFFFF'
    assign auto_muted = 'rgba(255,255,255,0.6)'
  else
    assign auto_text = section.settings.text_color | default: '#0A0A0A'
    assign auto_muted = section.settings.muted_color | default: '#5A6566'
  endif
-%}
{%- style -%}
  #SiteFooter-{{ section.id }} {
    --ft-bg: {{ bg_color }};
    --ft-text: {{ auto_text }};
    --ft-muted: {{ auto_muted }};
    --ft-accent: {{ section.settings.accent_color | default: '#1F6F75' }};
    --ft-newsletter-bg: {{ section.settings.newsletter_bg | default: '#0A0A0A' }};
    --ft-newsletter-text: {{ section.settings.newsletter_text | default: '#FFFFFF' }};
    --ft-social-bg: {{ section.settings.social_bg | default: '#FFFFFF' }};
    --ft-radius: {{ section.settings.radius | default: 32 }}px;
    --ft-pad-top: {{ section.settings.padding_top | default: 64 }}px;
    --ft-pad-bottom: {{ section.settings.padding_bottom | default: 64 }}px;
  }
  @media (max-width: 700px) {
    #SiteFooter-{{ section.id }} {
      --ft-pad-top: {{ section.settings.padding_top_mobile | default: 32 }}px;
      --ft-pad-bottom: {{ section.settings.padding_bottom_mobile | default: 32 }}px;
    }
  }
{%- endstyle -%}

<footer
  id="SiteFooter-{{ section.id }}"
  class="site-footer"
  role="contentinfo"
  style="padding-top: var(--ft-pad-top); padding-bottom: var(--ft-pad-bottom);"
>
  {%- if section.settings.show_newsletter -%}
    <div class="site-footer__newsletter">
      <div class="site-footer__newsletter-inner">
        <h2 class="site-footer__newsletter-title">
          {{ section.settings.newsletter_heading | default: 'Subscribe to Our Newsletter' }}
        </h2>
        {%- form 'customer', class: 'site-footer__form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <label class="visually-hidden" for="FooterNewsletter-{{ section.id }}">Email</label>
          <input
            id="FooterNewsletter-{{ section.id }}"
            type="email"
            name="contact[email]"
            placeholder="{{ section.settings.newsletter_placeholder | default: 'Enter your email' }}"
            class="site-footer__email"
            autocomplete="email"
            required
          >
          <button type="submit" class="site-footer__submit">
            {{ section.settings.newsletter_button | default: 'Subscribe' }}
          </button>
          {%- if form.posted_successfully? -%}
            <p class="site-footer__form-message" role="status">Thanks for subscribing.</p>
          {%- endif -%}
          {%- if form.errors -%}
            <p class="site-footer__form-message site-footer__form-message--error" role="alert">
              {{ form.errors | default_errors }}
            </p>
          {%- endif -%}
        {%- endform -%}
      </div>
    </div>
  {%- endif -%}

  <div class="site-footer__main">
    <div class="site-footer__grid">
      <div class="site-footer__brand">
        {%- if section.settings.logo != blank -%}
          {{
            section.settings.logo
            | image_url: width: 360
            | image_tag: width: 180, alt: shop.name, class: 'site-footer__logo'
          }}
        {%- else -%}
          <p class="site-footer__logo-text">{{ shop.name }}</p>
        {%- endif -%}

        {%- if section.settings.tagline != blank -%}
          <p class="site-footer__tagline">{{ section.settings.tagline }}</p>
        {%- endif -%}

        {%- if section.settings.description != blank -%}
          <div class="site-footer__description">{{ section.settings.description }}</div>
        {%- endif -%}

        {%- if section.settings.address != blank or section.settings.phone != blank -%}
          <div class="site-footer__contact">
            {%- if section.settings.address != blank -%}
              <div class="site-footer__contact-item">
                <span class="" aria-hidden="true">
                  <svg width="40" height="40" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <circle cx="20" cy="20" r="19.5" stroke="white" stroke-opacity="0.35"/>
                    <g clip-path="url(#clip0_486_5321)">
                    <path d="M19.5645 20.9531C21.2213 20.9531 22.5645 19.61 22.5645 17.9531C22.5645 16.2963 21.2213 14.9531 19.5645 14.9531C17.9076 14.9531 16.5645 16.2963 16.5645 17.9531C16.5645 19.61 17.9076 20.9531 19.5645 20.9531Z" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M27.0645 17.9531C27.0645 24.7031 19.5645 29.9531 19.5645 29.9531C19.5645 29.9531 12.0645 24.7031 12.0645 17.9531C12.0645 15.964 12.8546 14.0563 14.2612 12.6498C15.6677 11.2433 17.5753 10.4531 19.5645 10.4531C21.5536 10.4531 23.4612 11.2433 24.8678 12.6498C26.2743 14.0563 27.0645 15.964 27.0645 17.9531Z" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </g>
                    <defs>
                    <clipPath id="clip0_486_5321">
                    <rect width="24" height="24" fill="white" transform="translate(7.56445 8.20312)"/>
                    </clipPath>
                    </defs>
                  </svg>
                </span>
                <div class="site-footer__contact-text">{{ section.settings.address }}</div>
              </div>
            {%- endif -%}

            {%- if section.settings.phone != blank -%}
              <div class="site-footer__contact-item">
                <span class="site-footer__contact-icon" aria-hidden="true">
                  <svg width="40" height="40" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <circle cx="20" cy="20" r="19.5" stroke="black" stroke-opacity="0.15"/>
                    <g clip-path="url(#clip0_540_975)">
                    <path d="M21.8149 12.7041C23.0763 13.0363 24.2269 13.6973 25.1493 14.6197C26.0717 15.542 26.7327 16.6927 27.0649 17.9541" stroke="black" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M21.0649 15.7041C22.6136 16.1185 23.6505 17.1554 24.0649 18.7041" stroke="black" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M22.2264 22.5798C22.3303 22.5107 22.4498 22.4686 22.574 22.4573C22.6983 22.446 22.8234 22.4659 22.938 22.5151L27.3593 24.4961C27.5083 24.5598 27.6326 24.67 27.7137 24.8103C27.7949 24.9505 27.8284 25.1133 27.8093 25.2742C27.6636 26.3627 27.1276 27.3612 26.3009 28.0841C25.4742 28.807 24.4131 29.205 23.3149 29.2042C19.9334 29.2042 16.6904 27.8609 14.2993 25.4698C11.9082 23.0787 10.5649 19.8357 10.5649 16.4542C10.564 15.356 10.9621 14.2949 11.685 13.4682C12.4079 12.6415 13.4064 12.1055 14.4949 11.9598C14.6558 11.9407 14.8186 11.9742 14.9588 12.0553C15.0991 12.1365 15.2093 12.2608 15.273 12.4098L17.2539 16.8348C17.3026 16.9485 17.3224 17.0724 17.3116 17.1956C17.3008 17.3187 17.2598 17.4373 17.1921 17.5408L15.1886 19.923C15.1176 20.0302 15.0755 20.154 15.0667 20.2824C15.0578 20.4107 15.0824 20.5391 15.138 20.6551C15.9133 22.2423 17.5539 23.8633 19.1458 24.6311C19.2624 24.6865 19.3915 24.7105 19.5202 24.7008C19.6489 24.6911 19.7729 24.648 19.8799 24.5758L22.2264 22.5798Z" stroke="black" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </g>
                    <defs>
                    <clipPath id="clip0_540_975">
                    <rect width="24" height="24" fill="white" transform="translate(7.56488 8.2041)"/>
                    </clipPath>
                    </defs>
                  </svg>
                </span>
                <div class="site-footer__contact-text">
                  <span class="site-footer__contact-label">
                    {{- section.settings.phone_label | default: 'Call us at' -}}
                  </span>
                  <a href="tel:{{ section.settings.phone | replace: ' ', '' | replace: '(', '' | replace: ')', '' | replace: '-', '' }}">
                    {{- section.settings.phone -}}
                  </a>
                </div>
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>

      <div class="site-footer__columns">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'link_column' -%}
              <div class="site-footer__column" {{ block.shopify_attributes }}>
                {%- if block.settings.heading != blank -%}
                  <h3 class="site-footer__column-title">{{ block.settings.heading }}</h3>
                {%- endif -%}
                {%- if block.settings.menu != blank -%}
                  <ul class="site-footer__links">
                    {%- for link in linklists[block.settings.menu].links -%}
                      <li>
                        <a href="{{ link.url }}">{{ link.title }}</a>
                      </li>
                    {%- endfor -%}
                  </ul>
                {%- elsif block.settings.links_text != blank -%}
                  <ul class="site-footer__links">
                    {%- assign rows = block.settings.links_text | newline_to_br | split: '<br />' -%}
                    {%- for row in rows -%}
                      {%- assign parts = row | strip | split: '|' -%}
                      {%- if parts[0] != blank -%}
                        <li>
                          <a href="{{ parts[1] | default: '#' | strip }}">{{ parts[0] | strip }}</a>
                        </li>
                      {%- endif -%}
                    {%- endfor -%}
                  </ul>
                {%- endif -%}
              </div>
          {%- endcase -%}
        {%- endfor -%}
      </div>

      <div class="site-footer__media">
        {%- assign social_blocks = section.blocks | where: 'type', 'social' -%}
        {%- if social_blocks.size > 0 -%}
          <ul class="site-footer__social">
            {%- for block in social_blocks -%}
              <li {{ block.shopify_attributes }}>
                <a
                  href="{{ block.settings.url | default: '#' }}"
                  aria-label="{{ block.settings.platform | default: 'Social link' }}"
                  target="_blank"
                  rel="noopener"
                >
                  {%- render 'footer-social-icon', platform: block.settings.platform -%}
                </a>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- assign payment_blocks = section.blocks | where: 'type', 'payment' -%}
        {%- if payment_blocks.size > 0 -%}
          <ul class="site-footer__payments">
            {%- for block in payment_blocks -%}
              <li {{ block.shopify_attributes }}>
                {%- if block.settings.image != blank -%}
                  {{
                    block.settings.image
                    | image_url: height: 40
                    | image_tag: height: 20, alt: block.settings.label
                    | default: 'Payment method'
                  }}
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
    </div>

    <div class="site-footer__bottom">
      <p class="site-footer__copyright">
        &copy; {{ 'now' | date: '%Y' }}
        {{ section.settings.copyright | default: shop.name }}.
      </p>
      {%- if section.settings.legal_menu != blank -%}
        <ul class="site-footer__legal">
          {%- for link in linklists[section.settings.legal_menu].links -%}
            <li>
              <a href="{{ link.url }}">{{ link.title }}</a>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "tag": "section",
  "class": "section-footer",
  "settings": [
    {
      "type": "header",
      "content": "Newsletter"
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "Show newsletter bar",
      "default": true
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Heading",
      "default": "Subscribe to Our Newsletter"
    },
    {
      "type": "text",
      "id": "newsletter_placeholder",
      "label": "Input placeholder",
      "default": "Enter your email"
    },
    {
      "type": "text",
      "id": "newsletter_button",
      "label": "Button label",
      "default": "Subscribe"
    },
    {
      "type": "color",
      "id": "newsletter_bg",
      "label": "Bar background",
      "default": "#0A0A0A"
    },
    {
      "type": "color",
      "id": "newsletter_text",
      "label": "Bar text",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Brand"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "Inventor of the commercial printing calculator in 1912"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Monroe Systems for Business supplies professionals with printing calculators, paper tape rolls, ink ribbons, and office equipment built for daily accuracy and long-term reliability.</p>"
    },
    {
      "type": "richtext",
      "id": "address",
      "label": "Address",
      "default": "<p>511 William Leigh Drive<br>Suite 15 - Tullytown, PA 19007</p>"
    },
    {
      "type": "text",
      "id": "phone_label",
      "label": "Phone label",
      "default": "Call us at"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone",
      "default": "(267) 580-2600"
    },
    {
      "type": "header",
      "content": "Bottom bar"
    },
    {
      "type": "text",
      "id": "copyright",
      "label": "Copyright text",
      "default": "Monroe Systems for Business"
    },
    {
      "type": "link_list",
      "id": "legal_menu",
      "label": "Legal menu"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Footer background",
      "default": "#F4F6F6"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#0A0A0A"
    },
    {
      "type": "color",
      "id": "muted_color",
      "label": "Muted text",
      "default": "#5A6566"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent (icons)",
      "default": "#1F6F75"
    },
    {
      "type": "color",
      "id": "social_bg",
      "label": "Social icons background",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "radius",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Corner radius",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top (mobile)",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom (mobile)",
      "default": 32
    }
  ],
  "blocks": [
    {
      "type": "link_column",
      "name": "Link column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Column heading",
          "default": "Navigate"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu (preferred)"
        },
        {
          "type": "textarea",
          "id": "links_text",
          "label": "Manual links",
          "info": "One per line as 'Label | /url'. Used if no menu selected."
        }
      ]
    },
    {
      "type": "social",
      "name": "Social icon",
      "settings": [
        {
          "type": "select",
          "id": "platform",
          "label": "Platform",
          "default": "facebook",
          "options": [
            {
              "value": "youtube",
              "label": "YouTube"
            },
            {
              "value": "facebook",
              "label": "Facebook"
            },
            {
              "value": "instagram",
              "label": "Instagram"
            },
            {
              "value": "linkedin",
              "label": "LinkedIn"
            },
            {
              "value": "pinterest",
              "label": "Pinterest"
            },
            {
              "value": "tiktok",
              "label": "TikTok"
            },
            {
              "value": "twitter",
              "label": "X / Twitter"
            }
          ]
        },
        {
          "type": "url",
          "id": "url",
          "label": "URL"
        }
      ]
    },
    {
      "type": "payment",
      "name": "Payment icon",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Alt text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Footer",
      "blocks": [
        {
          "type": "link_column",
          "settings": {
            "heading": "Navigate"
          }
        },
        {
          "type": "link_column",
          "settings": {
            "heading": "Categories"
          }
        },
        {
          "type": "link_column",
          "settings": {
            "heading": "Popular Brands"
          }
        },
        {
          "type": "social",
          "settings": {
            "platform": "youtube"
          }
        },
        {
          "type": "social",
          "settings": {
            "platform": "facebook"
          }
        },
        {
          "type": "social",
          "settings": {
            "platform": "instagram"
          }
        },
        {
          "type": "social",
          "settings": {
            "platform": "linkedin"
          }
        },
        {
          "type": "social",
          "settings": {
            "platform": "pinterest"
          }
        },
        {
          "type": "social",
          "settings": {
            "platform": "tiktok"
          }
        }
      ]
    }
  ]
}
{% endschema %}
