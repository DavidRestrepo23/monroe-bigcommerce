{{ 'section-medium-duty-comparison.css' | asset_url | stylesheet_tag }}
<script src="{{ 'section-medium-duty-comparison.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign primary_link = section.settings.primary_link | default: '/collections/medium-duty-calculators'
  assign secondary_link = section.settings.secondary_link | default: '/pages/calculator-manuals'
-%}

<section
  id="MediumDutyComparison-{{ section.id }}"
  class="mdc"
  data-md-comparison
  style="
    --mdc-accent: {{ section.settings.accent_color }};
    --mdc-accent-dark: {{ section.settings.accent_dark }};
    --mdc-ink: {{ section.settings.text_color }};
    --mdc-surface: {{ section.settings.surface_color }};
    --mdc-soft: {{ section.settings.soft_color }};
  "
  aria-labelledby="MediumDutyComparisonTitle-{{ section.id }}"
>
  <script type="application/json" data-mdc-data>
    {% render 'medium-duty-comparison-data' %}
  </script>

  <div class="mdc__shell">
    <header class="mdc__hero">
      <div class="mdc__hero-copy">
        {%- if section.settings.eyebrow != blank -%}<p class="mdc__eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        <h2 id="MediumDutyComparisonTitle-{{ section.id }}" class="mdc__title">{{ section.settings.heading | escape }}</h2>
        <div class="mdc__intro rte">{{ section.settings.intro }}</div>
        <div class="mdc__hero-actions">
          <a class="mdc__button mdc__button--primary" href="#MediumDutyFinder-{{ section.id }}">Find your model</a>
          <a class="mdc__button mdc__button--secondary" href="{{ primary_link }}">{{ section.settings.primary_label | escape }}</a>
        </div>
        <ul class="mdc__hero-points" role="list">
          <li><strong>3</strong><span>medium-duty models</span></li>
          <li><strong>4.3</strong><span>maximum LPS</span></li>
          <li><strong>2</strong><span>models at a time</span></li>
        </ul>
      </div>

      <div class="mdc__hero-visual" aria-label="Medium-duty calculator comparison overview">
        {%- if section.settings.hero_image != blank -%}
          {{ section.settings.hero_image | image_url: width: 1200 | image_tag: class: 'mdc__hero-image', loading: 'eager', widths: '480, 720, 960, 1200', sizes: '(min-width: 990px) 42vw, 100vw', alt: section.settings.hero_image.alt | default: section.settings.heading }}
        {%- else -%}
          <div class="mdc__hero-products">
            <a class="mdc__hero-product mdc__hero-product--one" href="https://monroe-systems.com/products/monroe-6120x-12-digit-entry-level-accounting-desktop-printing-calculator"><img src="https://cdn.shopify.com/s/files/1/0653/0262/6407/files/6120x-ivory-transparent.png?v=1782936812" alt="Monroe 6120X medium-duty printing calculator" width="260" height="260"><span>6120X</span></a>
            <a class="mdc__hero-product mdc__hero-product--two" href="https://monroe-systems.com/products/monroe-2020plusx-12-digit-medium-duty-accounting-desktop-printing-calculator-with-large-display"><img src="https://cdn.shopify.com/s/files/1/0653/0262/6407/files/2020plusx-black-transparent.png?v=1782936817" alt="Monroe 2020PlusX medium-duty printing calculator" width="260" height="260"><span>2020PlusX</span></a>
            <a class="mdc__hero-product mdc__hero-product--three" href="https://monroe-systems.com/products/monroe-122pdx-12-digit-medium-duty-accounting-printing-calculator-with-fast-printing"><img src="https://cdn.shopify.com/s/files/1/0653/0262/6407/files/122pdx-transparent.png?v=1782936824" alt="Monroe 122PDX medium-duty printing calculator" width="260" height="260"><span>122PDX</span></a>
          </div>
        {%- endif -%}
      </div>
    </header>

    <nav class="mdc__jump" aria-label="Comparison page sections">
      <a href="#MediumDutyFinder-{{ section.id }}">Model finder</a><a href="#MediumDutyModels-{{ section.id }}">Model overview</a><a href="#MediumDutyChart-{{ section.id }}">Full comparison</a><a href="#MediumDutySupport-{{ section.id }}">Need help?</a>
    </nav>

    <section id="MediumDutyFinder-{{ section.id }}" class="mdc__panel mdc__finder" aria-labelledby="MediumDutyFinderTitle-{{ section.id }}">
      <div class="mdc__section-heading"><div><p class="mdc__section-kicker">Guided selection</p><h3 id="MediumDutyFinderTitle-{{ section.id }}">What matters most in your workflow?</h3><p>Choose a priority to highlight the model or models that match it.</p></div><button class="mdc__text-button" type="button" data-mdc-reset-priority hidden>Reset recommendation</button></div>
      <div class="mdc__priority-grid" role="group" aria-label="Choose a calculator priority">
        <button type="button" class="mdc__priority" data-priority="most-features"><span class="mdc__priority-icon" aria-hidden="true">★</span><span><strong>Most complete feature set</strong><small>VAT, financial, time, tax, and group totals</small></span></button>
        <button type="button" class="mdc__priority" data-priority="large-display"><span class="mdc__priority-icon" aria-hidden="true">▣</span><span><strong>Large display</strong><small>Make everyday entries easier to review</small></span></button>
        <button type="button" class="mdc__priority" data-priority="fastest"><span class="mdc__priority-icon" aria-hidden="true">4.3</span><span><strong>Fastest printing</strong><small>Models rated at 4.3 lines per second</small></span></button>
        <button type="button" class="mdc__priority" data-priority="vat-financial"><span class="mdc__priority-icon" aria-hidden="true">ƒx</span><span><strong>VAT and financial tools</strong><small>Advanced time and financial calculations</small></span></button>
        <button type="button" class="mdc__priority" data-priority="color-choice"><span class="mdc__priority-icon" aria-hidden="true">◐</span><span><strong>Black or ivory cabinet</strong><small>Choose the finish that fits your office</small></span></button>
        <button type="button" class="mdc__priority" data-priority="narrow-footprint"><span class="mdc__priority-icon" aria-hidden="true">↔</span><span><strong>Narrower body</strong><small>Eight-inch width for tighter workspaces</small></span></button>
      </div>
      <div class="mdc__recommendation" data-mdc-recommendation hidden aria-live="polite"></div>
    </section>

    <section id="MediumDutyModels-{{ section.id }}" class="mdc__models-section" aria-labelledby="MediumDutyModelsTitle-{{ section.id }}">
      <div class="mdc__section-heading mdc__section-heading--models"><div><p class="mdc__section-kicker">At a glance</p><h3 id="MediumDutyModelsTitle-{{ section.id }}">Meet the medium-duty lineup</h3><p>Select up to two models. Your choices remain highlighted throughout the page.</p></div><span class="mdc__selection-count" data-mdc-selection-count>0 of 2 selected</span></div>
      <div class="mdc__model-grid" data-mdc-model-grid></div>
      <noscript><div class="mdc__noscript">JavaScript is required for interactive comparison. You can still browse all <a href="{{ primary_link }}">Monroe medium-duty calculators</a>.</div></noscript>
    </section>

    <aside class="mdc__compare-tray" data-mdc-tray hidden aria-label="Selected calculator models"><div class="mdc__compare-tray-inner"><div><p class="mdc__compare-label">Your comparison</p><div class="mdc__compare-chips" data-mdc-selected-chips></div></div><div class="mdc__compare-actions"><button type="button" class="mdc__button mdc__button--secondary" data-mdc-clear>Clear</button><button type="button" class="mdc__button mdc__button--primary" data-mdc-open-compare disabled>Compare selected models</button></div></div></aside>

    <section id="MediumDutyChart-{{ section.id }}" class="mdc__chart-section" aria-labelledby="MediumDutyChartTitle-{{ section.id }}">
      <div class="mdc__section-heading mdc__section-heading--chart"><div><p class="mdc__section-kicker">Detailed specifications</p><h3 id="MediumDutyChartTitle-{{ section.id }}">Explore every function and specification</h3><p>Search the chart, focus on one section, or show only the rows that differ.</p></div></div>
      <div class="mdc__chart-controls" role="group" aria-label="Comparison chart controls">
        <div class="mdc__segmented" data-mdc-section-filter><button type="button" class="is-active" data-section-filter="all" aria-pressed="true">All</button><button type="button" data-section-filter="functions" aria-pressed="false">Functions</button><button type="button" data-section-filter="specifications" aria-pressed="false">Specifications</button></div>
        <label class="mdc__search-wrap"><span class="mdc__search-label">Search chart</span><input class="mdc__search" type="search" data-mdc-search placeholder="Try tax, speed, weight, or decimal" autocomplete="off"></label>
        <label class="mdc__switch"><input type="checkbox" data-mdc-differences><span class="mdc__switch-track" aria-hidden="true"></span><span>Show only differences</span></label>
      </div>
      <div class="mdc__table-status" data-mdc-table-status aria-live="polite"></div>
      <div class="mdc__table-wrap" tabindex="0" role="region" aria-label="Medium-duty calculator comparison chart"><table class="mdc__table" data-mdc-table></table></div>
    </section>

    <section id="MediumDutySupport-{{ section.id }}" class="mdc__support" aria-labelledby="MediumDutySupportTitle-{{ section.id }}"><div><p class="mdc__section-kicker">Talk with a calculator specialist</p><h3 id="MediumDutySupportTitle-{{ section.id }}">Still deciding between two models?</h3><p>{{ section.settings.support_text | escape }}</p></div><div class="mdc__support-actions"><a class="mdc__button mdc__button--primary" href="tel:{{ section.settings.phone_number | remove: '-' | remove: '(' | remove: ')' | remove: ' ' }}">Call {{ section.settings.phone_number | escape }}</a><a class="mdc__button mdc__button--secondary" href="{{ secondary_link }}">{{ section.settings.secondary_label | escape }}</a></div></section>
  </div>

  <div class="mdc__toast" data-mdc-toast hidden role="status" aria-live="polite"></div>
  <div class="mdc__modal" data-mdc-modal hidden><div class="mdc__modal-backdrop" data-mdc-close-modal></div><div class="mdc__modal-dialog" role="dialog" aria-modal="true" aria-labelledby="MediumDutyModalTitle-{{ section.id }}"><div class="mdc__modal-header"><div><p class="mdc__section-kicker">Selected models</p><h3 id="MediumDutyModalTitle-{{ section.id }}">Side-by-side comparison</h3></div><button type="button" class="mdc__modal-close" data-mdc-close-modal aria-label="Close comparison">×</button></div><div class="mdc__modal-body" data-mdc-modal-body></div><div class="mdc__modal-footer"><button type="button" class="mdc__button mdc__button--secondary" data-mdc-print>Print comparison</button><button type="button" class="mdc__button mdc__button--primary" data-mdc-close-modal>Done</button></div></div></div>
</section>

{% schema %}
{
  "name": "Medium-duty comparison",
  "tag": "section",
  "class": "section-medium-duty-comparison",
  "settings": [
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"Monroe medium-duty calculator guide"},
    {"type":"text","id":"heading","label":"Heading","default":"Find the Medium-Duty Printing Calculator That Fits Your Office"},
    {"type":"richtext","id":"intro","label":"Introduction","default":"<p>Compare the Monroe 6120X, 2020PlusX, and 122PDX by features, print speed, dimensions, decimal settings, and workflow. Use the guided finder or select any two models for a focused comparison.</p>"},
    {"type":"image_picker","id":"hero_image","label":"Optional replacement hero image"},
    {"type":"text","id":"primary_label","label":"Collection button label","default":"Shop medium-duty calculators"},
    {"type":"url","id":"primary_link","label":"Collection button link"},
    {"type":"text","id":"support_text","label":"Support text","default":"Tell us what calculations you perform, how often you print, and which features matter most. Our team is available Monday through Friday, 8 AM to 5 PM Eastern Time."},
    {"type":"text","id":"phone_number","label":"Phone number","default":"267-580-2600"},
    {"type":"text","id":"secondary_label","label":"Secondary button label","default":"View calculator manuals"},
    {"type":"url","id":"secondary_link","label":"Secondary button link"},
    {"type":"header","content":"Colors"},
    {"type":"color","id":"accent_color","label":"Accent","default":"#007681"},
    {"type":"color","id":"accent_dark","label":"Dark accent","default":"#005c64"},
    {"type":"color","id":"text_color","label":"Text","default":"#101820"},
    {"type":"color","id":"surface_color","label":"Surface","default":"#ffffff"},
    {"type":"color","id":"soft_color","label":"Soft background","default":"#eef7f7"}
  ],
  "presets": [{"name":"Medium-duty comparison"}]
}
{% endschema %}