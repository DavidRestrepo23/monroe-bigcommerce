{{ 'section-main-article.css' | asset_url | stylesheet_tag }}
{{ 'section-main-blog.css' | asset_url | stylesheet_tag }}
<script src="{{ 'article-navigation.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign article_words = article.content | strip_html | split: ' ' | size
  assign reading_time = article_words | divided_by: 200
  if reading_time < 1
    assign reading_time = 1
  endif
-%}

<div class="article-reading-progress" data-article-progress aria-hidden="true"><span></span></div>

<article class="article-page page-width" data-article-root>
  <header class="article-header">
    <nav class="article-breadcrumb" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">Home</a>
      <span aria-hidden="true">/</span>
      <a href="{{ blog.url }}">{{ blog.title | escape }}</a>
    </nav>

    <p class="article-header__eyebrow">Monroe Insights</p>
    <h1 class="article-header__title">{{ article.title | escape }}</h1>
    <div class="article-header__meta">
      <span class="article-header__author">
        {%- render 'icon-blog-book' -%}
        {{ article.author | escape }}
      </span>
      <span aria-hidden="true">•</span>
      <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">
        {{ article.published_at | date: '%B %d, %Y' }}
      </time>
      <span aria-hidden="true">•</span>
      <span>{{ reading_time }} min read</span>
    </div>
  </header>

  {%- if article.image != blank -%}
    <figure class="article-hero">
      {{ article.image | image_url: width: 2200 | image_tag:
        loading: 'eager',
        fetchpriority: 'high',
        widths: '720, 1000, 1400, 1800, 2200',
        sizes: '(min-width: 1200px) 1200px, 100vw',
        alt: article.image.alt | default: article.title
      }}
    </figure>
  {%- endif -%}

  <div class="article-layout">
    <aside class="article-toc article-toc--empty" data-article-toc>
      <button class="article-toc__toggle" type="button" data-toc-toggle aria-expanded="false">
        On this page
        <span aria-hidden="true">+</span>
      </button>
      <nav class="article-toc__nav" aria-label="Table of contents">
        <p class="article-toc__label">On this page</p>
        <ol class="article-toc__links" data-toc-links></ol>
      </nav>
    </aside>

    <div class="article-body" data-article-body>
      {{ article.content }}

      <footer class="article-share">
        <p class="article-share__label">Share this article</p>
        <div class="article-share__icons">
          <a href="https://www.linkedin.com/sharing/share-offsite/?url={{ article.url | prepend: shop.url | url_encode }}" target="_blank" rel="noopener noreferrer" aria-label="Share on LinkedIn">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          </a>
          <a href="https://www.facebook.com/sharer/sharer.php?u={{ article.url | prepend: shop.url | url_encode }}" target="_blank" rel="noopener noreferrer" aria-label="Share on Facebook">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
          </a>
          <a href="https://twitter.com/intent/tweet?url={{ article.url | prepend: shop.url | url_encode }}&amp;text={{ article.title | url_encode }}" target="_blank" rel="noopener noreferrer" aria-label="Share on X">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          </a>
        </div>
      </footer>
    </div>
  </div>

  {%- if blog.articles.size > 1 -%}
    <section class="article-related" aria-labelledby="more-from-monroe">
      <div class="article-related__header">
        <h2 id="more-from-monroe">More from Monroe</h2>
        <a href="{{ blog.url }}" class="article-related__all">View all posts <span aria-hidden="true">→</span></a>
      </div>
      <div class="article-related__grid">
        {%- assign related_count = 0 -%}
        {%- for related in blog.articles limit: 5 -%}
          {%- if related.id != article.id and related_count < 3 -%}
            {%- render 'blog-card', article: related -%}
            {%- assign related_count = related_count | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    </section>
  {%- endif -%}
</article>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": {{ article.title | json }},
  "datePublished": {{ article.published_at | date: '%Y-%m-%dT%H:%M:%S%z' | json }},
  "dateModified": {{ article.updated_at | date: '%Y-%m-%dT%H:%M:%S%z' | json }},
  "author": { "@type": "Person", "name": {{ article.author | json }} },
  "publisher": { "@type": "Organization", "name": {{ shop.name | json }} },
  "mainEntityOfPage": {{ article.url | prepend: shop.url | json }}{% if article.image != blank %},
  "image": {{ article.image | image_url: width: 2200 | prepend: 'https:' | json }}{% endif %}
}
</script>

{% schema %}
{
  "name": "Blog Article",
  "tag": "section",
  "settings": []
}
{% endschema %}
