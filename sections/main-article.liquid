{{ 'section-main-blog.css' | asset_url | stylesheet_tag }}
{{ 'section-main-article.css' | asset_url | stylesheet_tag }}
<script src="{{ 'article-navigation.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign words = article.content | strip_html | split: ' ' | size
  assign minutes = words | divided_by: 225
  if minutes < 1
    assign minutes = 1
  endif
  assign hero_alt = article.image.alt | default: article.title
  assign canonical_url = article.url | prepend: shop.url
  assign schema_image = blank
  if article.image != blank
    assign schema_image = article.image | image_url: width: 1600
    unless schema_image contains 'http'
      assign schema_image = schema_image | prepend: 'https:'
    endunless
  endif
-%}

<article class="tw-article" data-article-navigation>
  <header class="tw-article__header page-width">
    <nav class="tw-article__breadcrumbs" aria-label="Breadcrumb">
      <ol>
        <li><a href="{{ routes.root_url }}">Home</a></li>
        <li><a href="{{ blog.url }}">{{ blog.title | escape }}</a></li>
        <li aria-current="page">{{ article.title | escape }}</li>
      </ol>
    </nav>
    <p class="tw-article__kicker">{{ blog.title | escape }}</p>
    <h1>{{ article.title | escape }}</h1>
    <div class="tw-article__meta">
      {%- if article.author != blank -%}<span>By {{ article.author | escape }}</span>{%- endif -%}
      {%- if article.published_at != blank -%}<time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | date: '%B %d, %Y' }}</time>{%- endif -%}
      <span>{{ minutes }} min read</span>
    </div>
  </header>

  {%- if article.image != blank -%}
    <figure class="tw-article__hero page-width" style="--tw-hero-native-width: {{ article.image.width }}px;">
      {{ article.image | image_url: width: 2000 | image_tag:
        class: 'tw-article__hero-image', loading: 'eager', fetchpriority: 'high',
        widths: '480, 720, 960, 1200, 1600, 2000',
        sizes: '(min-width: 1200px) min(100vw - 10rem, var(--tw-hero-native-width)), 100vw',
        alt: hero_alt, width: article.image.width, height: article.image.height
      }}
    </figure>
  {%- endif -%}

  <div class="tw-article__layout page-width">
    <aside class="tw-article__aside">
      {%- if section.settings.enable_toc -%}
        <details class="tw-article__toc" data-article-toc hidden>
          <summary>In this article</summary>
          <ol data-article-toc-list></ol>
        </details>
      {%- endif -%}
    </aside>

    <div class="tw-article__main">
      <div class="tw-article__content rte" data-article-content>{{ article.content }}</div>

      {%- if section.settings.enable_share -%}
        <div class="tw-article__share" aria-labelledby="tw-share-title-{{ section.id }}">
          <p id="tw-share-title-{{ section.id }}">Share this article</p>
          <div>
            <a href="https://www.facebook.com/sharer/sharer.php?u={{ canonical_url | url_encode }}" target="_blank" rel="noopener noreferrer">Facebook<span class="visually-hidden"> (opens in a new tab)</span></a>
            <a href="https://www.linkedin.com/sharing/share-offsite/?url={{ canonical_url | url_encode }}" target="_blank" rel="noopener noreferrer">LinkedIn<span class="visually-hidden"> (opens in a new tab)</span></a>
            <button type="button" data-copy-article-link data-copy-label="Copy link" data-copied-label="Copied">Copy link</button>
          </div>
          <span class="visually-hidden" data-copy-status aria-live="polite"></span>
        </div>
      {%- endif -%}
      <a class="tw-article__return" href="{{ blog.url }}">← Back to {{ blog.title | escape }}</a>
    </div>
  </div>

  {%- if section.settings.enable_related and blog.articles.size > 1 -%}
    <section class="tw-article__related page-width" aria-labelledby="tw-related-title-{{ section.id }}">
      <div class="tw-article__related-header">
        <h2 id="tw-related-title-{{ section.id }}">Continue reading</h2>
        <a href="{{ blog.url }}">View all articles</a>
      </div>
      <div class="tw-blog-grid">
        {%- assign related_count = 0 -%}
        {%- for candidate in blog.articles -%}
          {%- if candidate.id != article.id and related_count < 3 -%}
            {%- render 'blog-card', article: candidate, heading_level: 'h3', show_excerpt: false, image_fit: 'contain' -%}
            {%- assign related_count = related_count | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    </section>
  {%- endif -%}
</article>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": {{ article.title | json }},
  "description": {{ article.excerpt_or_content | strip_html | truncate: 300 | json }},
  "datePublished": {{ article.published_at | date: '%Y-%m-%dT%H:%M:%S%z' | json }},
  "dateModified": {{ article.updated_at | date: '%Y-%m-%dT%H:%M:%S%z' | json }},
  "author": { "@type": "Person", "name": {{ article.author | json }} },
  "publisher": { "@type": "Organization", "name": {{ shop.name | json }} },
  "mainEntityOfPage": { "@type": "WebPage", "@id": {{ canonical_url | json }} }{% if schema_image != blank %},
  "image": {{ schema_image | json }}{% endif %}
}
</script>

{% schema %}
{
  "name": "Main article",
  "tag": "section",
  "settings": [
    { "type": "checkbox", "id": "enable_toc", "label": "Show table of contents when useful", "default": true },
    { "type": "checkbox", "id": "enable_share", "label": "Show sharing links", "default": true },
    { "type": "checkbox", "id": "enable_related", "label": "Show related articles", "default": true }
  ]
}
{% endschema %}
