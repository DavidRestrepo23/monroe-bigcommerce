  <script>
    (function(){
      "use strict";

      var root = document.getElementById("msMarketplaceManagement");
      if(!root) return;

      var modal = document.querySelector("[data-modal]");
      var body = document.body;

      /* Ensure modal is attached to <body> to avoid theme stacking contexts */
      if(modal && modal.parentNode !== body){
        body.appendChild(modal);
      }

      /* Compute a safe top offset so modal never hides under sticky header/search */
      function setModalTopOffset(){
        var selectors = [
          "header",
          "#header",
          ".header",
          ".siteHeader",
          ".headerWrap",
          ".header--fixed",
          ".is-sticky",
          ".sticky",
          ".navUser",
          ".navPages-container"
        ];

        var maxBottom = 0;

        for(var i=0;i<selectors.length;i++){
          var el = document.querySelector(selectors[i]);
          if(!el) continue;

          var cs = window.getComputedStyle(el);
          if(cs.position !== "fixed" && cs.position !== "sticky") continue;

          var r = el.getBoundingClientRect();
          if(r.height < 40) continue;

          maxBottom = Math.max(maxBottom, Math.ceil(r.bottom));
        }

        if(maxBottom < 80) maxBottom = 140;
        root.style.setProperty("--ms-modal-top", (maxBottom + 16) + "px");
      }

      setModalTopOffset();
      window.addEventListener("resize", setModalTopOffset, { passive: true });

      /* Count up */
      var counters = root.querySelectorAll(".ms-mm__count");
      var ranCounts = false;

      function easeOutQuad(t){ return t * (2 - t); }

      function runCounters(){
        if(ranCounts) return;
        ranCounts = true;

        counters.forEach(function(el){
          var target = parseInt(el.getAttribute("data-count") || "0", 10);
          var suffix = el.getAttribute("data-suffix") || "";
          var duration = 700;
          var start = performance.now();

          function tick(now){
            var p = Math.min(1, (now - start) / duration);
            var v = Math.round(target * easeOutQuad(p));
            el.textContent = String(v) + suffix;
            if(p < 1) requestAnimationFrame(tick);
          }
          requestAnimationFrame(tick);
        });
      }

      if("IntersectionObserver" in window && counters.length){
        var io = new IntersectionObserver(function(entries){
          for(var i=0;i<entries.length;i++){
            if(entries[i].isIntersecting){
              runCounters();
              io.disconnect();
              break;
            }
          }
        }, { rootMargin: "0px 0px -20% 0px" });

        io.observe(counters[0]);
      } else if(counters.length){
        runCounters();
      }

      /* Tabs */
      var tabsWrap = root.querySelector("[data-tabs]");
      if(tabsWrap){
        var tabButtons = tabsWrap.querySelectorAll(".ms-mm__tabBtn");
        var panels = {
          core: tabsWrap.querySelector("#tab-core"),
          growth: tabsWrap.querySelector("#tab-growth"),
          specialty: tabsWrap.querySelector("#tab-specialty")
        };

        function setTab(name){
          tabButtons.forEach(function(btn){
            var selected = btn.getAttribute("data-tab") === name;
            btn.setAttribute("aria-selected", selected ? "true" : "false");
          });
          Object.keys(panels).forEach(function(k){
            if(!panels[k]) return;
            var hidden = (k !== name);
            panels[k].setAttribute("aria-hidden", hidden ? "true" : "false");
          });
        }

        tabsWrap.addEventListener("click", function(e){
          var btn = e.target.closest(".ms-mm__tabBtn");
          if(!btn) return;
          setTab(btn.getAttribute("data-tab"));
        });
      }

      /* FAQ accordion */
      var faq = root.querySelector("[data-faq]");
      if(faq){
        faq.addEventListener("click", function(e){
          var btn = e.target.closest(".ms-mm__q");
          if(!btn) return;
          var item = btn.closest(".ms-mm__qa");
          if(!item) return;

          var isOpen = item.getAttribute("data-open") === "true";
          item.setAttribute("data-open", isOpen ? "false" : "true");
        });
      }

      /* Modal open/close */
      function openModal(){
        if(!modal) return;

        setModalTopOffset();

        modal.setAttribute("data-open", "true");
        modal.setAttribute("aria-hidden", "false");
        document.documentElement.style.overflow = "hidden";

        /* Nudge layout so HubSpot embedded frame renders correctly */
        setTimeout(function(){
          var frame = modal.querySelector(".hs-form-frame");
          if(frame){
            frame.style.display = "none";
            frame.offsetHeight;
            frame.style.display = "";
          }
        }, 60);
      }

      function closeModal(){
        if(!modal) return;
        modal.setAttribute("data-open", "false");
        modal.setAttribute("aria-hidden", "true");
        document.documentElement.style.overflow = "";
      }

      /* Delegated handler so only important CTA buttons trigger the modal */
      document.addEventListener("click", function(e){
        var opener = e.target.closest("[data-open-modal='true']");
        if(opener){
          e.preventDefault();
          openModal();
          return;
        }

        if(modal && e.target === modal){
          closeModal();
          return;
        }

        var closeBtn = e.target.closest("[data-close-modal='true']");
        if(closeBtn){
          e.preventDefault();
          closeModal();
        }
      });

      document.addEventListener("keydown", function(e){
        if(!modal) return;
        if(e.key === "Escape" && modal.getAttribute("data-open") === "true"){
          closeModal();
        }
      });

      /* Smooth in-page navigation */
      root.addEventListener("click", function(e){
        var a = e.target.closest('a[href^="#"]');
        if(!a) return;

        var id = a.getAttribute("href");
        if(!id || id.length < 2) return;

        var target = document.querySelector(id);
        if(!target) return;

        e.preventDefault();
        target.scrollIntoView({ behavior: "smooth", block: "start" });
        history.replaceState(null, "", id);
      });
    })();
  </script>

