          </tr>
          <tr>
            <td><span class="tw-brandPill">Nakajima</span></td>
            <td>AE 800</td>
            <td><a class="tw-download" href="https://typewritermanuals.s3.us-east-1.amazonaws.com/Nakajima/AE800_Operation_Manual.pdf" target="_blank" rel="noopener"><span class="tw-ico" aria-hidden="true"></span>Download manual</a></td>
          </tr>
          <tr>
            <td><span class="tw-brandPill">Nakajima</span></td>
            <td>AE 830</td>
            <td><a class="tw-download" href="https://typewritermanuals.s3.us-east-1.amazonaws.com/Nakajima/AE830_Operation_Manual.pdf" target="_blank" rel="noopener"><span class="tw-ico" aria-hidden="true"></span>Download manual</a></td>
          </tr>
          <tr>
            <td><span class="tw-brandPill">Nakajima</span></td>
            <td>WPT-150</td>
            <td><a class="tw-download" href="https://typewritermanuals.s3.us-east-1.amazonaws.com/Nakajima/WPT150_Operation_Manual.pdf" target="_blank" rel="noopener"><span class="tw-ico" aria-hidden="true"></span>Download manual</a></td>
          </tr>
          <tr>
            <td><span class="tw-brandPill">Nakajima</span></td>
            <td>WPT-160</td>
            <td><a class="tw-download" href="https://typewritermanuals.s3.us-east-1.amazonaws.com/Nakajima/WPT160_Operation_Manual.pdf" target="_blank" rel="noopener"><span class="tw-ico" aria-hidden="true"></span>Download manual</a></td>
