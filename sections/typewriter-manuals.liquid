{{ 'section-typewriter-manuals.css' | asset_url | stylesheet_tag }}
<script src="{{ 'section-typewriter-manuals.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign manual_products = section.settings.manual_products

  if manual_products == blank
    assign manual_collection = section.settings.product_collection

    if manual_collection == blank
      assign manual_collection = collections['new-and-reconditioned-typewriters']
    endif

    assign manual_products = manual_collection.products
  endif
-%}

<typewriter-manual-library
  id="twm-{{ section.id }}"
  class="twm-library"
  data-section-id="{{ section.id }}"
  data-default-brand="all"
  style="--twm-accent: {{ section.settings.accent_color }}; --twm-paper: {{ section.settings.paper_color }}; --twm-ink: {{ section.settings.ink_color }};"
>
  <div class="twm-library__shell">
    {% render 'typewriter-manuals-content', section: section %}

    <section id="manual-library-{{ section.id }}" class="twm-library__catalog" aria-labelledby="twm-catalog-title-{{ section.id }}">
      <div class="twm-library__catalog-heading">
        <div>
          <p class="twm-library__kicker">The reference shelf</p>
          <h2 id="twm-catalog-title-{{ section.id }}">Browse typewriter manuals</h2>
        </div>
        <p class="twm-library__status" data-manual-status role="status" aria-live="polite">28 manuals available</p>
      </div>

      <div class="twm-library__toolbar" aria-label="Manual search and filters">
        <label class="twm-library__search" for="twm-search-{{ section.id }}">
          <span>Search by brand or model</span>
          <span class="twm-library__search-field">
            <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20"><path d="m21 21-4.35-4.35m2.35-5.15a7.5 7.5 0 1 1-15 0 7.5 7.5 0 0 1 15 0Z" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="2"/></svg>
            <input id="twm-search-{{ section.id }}" type="search" placeholder="Try Wheelwriter 10, EM-630, or WPT-160" autocomplete="off" data-manual-search>
            <button type="button" class="twm-library__clear" data-clear-search hidden>Clear</button>
          </span>
        </label>

        <fieldset class="twm-library__brands" data-brand-filters>
          <legend>Filter by brand</legend>
          <div>
            <button type="button" aria-pressed="true" data-brand="all">All</button>
            <button type="button" aria-pressed="false" data-brand="ibm">IBM</button>
            <button type="button" aria-pressed="false" data-brand="nakajima">Nakajima</button>
            <button type="button" aria-pressed="false" data-brand="brother">Brother</button>
          </div>
        </fieldset>

        <label class="twm-library__sort" for="twm-sort-{{ section.id }}">
          <span>Sort manuals</span>
          <select id="twm-sort-{{ section.id }}" data-manual-sort>
            <option value="featured">Reference order</option>
            <option value="brand">Brand, A to Z</option>
            <option value="model">Model, A to Z</option>
          </select>
        </label>
      </div>

      <div class="twm-library__grid" data-manual-grid>
        {% render 'typewriter-manuals-data', section: section, manual_products: manual_products %}
      </div>

      <div class="twm-library__empty" data-manual-empty hidden>
        <span aria-hidden="true">No match</span>
        <h3>That model is not on this shelf yet.</h3>
        <p>Check the spelling on the machine label, try only the model number, or ask our team for help.</p>
        <button type="button" class="twm-library__button twm-library__button--dark" data-reset-manuals>Show all manuals</button>
      </div>
    </section>

    {% render 'typewriter-manuals-support', section: section %}
  </div>
</typewriter-manual-library>

{% schema %}
{
  "name": "Typewriter Manuals",
  "tag": "section",
  "class": "section-typewriter-manuals",
  "settings": [
    {
      "type": "header",
      "content": "Page content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": "Find the right manual without the guesswork"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Introduction",
      "default": "<p>Copy the brand and model number from the label on your machine, then search or filter the reference shelf below. Each manual opens as a PDF in a new tab.</p>"
    },
    {
      "type": "text",
      "id": "phone_label",
      "label": "Phone number label",
      "default": "(404) 377-1884"
    },
    {
      "type": "text",
      "id": "phone_link",
      "label": "Phone link",
      "default": "+14043771884"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Support email",
      "default": "info@typewriters.com"
    },
    {
      "type": "checkbox",
      "id": "show_product_links",
      "label": "Show matching product links",
      "default": true
    },
    {
      "type": "header",
      "content": "Product images"
    },
    {
      "type": "product_list",
      "id": "manual_products",
      "label": "Manual model products",
      "limit": 30,
      "info": "Optional curated source for live product images and links."
    },
    {
      "type": "collection",
      "id": "product_collection",
      "label": "Fallback product collection",
      "info": "Used when the product list is empty. New & Reconditioned Typewriters is the automatic final fallback."
    },
    {
      "type": "header",
      "content": "Retro palette"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Ribbon red",
      "default": "#c94b42"
    },
    {
      "type": "color",
      "id": "paper_color",
      "label": "Reference paper",
      "default": "#f4ecd8"
    },
    {
      "type": "color",
      "id": "ink_color",
      "label": "Typewriter ink",
      "default": "#25211b"
    }
  ],
  "presets": [
    {
      "name": "Typewriter Manuals",
      "settings": {
        "manual_products": [
          "ibm-lexmark-personal-wheelwriter-1-electric-typewriter-reconditioned",
          "ibm-lexmark-personal-wheelwriter-2-electric-typewriter-reconditioned",
          "ibm-lexmark-wheelwriter-3-electric-typewriter-reconditioned",
          "ibm-lexmark-wheelwriter-5-reconditioned",
          "ibm-lexmark-wheelwriter-6-electronic-typewriter-reconditioned",
          "ibm-lexmark-wheelwriter-6-series-ii-electric-typewriter-reconditioned",
          "ibm-lexmark-wheelwriter-10-electric-typewriter-reconditioned",
          "ibm-lexmark-wheelwriter-15-electronic-typewriter-reconditioned",
          "ibm-lexmark-wheelwriter-30-electric-typewriter-reconditioned",
          "ibm-lexmark-wheelwriter-35-electric-typewriter-reconditioned",
          "ibm-lexmark-wheelwriter-50-reconditioned",
          "ibm-lexmark-wheelwriter-70-reconditioned",
          "ibm-lexmark-wheelwriter-1000-electronic-typewriter-reconditioned",
          "ibm-lexmark-wheelwriter-1500-electronic-typewriter-reconditioned",
          "ibm-lexmark-wheelwriter-2000-electric-typewriter-reconditioned",
          "ibm-lexmark-wheelwriter-3000-electric-typewriter-reconditioned",
          "ibm-lexmark-wheelwriter-3500-electric-typewriter-reconditioned",
          "ibm-lexmark-wheelwriter-5000-reconditioned",
          "ibm-lexmark-wheelwriter-7000-reconditioned",
          "nakajima-wpt-150-portable-electronic-word-processing-typewriter",
          "nakajima-wpt-160-portable-electronic-word-processing-typewriter"
        ]
      }
    }
  ]
}
{% endschema %}