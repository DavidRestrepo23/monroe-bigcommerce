  <div class="tw-bottombar"></div>
</div>


<script>
  (function(){
    function initTypewriterManuals(root){
      if(!root || root.getAttribute('data-tw-ready') === 'true') return;
      root.setAttribute('data-tw-ready', 'true');

      var table = root.querySelector('[data-tw-table]');
      var tbody = table ? table.tBodies[0] : null;
      if(!tbody) return;

      var search = root.querySelector('[data-tw-search]');
      var clear = root.querySelector('[data-tw-clear]');
      var chipsWrap = root.querySelector('[data-tw-chips]');
      var countEl = root.querySelector('[data-tw-count]');
      var cardsWrap = root.querySelector('[data-tw-cards]');

      function text(el){ return (el && el.textContent ? el.textContent : '').trim(); }

      var rows = Array.prototype.slice.call(tbody.querySelectorAll('tr')).map(function(tr){
        var tds = tr.querySelectorAll('td');
        var brand = text(tds[0]);
        var model = text(tds[1]);
        var manualLinks = Array.prototype.slice.call((tds[2] || tr).querySelectorAll('a')).map(function(a){
          return { href: a.getAttribute('href'), label: text(a) || 'Download manual' };
        });
        return { tr: tr, brand: brand.replace(/\s+/g,' ').trim(), model: model.replace(/\s+/g,' ').trim(), links: manualLinks };
      });

      var brandSet = {};
      rows.forEach(function(r){ if(r.brand) brandSet[r.brand] = true; });
      var brands = Object.keys(brandSet).sort();
      var activeBrand = 'All';

      function makeChip(name){
        var b = document.createElement('button');
        b.type = 'button';
        b.className = 'tw-chip';
        b.textContent = name;
        b.setAttribute('aria-pressed', name === 'All' ? 'true' : 'false');
        b.addEventListener('click', function(){
          activeBrand = name;
          Array.prototype.slice.call(chipsWrap.querySelectorAll('.tw-chip')).forEach(function(x){
            x.setAttribute('aria-pressed', x.textContent === name ? 'true' : 'false');
          });
          apply();
        });
        return b;
      }

      if(chipsWrap){
        chipsWrap.innerHTML = '';
        chipsWrap.appendChild(makeChip('All'));
        brands.forEach(function(b){ chipsWrap.appendChild(makeChip(b)); });
      }

      function matches(r, q){
        var hay = (r.brand + ' ' + r.model).toLowerCase();
        return hay.indexOf(q) !== -1;
      }

      function esc(str){
        return String(str || '')
          .replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')
          .replace(/"/g,'&quot;').replace(/'/g,'&#039;');
      }

      function renderCards(visible){
        if(!cardsWrap) return;
        cardsWrap.innerHTML = '';
        visible.forEach(function(r){
          var card = document.createElement('div');
          card.className = 'tw-card';
          var linksHtml = r.links.map(function(l){
            return '<a class="tw-download" href="' + esc(l.href) + '" target="_blank" rel="noopener"><span class="tw-ico" aria-hidden="true"></span>' + esc(l.label || 'Download manual') + '</a>';
          }).join('<span style="display:inline-block;width:10px;"></span>');

          card.innerHTML =
            '<div class="tw-cardTop">' +
              '<p class="tw-cardTitle" style="margin:0;"><span class="tw-brandPill">' + esc(r.brand || '') + '</span></p>' +
              '<span style="display:inline-block;padding:6px 10px;border-radius:999px;border:1px solid rgba(0,0,0,.14);background:rgba(210,71,66,.08);color:#7a1f1c;font-size:12px;">Manual</span>' +
            '</div>' +
            '<p class="tw-cardMeta"><strong style="color:#111;">Model:</strong> ' + esc(r.model || '') + '</p>' +
            '<div>' + linksHtml + '</div>';

          cardsWrap.appendChild(card);
        });
      }

      function apply(){
        var q = (search && search.value ? search.value : '').trim().toLowerCase();
        var visible = rows.filter(function(r){
          var brandOk = (activeBrand === 'All') || (r.brand === activeBrand);
          var qOk = !q || matches(r, q);
          return brandOk && qOk;
        });

        rows.forEach(function(r){ r.tr.style.display = 'none'; });
        visible.forEach(function(r){ r.tr.style.display = ''; });

        if(countEl){
          countEl.textContent = visible.length + ' manual' + (visible.length === 1 ? '' : 's') + ' shown';
        }

        renderCards(visible);
      }

      if(search){
        var t;
        search.addEventListener('input', function(){
          clearTimeout(t);
          t = setTimeout(apply, 60);
        });
      }

      if(clear){
        clear.addEventListener('click', function(){
          if(search) search.value = '';
          activeBrand = 'All';
          if(chipsWrap){
            Array.prototype.slice.call(chipsWrap.querySelectorAll('.tw-chip')).forEach(function(x){
              x.setAttribute('aria-pressed', x.textContent === 'All' ? 'true' : 'false');
            });
          }
          apply();
        });
      }

      apply();
    }

    function bootTypewriterManuals(){
      initTypewriterManuals(document.getElementById('tw-manuals-{{ section.id }}'));
    }

    if(document.readyState === 'loading'){
      document.addEventListener('DOMContentLoaded', bootTypewriterManuals);
    } else {
      bootTypewriterManuals();
    }

    document.addEventListener('shopify:section:load', function(event){
      var loadedRoot = event.target && event.target.querySelector ? event.target.querySelector('#tw-manuals-{{ section.id }}') : null;
      initTypewriterManuals(loadedRoot);
    });
  })();
</script>

{% schema %}
{
  "name": "Typewriter Manuals",
  "tag": "section",
  "class": "section-typewriter-manuals",
  "settings": [
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero image"
    }
  ],
  "presets": [
    {
      "name": "Typewriter Manuals"
    }
  ]
}
{% endschema %}