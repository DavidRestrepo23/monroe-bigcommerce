{%- if search.performed and search.results_count > 0 -%}

  {%- assign first_product_id = '' -%}
  {%- for item in search.results -%}
    {%- if item.object_type == 'product' and first_product_id == '' -%}
      {%- assign first_product_id = item.id -%}
    {%- endif -%}
  {%- endfor -%}

  {%- if first_product_id != '' -%}

    <section
      id="SearchRecs-{{ section.id }}"
      class="msrs-recs"
      data-product-id="{{ first_product_id }}"
      hidden
    >
      <div class="msrs-recs__container">
        <h2 class="msrs-recs__heading">You may also like</h2>
        <ul
          class="msrs-recs__grid"
          id="SearchRecsGrid-{{ section.id }}"
          role="list"
        ></ul>
      </div>
    </section>

    <style>
      /*
        Monroe Search Recommendations
        Isolated to sections/search-recommendations.liquid only.
        All styling scoped under #SearchRecs-{{ section.id }}.
      */

      #SearchRecs-{{ section.id }} {
        --msrs-accent: #007681;
        --msrs-accent-hover: #005f68;
        --msrs-text: #000000;
        --msrs-muted: rgba(28, 28, 28, 0.52);
        --msrs-border: rgba(0, 0, 0, 0.12);
        --msrs-card-bg: #f4f4f4;
        --msrs-radius: 16px;
        --msrs-font: var(--font-family, Arial, Helvetica, sans-serif);

        display: block;
        width: 100%;
        padding: 48px 0 60px;
        border-top: 1px solid rgba(0, 0, 0, 0.08);
        background: #ffffff;
        font-family: var(--msrs-font);
      }

      #SearchRecs-{{ section.id }} *,
      #SearchRecs-{{ section.id }} *::before,
      #SearchRecs-{{ section.id }} *::after {
        box-sizing: border-box;
      }

      #SearchRecs-{{ section.id }} .msrs-recs__container {
        width: 100%;
        max-width: none;
        margin: 0 auto;
        padding: 0 24px;
      }

      #SearchRecs-{{ section.id }} .msrs-recs__heading {
        margin: 0 0 28px;
        font-size: 1.5rem;
        font-weight: 700;
        letter-spacing: -0.01em;
        color: var(--msrs-text);
      }

      #SearchRecs-{{ section.id }} .msrs-recs__grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 32px;
        margin: 0;
        padding: 0;
        list-style: none;
      }

      #SearchRecs-{{ section.id }} .msrs-recs__grid > li::marker {
        content: "";
      }

      #SearchRecs-{{ section.id }} .msrs-recs__item {
        margin: 0;
        padding: 0;
        list-style: none;
      }

      /* Product cards scoped only to this recommendations section */

      #SearchRecs-{{ section.id }} .product-card {
        display: flex;
        flex-direction: column;
        gap: 14px;
        background: transparent;
      }

      #SearchRecs-{{ section.id }} .product-card__media {
        position: relative;
        display: block;
        aspect-ratio: 1 / 1;
        max-height: 200px;
        max-width: 200px;
        background: var(--msrs-card-bg);
        border-radius: var(--msrs-radius);
        overflow: hidden;
        text-decoration: none;
      }

      #SearchRecs-{{ section.id }} .product-card__media img,
      #SearchRecs-{{ section.id }} .product-card__media > div {
        width: 100%;
        height: 100%;
        object-fit: contain;
        display: block;
        transition: transform 0.4s ease;
      }

      #SearchRecs-{{ section.id }} .product-card__media:hover img {
        transform: scale(1.03);
      }

      #SearchRecs-{{ section.id }} .product-card__info {
        display: flex;
        flex-direction: column;
        gap: 10px;
      }

      #SearchRecs-{{ section.id }} .product-card__title {
        margin: 0;
        font-size: 1.25rem;
        font-weight: 500;
        line-height: 1.35;
        color: var(--msrs-text);
      }

      #SearchRecs-{{ section.id }} .product-card__title a {
        color: inherit;
        text-decoration: none;
      }

      #SearchRecs-{{ section.id }} .product-card__title a:hover {
        text-decoration: underline;
      }

      #SearchRecs-{{ section.id }} .product-card__row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
      }

      #SearchRecs-{{ section.id }} .product-card__price {
        display: inline-flex;
        align-items: baseline;
        gap: 8px;
        font-size: 1.25rem;
        font-weight: 400;
        color: var(--msrs-text);
        font-family: var(--msrs-font);
      }

      #SearchRecs-{{ section.id }} .product-card__price del {
        color: #9a9a9a;
        font-weight: 400;
        font-size: 0.85rem;
      }

      #SearchRecs-{{ section.id }} .product-card__cart {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        background: var(--msrs-accent);
        color: #ffffff;
        border: 0;
        border-radius: 999px;
        padding: 8px 16px;
        font-size: 1.125rem;
        font-weight: 500;
        cursor: pointer;
        transition: background 0.2s ease;
        font-family: var(--msrs-font);
      }

      #SearchRecs-{{ section.id }} .product-card__cart:hover:not(:disabled) {
        background: var(--msrs-accent-hover);
      }

      #SearchRecs-{{ section.id }} .product-card__cart:disabled {
        opacity: 0.55;
        cursor: not-allowed;
      }

      #SearchRecs-{{ section.id }} .product-card__cart svg {
        width: 12px;
        height: 12px;
      }

      /* Responsive */

      @media (max-width: 989px) {
        #SearchRecs-{{ section.id }} .msrs-recs__grid {
          grid-template-columns: repeat(3, minmax(0, 1fr));
        }
      }

      @media (max-width: 749px) {
        #SearchRecs-{{ section.id }} {
          padding: 36px 0 48px;
        }

        #SearchRecs-{{ section.id }} .msrs-recs__container {
          padding: 0 16px;
        }

        #SearchRecs-{{ section.id }} .msrs-recs__grid {
          grid-template-columns: repeat(2, minmax(0, 1fr));
          gap: 24px 16px;
        }

        #SearchRecs-{{ section.id }} .product-card__title {
          font-size: 0.9rem;
        }

        #SearchRecs-{{ section.id }} .product-card__price {
          font-size: 1rem;
        }

        #SearchRecs-{{ section.id }} .product-card__cart {
          padding: 8px 12px;
        }

        #SearchRecs-{{ section.id }} .product-card__cart span {
          display: none;
        }
      }

      @media (max-width: 480px) {
        #SearchRecs-{{ section.id }} .msrs-recs__grid {
          grid-template-columns: 1fr;
        }
      }
    </style>

    <script>
      (function () {
        var section = document.getElementById('SearchRecs-{{ section.id }}');
        var grid = document.getElementById('SearchRecsGrid-{{ section.id }}');
        if (!section || !grid) return;

        var productId = section.dataset.productId;
        if (!productId) return;

        function escHtml(str) {
          return String(str || '')
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#39;');
        }

        function fmtMoney(cents) {
          return '$' + (cents / 100).toFixed(2);
        }

        function getImgSrc(product) {
          var fi = product.featured_image;
          if (fi) {
            var raw = typeof fi === 'string' ? fi : (fi.src || '');
            if (raw) {
              raw = raw.startsWith('//') ? 'https:' + raw : raw;
              return raw.replace(/\.(jpg|jpeg|png|gif|webp)(\?|$)/i, '_480x480.$1$2');
            }
          }
          if (product.images && product.images.length > 0) {
            var img = product.images[0];
            var src = typeof img === 'string' ? img : (img.src || '');
            if (src) {
              src = src.startsWith('//') ? 'https:' + src : src;
              return src.replace(/\.(jpg|jpeg|png|gif|webp)(\?|$)/i, '_480x480.$1$2');
            }
          }
          return '';
        }

        function buildCard(p) {
          var firstVariant = p.variants && p.variants.length > 0 ? p.variants[0] : null;
          var variantId = firstVariant ? firstVariant.id : '';
          var available = firstVariant ? firstVariant.available : false;
          var imgSrc = getImgSrc(p);

          var imgHtml = imgSrc
            ? '<img src="' + escHtml(imgSrc) + '" alt="' + escHtml(p.title) + '" loading="lazy" width="480" height="480">'
            : '<div style="width:100%;height:100%;background:#f4f4f4;display:flex;align-items:center;justify-content:center;color:#bbb;font-size:0.8rem;">No image</div>';

          var priceHtml = '';
          if (p.compare_at_price_min && p.compare_at_price_min > p.price_min) {
            priceHtml += '<del>' + fmtMoney(p.compare_at_price_min) + '</del> ';
          }
          priceHtml += fmtMoney(p.price_min);

          var cartBtn = '<button'
            + ' class="product-card__cart"'
            + ' type="button"'
            + ' data-add-to-cart'
            + ' data-variant-id="' + variantId + '"'
            + ' data-product-url="' + escHtml(p.url) + '"'
            + (available ? '' : ' disabled')
            + '>'
            + '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">'
            + '<path d="M7 1V13M1 7H13" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>'
            + '</svg>'
            + '<span>' + (available ? 'Cart' : 'Sold Out') + '</span>'
            + '</button>';

          return '<li class="msrs-recs__item">'
            + '<article class="product-card">'
            + '<a class="product-card__media" href="' + escHtml(p.url) + '" aria-label="' + escHtml(p.title) + '">'
            + imgHtml
            + '</a>'
            + '<div class="product-card__info">'
            + '<h3 class="product-card__title"><a href="' + escHtml(p.url) + '">' + escHtml(p.title) + '</a></h3>'
            + '<div class="product-card__row">'
            + '<span class="product-card__price">' + priceHtml + '</span>'
            + cartBtn
            + '</div>'
            + '</div>'
            + '</article>'
            + '</li>';
        }

        fetch(
          '/recommendations/products.json?product_id=' + encodeURIComponent(productId) + '&limit=4&intent=related',
          { headers: { 'Accept': 'application/json' } }
        )
          .then(function (r) {
            if (!r.ok) throw new Error('Recommendations fetch failed');
            return r.json();
          })
          .then(function (data) {
            if (!data.products || data.products.length === 0) return;
            grid.innerHTML = data.products.map(buildCard).join('');
            section.hidden = false;
          })
          .catch(function () {
            // Fail silently - section stays hidden
          });
      })();
    </script>

  {%- endif -%}
{%- endif -%}

{% schema %}
{
  "name": "Search recommendations",
  "settings": [],
  "enabled_on": {
    "templates": ["search"]
  }
}
{% endschema %}