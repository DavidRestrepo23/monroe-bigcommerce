{{ 'section-main-blog.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign current_tag = current_tags | first
  assign image_fit = section.settings.card_image_fit | default: 'contain'
-%}

<section class="tw-blog tw-blog--fit-{{ image_fit }}" aria-labelledby="tw-blog-title-{{ section.id }}">
  <header class="tw-blog__masthead page-width">
    <p class="tw-blog__eyebrow">{{ blog.title | escape }}</p>
    <h1 id="tw-blog-title-{{ section.id }}">{{ section.settings.heading | default: blog.title | escape }}</h1>
    {%- if section.settings.introduction != blank -%}<div class="tw-blog__intro rte">{{ section.settings.introduction }}</div>{%- endif -%}
  </header>

  {%- paginate blog.articles by section.settings.articles_per_page -%}
    <div class="page-width">
      {%- if current_tag != blank -%}
        <div class="tw-blog__filter-status"><p>Showing articles tagged <strong>{{ current_tag | escape }}</strong></p><a href="{{ blog.url }}">Clear filter</a></div>
      {%- endif -%}

      {%- if paginate.current_page == 1 and current_tag == blank and blog.articles.size > 0 -%}
        {%- assign featured_article = blog.articles.first -%}
        {%- assign featured_alt = featured_article.image.alt | default: featured_article.title -%}
        <div class="tw-blog-featured">
          <article class="tw-blog-featured__primary">
            <a class="tw-blog-featured__media" href="{{ featured_article.url }}"{% if featured_article.image != blank %} style="--tw-source-width: {{ featured_article.image.width }}px;"{% endif %}>
              {%- if featured_article.image != blank -%}
                {{ featured_article.image | image_url: width: 1600 | image_tag:
                  class: 'tw-blog-featured__image', loading: 'eager', fetchpriority: 'high',
                  widths: '540, 750, 960, 1200, 1600', sizes: '(min-width: 990px) 64vw, 100vw',
                  alt: featured_alt, width: featured_article.image.width, height: featured_article.image.height
                }}
              {%- endif -%}
            </a>
            <div class="tw-blog-featured__body">
              <p class="tw-blog-featured__label">Featured article</p>
              <p class="tw-blog-card__meta"><span>{{ featured_article.author | escape }}</span><span aria-hidden="true">·</span><time datetime="{{ featured_article.published_at | date: '%Y-%m-%d' }}">{{ featured_article.published_at | date: '%b %d, %Y' }}</time></p>
              <h2><a href="{{ featured_article.url }}">{{ featured_article.title | escape }}</a></h2>
              <p>{{ featured_article.excerpt_or_content | strip_html | truncatewords: 34 }}</p>
              <a class="tw-blog-card__link" href="{{ featured_article.url }}">Read featured article<span class="visually-hidden">: {{ featured_article.title | escape }}</span></a>
            </div>
          </article>
          {%- if blog.articles.size > 1 -%}
            <div class="tw-blog-featured__secondary" aria-label="More highlighted articles">
              {%- for article in blog.articles offset: 1 limit: 3 -%}{%- render 'blog-card', article: article, heading_level: 'h3', show_excerpt: false, image_fit: image_fit -%}{%- endfor -%}
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- liquid
        assign article_offset = 0
        if paginate.current_page == 1 and current_tag == blank
          assign article_offset = 4
        endif
      -%}
      <div class="tw-blog__recent-heading"><h2>{% if current_tag != blank %}Tagged articles{% else %}Latest from the blog{% endif %}</h2></div>
      <div class="tw-blog-grid">
        {%- for article in blog.articles offset: article_offset -%}
          {%- render 'blog-card', article: article, heading_level: 'h3', show_excerpt: true, image_fit: image_fit -%}
        {%- else -%}<p>No articles were found.</p>{%- endfor -%}
      </div>

      {%- if paginate.pages > 1 -%}
        <nav class="tw-blog-pagination" aria-label="Blog pagination">
          {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}" rel="prev">Previous</a>{%- endif -%}
          <span>Page {{ paginate.current_page }} of {{ paginate.pages }}</span>
          {%- if paginate.next -%}<a href="{{ paginate.next.url }}" rel="next">Next</a>{%- endif -%}
        </nav>
      {%- endif -%}
    </div>
  {%- endpaginate -%}
</section>

{% schema %}
{
  "name": "Main blog",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Stories from Typewriters.com" },
    { "type": "richtext", "id": "introduction", "label": "Introduction", "default": "<p>Practical advice, typewriter history, and stories from people who still believe the right machine can change the way you write.</p>" },
    { "type": "select", "id": "card_image_fit", "label": "Card image treatment", "default": "contain", "options": [{ "value": "contain", "label": "Show the full image" }, { "value": "cover", "label": "Fill and crop" }] },
    { "type": "range", "id": "articles_per_page", "label": "Articles per page", "min": 8, "max": 24, "step": 4, "default": 12 }
  ]
}
{% endschema %}
