{{ 'section-main-blog.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign articles_per_page = section.settings.articles_per_page | default: 18
  assign current_tag = current_tags | first
-%}

{%- paginate blog.articles by articles_per_page -%}
  <div class="blog-page page-width">
    <header class="blog-page__header">
      <p class="blog-page__eyebrow">Monroe Systems for Business</p>
      <h1 class="blog-page__title">
        {%- if current_tag -%}
          {{ current_tag | escape }}
        {%- else -%}
          {{ blog.title | escape }}
        {%- endif -%}
      </h1>
      {%- if section.settings.intro != blank -%}
        <div class="blog-page__intro rte">{{ section.settings.intro }}</div>
      {%- endif -%}
    </header>

    {%- if paginate.current_page == 1 and current_tag == blank and blog.articles.size > 0 -%}
      <section class="blog-featured" aria-labelledby="featured-posts-heading">
        <div class="blog-section-heading">
          <h2 id="featured-posts-heading">{{ section.settings.featured_heading | default: 'Featured Posts' | escape }}</h2>
        </div>

        {%- assign featured_article = blog.articles.first -%}
        <article class="blog-featured__hero">
          <a href="{{ featured_article.url }}" class="blog-featured__hero-image" aria-label="Read {{ featured_article.title | escape }}">
            {%- if featured_article.image != blank -%}
              {{ featured_article.image | image_url: width: 1664 | image_tag:
                loading: 'eager',
                fetchpriority: 'high',
                widths: '416, 624, 832, 1248, 1664',
                sizes: '(min-width: 1200px) 832px, (min-width: 990px) 62vw, 100vw',
                alt: featured_article.image.alt | default: featured_article.title
              }}
            {%- else -%}
              <span class="blog-image-placeholder" aria-hidden="true"></span>
            {%- endif -%}
          </a>

          <div class="blog-featured__hero-body">
            <div class="blog-meta">
              <span class="blog-meta__author">
                {%- render 'icon-blog-book' -%}
                {{ featured_article.author | escape }}
              </span>
              <time class="blog-meta__date" datetime="{{ featured_article.published_at | date: '%Y-%m-%d' }}">
                {{ featured_article.published_at | date: '%b %d, %Y' }}
              </time>
            </div>
            <h2 class="blog-featured__hero-title">
              <a href="{{ featured_article.url }}">{{ featured_article.title | escape }}</a>
            </h2>
            <p class="blog-featured__excerpt">
              {{ featured_article.excerpt_or_content | strip_html | truncatewords: 30 }}
            </p>
            <a href="{{ featured_article.url }}" class="blog-read-more" aria-label="Read {{ featured_article.title | escape }}">
              Read article <span aria-hidden="true">→</span>
            </a>
          </div>
        </article>

        {%- if blog.articles.size > 1 -%}
          <div class="blog-featured__cards">
            {%- for article in blog.articles offset: 1 limit: 4 -%}
              {%- render 'blog-card', article: article -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </section>
    {%- endif -%}

    <section class="blog-recent" aria-labelledby="recent-posts-heading">
      <div class="blog-section-heading">
        <h2 id="recent-posts-heading">
          {%- if current_tag -%}
            Posts tagged “{{ current_tag | escape }}”
          {%- else -%}
            {{ section.settings.recent_heading | default: 'Recent Posts' | escape }}
          {%- endif -%}
        </h2>
        <span class="blog-section-heading__count">{{ blog.articles_count }} articles</span>
      </div>

      {%- liquid
        if paginate.current_page == 1 and current_tag == blank
          assign grid_offset = 5
        else
          assign grid_offset = 0
        endif
      -%}

      <div class="blog-recent__grid">
        {%- for article in blog.articles offset: grid_offset -%}
          {%- render 'blog-card', article: article -%}
        {%- else -%}
          <p class="blog-recent__empty">No articles are available yet.</p>
        {%- endfor -%}
      </div>

      {%- if paginate.pages > 1 -%}
        <nav class="blog-pagination" role="navigation" aria-label="Blog pagination">
          {%- if paginate.previous -%}
            <a href="{{ paginate.previous.url }}" class="blog-pagination__arrow" aria-label="Previous page">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
            </a>
          {%- endif -%}

          {%- for part in paginate.parts -%}
            {%- if part.is_link -%}
              <a href="{{ part.url }}" class="blog-pagination__page">{{ part.title }}</a>
            {%- elsif part.title == paginate.current_page -%}
              <span class="blog-pagination__page blog-pagination__page--current" aria-current="page">{{ part.title }}</span>
            {%- else -%}
              <span class="blog-pagination__ellipsis">{{ part.title }}</span>
            {%- endif -%}
          {%- endfor -%}

          {%- if paginate.next -%}
            <a href="{{ paginate.next.url }}" class="blog-pagination__arrow" aria-label="Next page">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18l6-6-6-6"/></svg>
            </a>
          {%- endif -%}
        </nav>
      {%- endif -%}
    </section>
  </div>
{%- endpaginate -%}

{% schema %}
{
  "name": "Blog Page",
  "tag": "section",
  "settings": [
    {
      "type": "richtext",
      "id": "intro",
      "label": "Blog introduction",
      "default": "<p>Practical guidance for accountants, bookkeepers, finance teams, and offices that rely on accurate business tools.</p>"
    },
    {
      "type": "text",
      "id": "featured_heading",
      "label": "Featured heading",
      "default": "Featured Posts"
    },
    {
      "type": "text",
      "id": "recent_heading",
      "label": "Recent heading",
      "default": "Recent Posts"
    },
    {
      "type": "range",
      "id": "articles_per_page",
      "min": 9,
      "max": 24,
      "step": 3,
      "default": 18,
      "label": "Articles per page"
    }
  ]
}
{% endschema %}
