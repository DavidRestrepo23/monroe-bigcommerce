<style>
  .ms-team {
    font-family: Roboto, Arial, sans-serif;
    color: #000000;
    font-size: 18px;
    line-height: 1.65;
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 18px 36px;
  }

  .ms-team * {
    box-sizing: border-box;
  }

  .ms-team__bar {
    height: 35px;
    background: #007681;
    width: 100%;
    margin: 0 0 28px;
  }

  .ms-team__bar--bottom {
    margin: 34px 0 0;
  }

  .ms-team h2 {
    font-family: Roboto, Arial, sans-serif;
    color: #000000;
    font-size: 40px;
    line-height: 1.15;
    text-align: center;
    margin: 0 0 14px;
    text-decoration: none;
  }

  .ms-team h3 {
    font-family: Roboto, Arial, sans-serif;
    color: #000000;
    font-size: 25px;
    line-height: 1.25;
    margin: 0;
    text-decoration: none;
  }

  .ms-team h4 {
    font-family: Roboto, Arial, sans-serif;
    color: #000000;
    font-size: 20px;
    line-height: 1.35;
    margin: 0;
    text-decoration: none;
  }

  .ms-team p,
  .ms-team li,
  .ms-team a,
  .ms-team span {
    font-family: Roboto, Arial, sans-serif;
    font-size: 18px;
    color: #000000;
  }

  .ms-team a {
    color: #007681;
    font-weight: 700;
    text-decoration: none;
  }

  .ms-team a:hover,
  .ms-team a:focus {
    text-decoration: underline;
  }

  .ms-team__intro {
    text-align: center;
    max-width: 900px;
    margin: 0 auto 30px;
  }

  .ms-team__eyebrow {
    display: inline-block;
    color: #007681;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 14px;
    margin-bottom: 10px;
  }

  .ms-team__intro p {
    margin: 10px auto 0;
  }

  .ms-team__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 22px;
    margin: 28px 0 32px;
  }

  .ms-team__card {
    border: 1px solid rgba(0, 118, 129, 0.22);
    border-radius: 18px;
    padding: 24px 18px;
    text-align: center;
    background: #ffffff;
    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.07);
    transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
  }

  .ms-team__card:hover {
    transform: translateY(-3px);
    box-shadow: 0 16px 34px rgba(0, 0, 0, 0.11);
    border-color: rgba(0, 118, 129, 0.42);
  }

  .ms-team__photoLink,
  .ms-team__photoWrap {
    display: inline-block;
    width: 200px;
    height: 200px;
    margin: 0 auto 16px;
    border-radius: 50%;
  }

  .ms-team__photo {
    display: block;
    width: 200px;
    height: 200px;
    object-fit: cover;
    border-radius: 50%;
    border: 5px solid #007681;
    background: #ffffff;
  }

  .ms-team__name {
    margin: 0 0 6px;
  }

  .ms-team__name a,
  .ms-team__name span {
    color: #007681;
    font-size: 25px;
    font-weight: 800;
  }

  .ms-team__role {
    margin: 0;
    font-size: 20px;
    font-weight: 700;
    color: #000000;
  }

  .ms-team__support {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    margin: 28px 0 32px;
  }

  .ms-team__supportCard {
    background: rgba(0, 118, 129, 0.07);
    border: 1px solid rgba(0, 118, 129, 0.22);
    border-radius: 16px;
    padding: 18px;
  }

  .ms-team__supportCard h3 {
    color: #007681;
    font-size: 25px;
    margin-bottom: 8px;
  }

  .ms-team__supportCard p {
    margin: 0;
  }

  .ms-team__careers {
    border: 2px solid #007681;
    border-radius: 18px;
    padding: 24px 18px;
    text-align: center;
    background: #ffffff;
  }

  .ms-team__careers h3 {
    color: #000000;
    margin-bottom: 8px;
  }

  .ms-team__careers p {
    margin: 8px auto 0;
    max-width: 820px;
  }

  .ms-team__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: 16px;
    padding: 12px 20px;
    border: 5px solid #000000;
    background: #007681;
    color: #ffffff !important;
    font-weight: 900;
    text-decoration: none !important;
    border-radius: 999px;
    line-height: 1.15;
  }

  .ms-team__button:hover,
  .ms-team__button:focus {
    background: #005f68;
    text-decoration: none !important;
  }

  @media (max-width: 850px) {
    .ms-team__grid,
    .ms-team__support {
      grid-template-columns: 1fr;
    }

    .ms-team h2 {
      font-size: 34px;
    }
  }

  @media (max-width: 520px) {
    .ms-team {
      padding-left: 14px;
      padding-right: 14px;
    }

    .ms-team h2 {
      font-size: 30px;
    }

    .ms-team h3,
    .ms-team__name a,
    .ms-team__name span {
      font-size: 23px;
    }

    .ms-team__photoLink,
    .ms-team__photoWrap,
    .ms-team__photo {
      width: 170px;
      height: 170px;
    }
  }
</style>

