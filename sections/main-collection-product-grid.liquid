{{ 'template-collection.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #CollectionGrid-{{ section.id }} {
    --cg-columns: {{ section.settings.columns_desktop }};
    --cg-pad-top: {{ section.settings.padding_top }}px;
    --cg-pad-bottom: {{ section.settings.padding_bottom }}px;
    --cg-accent: {{ section.settings.accent_color }};
    --cg-accent-hover: {{ section.settings.accent_color | color_darken: 8 }};
  }
  @media (max-width: 749px) {
    #CollectionGrid-{{ section.id }} {
      --cg-columns: {{ section.settings.columns_mobile }};
    }
  }
{%- endstyle -%}

<section
  id="CollectionGrid-{{ section.id }}"
  class="collection-grid"
  data-collection-grid
  data-section-id="{{ section.id }}"
>
  <div class="collection-grid__container">
    <div class="collection-grid__layout{% unless section.settings.enable_filtering %} collection-grid__layout--no-sidebar{% endunless %}">
      {%- if section.settings.enable_filtering -%}
        <div class="collection-grid__sidebar">
          {%- render 'simple-facets', results: collection, heading: section.settings.filter_heading -%}
        </div>
      {%- endif -%}

      <div class="collection-grid__main">
    <div class="collection-grid__header">
      <div class="collection-grid__heading-wrap">
        <h1 class="collection-grid__heading">{{ collection.title | default: 'All Products' }}</h1>
        <span class="collection-grid__count">
          {{ 'sections.collection_template.items_count' | t: count: collection.products_count }}
        </span>
      </div>

      <div class="collection-grid__controls">
        {%- if section.settings.show_search -%}
          <form action="{{ routes.search_url }}" method="get" role="search" class="collection-grid__search" data-collection-grid-search>
            <input type="hidden" name="type" value="product">
            <button type="submit" class="collection-grid__search-btn" aria-label="{{ 'general.search.search' | t }}">
              {%- render 'icon-search' -%}
            </button>
            <input
              type="search"
              name="q"
              placeholder="{{ 'general.search.placeholder' | t }}"
              aria-label="{{ 'general.search.search' | t }}"
              class="collection-grid__search-input"
              data-collection-grid-search-input
              autocomplete="off"
              spellcheck="false"
            >
            <button type="button" class="collection-grid__search-clear" aria-label="Clear" hidden data-collection-grid-search-clear>
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
              </svg>
            </button>
          </form>
        {%- endif -%}

        {%- if section.settings.enable_sorting -%}
          <form id="SortForm-{{ section.id }}" class="collection-grid__sort">
            <label for="SortBy-{{ section.id }}" class="collection-grid__sort-label">
              {{- 'products.facets.sort_by_label' | t -}}
            </label>
            {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
            <select
              name="sort_by"
              id="SortBy-{{ section.id }}"
              class="collection-grid__sort-select"
              onchange="this.form.submit()"
            >
              {%- for option in collection.sort_options -%}
                <option
                  value="{{ option.value | escape }}"
                  {% if option.value == sort_by %}
                    selected="selected"
                  {% endif %}
                >
                  {{ option.name | escape }}
                </option>
              {%- endfor -%}
            </select>
          </form>
        {%- endif -%}
      </div>
    </div>

    {%- paginate collection.products by section.settings.products_per_page -%}
      {%- if collection.products.size > 0 -%}
        <ul class="collection-grid__list list-unstyled" role="list">
          {%- for product in collection.products -%}
            {%- liquid
              assign show_badge = false
              assign badge_label = section.settings.badge_text
              if section.settings.badge_source == 'metafield'
                if product.metafields.custom.badge != blank
                  assign show_badge = true
                  assign badge_label = product.metafields.custom.badge
                endif
              elsif section.settings.badge_source == 'all'
                assign show_badge = true
              endif
            -%}
            <li class="collection-grid__item">
              {%- render 'product-card',
                product: product,
                show_badge: show_badge,
                badge_label: badge_label,
                cart_label: section.settings.cart_label
              -%}
            </li>
          {%- endfor -%}
        </ul>

        <p class="collection-grid__filter-empty" hidden data-collection-grid-filter-empty>
          No products match <strong data-collection-grid-filter-term></strong> on this page.
        </p>

        {%- if paginate.pages > 1 -%}
          <nav class="collection-grid__pagination" role="navigation" aria-label="{{ 'general.pagination.label' | t }}">
            <ul class="collection-grid__pagination-list list-unstyled" role="list">
              {%- if paginate.previous -%}
                <li>
                  <a
                    href="{{ paginate.previous.url }}"
                    class="collection-grid__pagination-arrow"
                    aria-label="{{ 'general.pagination.previous' | t }}"
                  >
                    &lsaquo;
                  </a>
                </li>
              {%- endif -%}

              {%- for part in paginate.parts -%}
                <li>
                  {%- if part.is_link -%}
                    <a
                      href="{{ part.url }}"
                      class="collection-grid__pagination-item"
                      aria-label="{{ 'general.pagination.page' | t: number: part.title }}"
                    >
                      {{- part.title -}}
                    </a>
                  {%- else -%}
                    {%- if part.title == paginate.current_page -%}
                      <span
                        class="collection-grid__pagination-item collection-grid__pagination-item--current"
                        aria-current="page"
                      >
                        {{- part.title -}}
                      </span>
                    {%- else -%}
                      <span class="collection-grid__pagination-item collection-grid__pagination-item--disabled">
                        {{- part.title -}}
                      </span>
                    {%- endif -%}
                  {%- endif -%}
                </li>
              {%- endfor -%}

              {%- if paginate.next -%}
                <li>
                  <a
                    href="{{ paginate.next.url }}"
                    class="collection-grid__pagination-arrow"
                    aria-label="{{ 'general.pagination.next' | t }}"
                  >
                    &rsaquo;
                  </a>
                </li>
              {%- endif -%}
            </ul>
          </nav>
        {%- endif -%}
      {%- else -%}
        <p class="collection-grid__empty">{{ 'sections.collection_template.empty' | t }}</p>
      {%- endif -%}
    {%- endpaginate -%}
      </div>
    </div>
  </div>
  <div class="collection-grid__loading" hidden></div>
</section>

<script>
  (function () {
    if (window.__collectionGridInit) return;
    window.__collectionGridInit = true;

    var inflight = null;

    function getRoot() {
      return document.querySelector('[data-collection-grid]');
    }

    function fmtMoney(v) {
      return '$' + parseFloat(v).toFixed(2);
    }

    function paintSlider(slider) {
      if (!slider) return;
      var max = parseFloat(slider.dataset.max) || 1;
      var minInput = slider.querySelector('[data-role="min"]');
      var maxInput = slider.querySelector('[data-role="max"]');
      var fill = slider.querySelector('.simple-facets__price-fill');
      var minLabel = slider.querySelector('.simple-facets__price-label--min');
      var maxLabel = slider.querySelector('.simple-facets__price-label--max');
      var gte = slider.querySelector('[data-role="gte"]');
      var lte = slider.querySelector('[data-role="lte"]');
      var lo = Math.min(parseFloat(minInput.value), parseFloat(maxInput.value));
      var hi = Math.max(parseFloat(minInput.value), parseFloat(maxInput.value));
      fill.style.left = (lo / max * 100) + '%';
      fill.style.right = (100 - hi / max * 100) + '%';
      minLabel.textContent = fmtMoney(lo);
      maxLabel.textContent = fmtMoney(hi);
      gte.value = lo > 0 ? lo : '';
      lte.value = hi < max ? hi : '';
    }

    function buildUrlFromForm(form, extraParams) {
      var params = new URLSearchParams();
      var data = new FormData(form);
      data.forEach(function (val, key) {
        if (val !== '' && val !== null) params.append(key, val);
      });
      if (extraParams) {
        Object.keys(extraParams).forEach(function (k) {
          params.set(k, extraParams[k]);
        });
      }
      return window.location.pathname + '?' + params.toString();
    }

    function urlWithSortReplaced(sortValue) {
      var params = new URLSearchParams(window.location.search);
      if (sortValue) params.set('sort_by', sortValue);
      else params.delete('sort_by');
      params.delete('page');
      return window.location.pathname + '?' + params.toString();
    }

    function loadSection(url, opts) {
      opts = opts || {};
      var root = getRoot();
      if (!root) return;
      var sectionId = root.dataset.sectionId;

      if (inflight) inflight.abort();
      var ctrl = new AbortController();
      inflight = ctrl;

      root.classList.add('collection-grid--loading');

      var sep = url.indexOf('?') === -1 ? '?' : '&';
      var fetchUrl = url + sep + 'section_id=' + encodeURIComponent(sectionId);

      fetch(fetchUrl, { signal: ctrl.signal })
        .then(function (r) { return r.text(); })
        .then(function (html) {
          var doc = new DOMParser().parseFromString(html, 'text/html');
          var fresh = doc.querySelector('[data-collection-grid]');
          if (!fresh) return;
          var current = getRoot();
          current.replaceWith(fresh);
          if (opts.scroll !== false) {
            fresh.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
          if (!opts.skipPushState) {
            window.history.pushState({ collectionGrid: true }, '', url);
          }
        })
        .catch(function (e) {
          if (e.name !== 'AbortError') console.error(e);
        })
        .finally(function () {
          var r = getRoot();
          if (r) r.classList.remove('collection-grid--loading');
          inflight = null;
        });
    }

    document.addEventListener('input', function (e) {
      var slider = e.target.closest && e.target.closest('.simple-facets__price-slider');
      if (!slider) return;
      if (e.target.matches('input[type="range"]')) paintSlider(slider);
    });

    document.addEventListener('change', function (e) {
      var root = getRoot();
      if (!root || !root.contains(e.target)) return;

      if (e.target.matches('.simple-facets__form input[type="checkbox"]')) {
        var form = e.target.closest('form');
        loadSection(buildUrlFromForm(form));
        return;
      }

      if (e.target.matches('.simple-facets__price-input')) {
        var slider = e.target.closest('.simple-facets__price-slider');
        paintSlider(slider);
        var form = e.target.closest('form');
        loadSection(buildUrlFromForm(form));
        return;
      }

      if (e.target.matches('.collection-grid__sort-select')) {
        loadSection(urlWithSortReplaced(e.target.value));
        return;
      }
    });

    document.addEventListener('submit', function (e) {
      var root = getRoot();
      if (!root || !root.contains(e.target)) return;
      if (e.target.matches('.simple-facets__form')) {
        e.preventDefault();
        loadSection(buildUrlFromForm(e.target));
      }
    });

    document.addEventListener('click', function (e) {
      if (e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0) return;
      var root = getRoot();
      if (!root) return;
      var link = e.target.closest('a');
      if (!link || !root.contains(link)) return;

      var isPagination = link.closest('.collection-grid__pagination');
      var isPill = link.classList.contains('simple-facets__pill');
      var isClear = link.classList.contains('simple-facets__clear');

      if (isPagination || isPill || isClear) {
        e.preventDefault();
        loadSection(link.getAttribute('href'));
      }
    });

    window.addEventListener('popstate', function () {
      loadSection(window.location.pathname + window.location.search, { skipPushState: true, scroll: false });
    });

    /* ---------- Client-side grid filter ---------- */
    var filterDebounce = null;

    function applyGridFilter(term) {
      var root = getRoot();
      if (!root) return;
      var items = root.querySelectorAll('.collection-grid__item');
      var pagination = root.querySelector('.collection-grid__pagination');
      var emptyMsg = root.querySelector('[data-collection-grid-filter-empty]');
      var emptyTerm = root.querySelector('[data-collection-grid-filter-term]');
      var visibleCount = 0;
      var normalized = term.trim().toLowerCase();

      items.forEach(function (item) {
        if (!normalized) {
          item.hidden = false;
          visibleCount++;
          return;
        }
        var titleEl = item.querySelector('.product-card__title');
        var text = (titleEl ? titleEl.textContent : '').toLowerCase();
        var match = text.indexOf(normalized) !== -1;
        item.hidden = !match;
        if (match) visibleCount++;
      });

      if (emptyMsg) {
        if (normalized && visibleCount === 0) {
          emptyMsg.hidden = false;
          if (emptyTerm) emptyTerm.textContent = '"' + term + '"';
        } else {
          emptyMsg.hidden = true;
        }
      }

      if (pagination) pagination.hidden = !!normalized;
      root.classList.toggle('collection-grid--filtering', !!normalized);
    }

    document.addEventListener('input', function (e) {
      if (!e.target.matches('[data-collection-grid-search-input]')) return;
      var input = e.target;
      var clearBtn = input.parentElement.querySelector('[data-collection-grid-search-clear]');
      if (clearBtn) clearBtn.hidden = input.value.length === 0;
      clearTimeout(filterDebounce);
      filterDebounce = setTimeout(function () {
        applyGridFilter(input.value);
      }, 80);
    });

    document.addEventListener('click', function (e) {
      var clearBtn = e.target.closest('[data-collection-grid-search-clear]');
      if (!clearBtn) return;
      var input = clearBtn.parentElement.querySelector('[data-collection-grid-search-input]');
      if (input) {
        input.value = '';
        clearBtn.hidden = true;
        applyGridFilter('');
        input.focus();
      }
    });

    document.addEventListener('submit', function (e) {
      if (!e.target.matches('[data-collection-grid-search]')) return;
      e.preventDefault();
    });

    document.addEventListener('keydown', function (e) {
      if (e.key !== 'Escape') return;
      if (!e.target.matches('[data-collection-grid-search-input]')) return;
      e.target.value = '';
      var clearBtn = e.target.parentElement.querySelector('[data-collection-grid-search-clear]');
      if (clearBtn) clearBtn.hidden = true;
      applyGridFilter('');
    });
  })();
</script>

{% schema %}
{
  "name": "Product grid",
  "class": "section-collection-grid page-width",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "min": 4,
      "max": 48,
      "step": 2,
      "default": 12,
      "label": "Products per page"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 3,
      "label": "Columns on desktop"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "options": [
        { "value": "1", "label": "1 column" },
        { "value": "2", "label": "2 columns" }
      ],
      "default": "2",
      "label": "Columns on mobile"
    },
    {
      "type": "checkbox",
      "id": "enable_sorting",
      "default": true,
      "label": "Enable sorting"
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "default": true,
      "label": "Show search input"
    },
    {
      "type": "header",
      "content": "Filters"
    },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "default": true,
      "label": "Enable filtering sidebar"
    },
    {
      "type": "text",
      "id": "filter_heading",
      "default": "Refine By",
      "label": "Sidebar heading"
    },
    {
      "type": "header",
      "content": "Badge"
    },
    {
      "type": "select",
      "id": "badge_source",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "all", "label": "Show on all products" },
        { "value": "metafield", "label": "From product metafield (custom.badge)" }
      ],
      "default": "none",
      "label": "Badge source"
    },
    {
      "type": "text",
      "id": "badge_text",
      "default": "Top Seller",
      "label": "Default badge text"
    },
    {
      "type": "header",
      "content": "Cart button"
    },
    {
      "type": "text",
      "id": "cart_label",
      "default": "Cart",
      "label": "Cart button label"
    },
    {
      "type": "color",
      "id": "accent_color",
      "default": "#1F7A7A",
      "label": "Accent color"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36,
      "label": "Padding top"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36,
      "label": "Padding bottom"
    }
  ],
  "presets": [
    {
      "name": "Product grid"
    }
  ],
  "enabled_on": {
    "templates": ["collection"]
  }
}
{% endschema %}
