      <div class="msf-seo-faq" id="toner-finder-faq">
        <h3 class="msf-seo-title">Toner Compatibility FAQs</h3>

        <details class="msf-seo-qa">
          <summary>Why might my toner not show up in the Finder?</summary>
          <div class="msf-seo-answer">
            Some listings share multiple part numbers, some models have regional variations, and availability can change. If you do not see it, email or call us with your printer model and toner part number.
          </div>
        </details>

        <details class="msf-seo-qa">
          <summary>What information should I send for the fastest match?</summary>
          <div class="msf-seo-answer">
            Send your printer brand and exact model, the toner part number from the box or label, and your preferred color and yield.
          </div>
        </details>

        <details class="msf-seo-qa">
          <summary>Can you help me choose between standard and high yield?</summary>
          <div class="msf-seo-answer">
            Yes. Share your approximate monthly print volume, and we will recommend the best value option.
          </div>
        </details>

        <details class="msf-seo-qa">
          <summary>How accurate is the compatibility chart?</summary>
          <div class="msf-seo-answer">
            The chart is generated from our published toner list. For edge cases and uncommon sub-models, we can verify compatibility before you buy.
          </div>
        </details>
      </div>

    </div>

    <noscript>
      <div class="msf-card">
        <h2 class="msf-h2">JavaScript Required</h2>
        <p class="msf-muted">
          This Finder requires JavaScript to load toner data and display results. If you need help, call (267) 580-2600 or email sales@monroe-systems.com.
        </p>
      </div>
    </noscript>

  </div>
</section>

<script>
(function(){
  'use strict';

  function onReady(fn){
    if(document.readyState === 'loading'){
      document.addEventListener('DOMContentLoaded', fn);
    }else{
      fn();
    }
  }

  onReady(function(){
    document.querySelectorAll('.ms-hd').forEach(function(root){
      var table = root.querySelector('#ms-hd-table');
      if(!table) return;

      var selected = [];
      var modelData = {
        '1': { name:'Monroe ClassicX', speed:92, features:82, workload:90 },
        '2': { name:'Monroe UltimateX', speed:92, features:96, workload:94 },
        '3': { name:'Monroe 8145X', speed:92, features:76, workload:93 },
        '4': { name:'Monroe 8130X', speed:92, features:68, workload:86 }
      };

      function q(sel){ return root.querySelector(sel); }
      function qa(sel){ return Array.prototype.slice.call(root.querySelectorAll(sel)); }

      function setRows(section, show){
        qa('[data-section="' + section + '"]').forEach(function(row){
          row.classList.toggle('ms-hd__isHidden', !show);
        });
      }

      function setBenchmark(col){
        var data = modelData[col];
        var fills = {
          speed: q('[data-bench="monroe-speed"]'),
          features: q('[data-bench="monroe-features"]'),
          workload: q('[data-bench="monroe-workload"]')
        };
        var texts = {
          speed: q('[data-bench-text="speed"]'),
          features: q('[data-bench-text="features"]'),
          workload: q('[data-bench-text="workload"]')
        };

        if(!data){
          Object.keys(fills).forEach(function(k){ if(fills[k]) fills[k].style.width = '0%'; });
          Object.keys(texts).forEach(function(k){ if(texts[k]) texts[k].textContent = 'Select a model to see a comparison.'; });
          return;
        }

        if(fills.speed) fills.speed.style.width = data.speed + '%';
        if(fills.features) fills.features.style.width = data.features + '%';
        if(fills.workload) fills.workload.style.width = data.workload + '%';

        if(texts.speed) texts.speed.textContent = data.name + ' print speed index: ' + data.speed + ' vs category benchmark 60.';
        if(texts.features) texts.features.textContent = data.name + ' feature depth index: ' + data.features + ' vs category benchmark 50.';
        if(texts.workload) texts.workload.textContent = data.name + ' workload readiness index: ' + data.workload + ' vs category benchmark 55.';
      }

      function updateTray(){
        var tray = q('.ms-hd__tray');
        var viewBtn = q('[data-action="view"]');
        if(!tray) return;

        tray.hidden = selected.length === 0;

        for(var i=0; i<2; i++){
          var slot = q('[data-slot="' + i + '"]');
          if(!slot) continue;
          var nameEl = slot.querySelector('.ms-hd__trayName');
          var remove = slot.querySelector('.ms-hd__trayRemove');
          var col = selected[i];
          if(nameEl) nameEl.textContent = col && modelData[col] ? modelData[col].name : 'None selected';
          if(remove) remove.style.visibility = col ? 'visible' : 'hidden';
        }

        if(viewBtn) viewBtn.disabled = selected.length === 0;
        setBenchmark(selected[0]);
      }

      function syncChecks(){
        qa('[data-pick]').forEach(function(input){
          input.checked = selected.indexOf(input.getAttribute('data-pick')) !== -1;
        });
      }

      function cellText(cell){
        return cell ? cell.textContent.replace(/\s+/g, ' ').trim() : '';
      }

      function buildCompareCard(col){
        var modelName = modelData[col] ? modelData[col].name : 'Selected model';
        var html = '<article class="ms-hd__compareCard"><h3 class="ms-hd__compareTitle">' + modelName + '</h3><ul class="ms-hd__compareList">';

        qa('tbody tr').forEach(function(row){
          if(row.classList.contains('ms-hd__sectionRow')) return;
          var key = cellText(row.querySelector('.ms-hd__rowLabel'));
          var val = cellText(row.querySelector('[data-col="' + col + '"]'));
          if(key && val){
            html += '<li><span class="ms-hd__compareKey">' + escapeHtml(key) + '</span><span class="ms-hd__compareVal">' + escapeHtml(val) + '</span></li>';
          }
        });

        html += '</ul></article>';
        return html;
      }

      function escapeHtml(s){
        return String(s || '').replace(/[&<>"']/g, function(ch){
          return ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;' })[ch];
        });
      }

      function openModal(){
        var modal = q('.ms-hd__modal');
        var grid = q('.ms-hd__modalGrid');
        if(!modal || !grid || selected.length === 0) return;
        grid.innerHTML = selected.map(buildCompareCard).join('');
        modal.hidden = false;
        document.documentElement.style.overflow = 'hidden';
        var close = modal.querySelector('.ms-hd__modalClose');
        if(close) close.focus();
      }

      function closeModal(){
        var modal = q('.ms-hd__modal');
        if(!modal) return;
        modal.hidden = true;
        document.documentElement.style.overflow = '';
      }

      root.addEventListener('click', function(e){
        var btn = e.target.closest('[data-action]');
        if(btn && root.contains(btn)){
          var action = btn.getAttribute('data-action');
          if(action === 'toggle-functions'){
            var pressed = btn.getAttribute('aria-pressed') === 'true';
            btn.setAttribute('aria-pressed', String(!pressed));
            setRows('functions', !pressed);
          }
          if(action === 'toggle-specs'){
            var pressed2 = btn.getAttribute('aria-pressed') === 'true';
            btn.setAttribute('aria-pressed', String(!pressed2));
            setRows('specs', !pressed2);
          }
          if(action === 'view') openModal();
          if(action === 'clear'){
            selected = [];
            syncChecks();
            updateTray();
          }
        }

        var remove = e.target.closest('[data-remove]');
        if(remove && root.contains(remove)){
          var idx = parseInt(remove.getAttribute('data-remove'), 10);
          selected.splice(idx, 1);
          syncChecks();
          updateTray();
        }

        var close = e.target.closest('[data-close]');
        if(close && root.contains(close)) closeModal();
      });

      root.addEventListener('change', function(e){
        var input = e.target.closest('[data-pick]');
        if(!input) return;
        var col = input.getAttribute('data-pick');
        var exists = selected.indexOf(col);

        if(input.checked){
          if(exists === -1){
            if(selected.length >= 2){
              input.checked = false;
              alert('You can compare up to two models at a time.');
              return;
            }
            selected.push(col);
          }
        }else if(exists !== -1){
          selected.splice(exists, 1);
        }

        updateTray();
      });

      document.addEventListener('keydown', function(e){
        if(e.key === 'Escape') closeModal();
      });

      updateTray();
    });
  });
})();
</script>

