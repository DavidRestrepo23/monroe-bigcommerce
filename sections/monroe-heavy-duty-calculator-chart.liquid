        <tr data-section="functions">
          <th class="ms-hd__rowLabel" scope="row">Financial and time calculations</th>
          <td data-col="1">Standard</td><td data-col="2">Standard</td><td data-col="3">Not Available</td><td data-col="4">Not Available</td>
        </tr>

        <tr data-section="functions">
          <th class="ms-hd__rowLabel" scope="row">Reprint and editing capability</th>
          <td data-col="1">Not Available</td><td data-col="2">Standard</td><td data-col="3">Not Available</td><td data-col="4">Not Available</td>
        </tr>

        <tr class="ms-hd__sectionRow" data-section="specs">
          <th scope="rowgroup" colspan="5">Specifications</th>
        </tr>

        <tr data-section="specs">
          <th class="ms-hd__rowLabel" scope="row">Digits</th>
          <td data-col="1">12</td><td data-col="2">12</td><td data-col="3">14</td><td data-col="4">12</td>
