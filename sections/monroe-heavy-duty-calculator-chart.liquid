<!-- Monroe Heavy-Duty Calculator Chart Shopify Section
  File: sections/monroe-heavy-duty-calculator-chart.liquid
-->
<style>
  .ms-hd, .ms-hd *{
    box-sizing:border-box;
  }

  .ms-hd{
    --ms-hd-teal:#007681;
    --ms-hd-gray:#666666;
    --ms-hd-black:#000000;
    --ms-hd-text:#0b1b1c;
    --ms-hd-muted:rgba(0,0,0,.68);
    --ms-hd-soft:rgba(0,118,129,.08);
    --ms-hd-border:rgba(0,0,0,.18);
    --ms-hd-shadow:0 14px 34px rgba(0,0,0,.10);
    --ms-hd-radius:18px;
    width:100%;
    max-width:1240px;
    margin:0 auto;
    padding:24px 16px 56px;
    color:var(--ms-hd-text);
    font-family:inherit;
    font-size:16px;
    line-height:1.5;
  }

  .ms-hd__bar{
    height:24px;
    background:var(--ms-hd-teal);
    border-radius:999px;
    margin:16px 0 22px;
  }

  .ms-hd__intro{
    max-width:980px;
    margin:0 auto 18px;
    text-align:center;
    font-size:18px;
    color:var(--ms-hd-text);
  }

  .ms-hd__intro p{ margin:0 0 10px; }

  .ms-hd__title{
    margin:0 0 22px;
    text-align:center;
    font-size:clamp(28px, 4vw, 44px);
    line-height:1.1;
    text-decoration:underline;
    text-underline-offset:8px;
    color:#000;
  }

  .ms-hd__link{
    color:var(--ms-hd-teal);
    font-weight:800;
    text-decoration:underline;
    text-underline-offset:3px;
  }

  .ms-hd__controls,
  .ms-hd__tray,
  .ms-hd__wrap{
    border:1px solid var(--ms-hd-border);
    border-radius:var(--ms-hd-radius);
    background:#fff;
    box-shadow:var(--ms-hd-shadow);
    margin:18px 0;
  }

  .ms-hd__controls{ padding:18px; }

  .ms-hd__controlsTop{
    display:flex;
    justify-content:space-between;
    gap:18px;
    align-items:flex-start;
    margin-bottom:16px;
  }

  .ms-hd__controlsTitle,
  .ms-hd__benchTitle,
  .ms-hd__trayTitle{
    margin:0 0 6px;
    font-weight:900;
    font-size:20px;
    color:#000;
  }

  .ms-hd__controlsHint,
  .ms-hd__benchNote,
  .ms-hd__benchVisualText{
    margin:0;
    color:var(--ms-hd-muted);
  }

  .ms-hd__btnRow,
  .ms-hd__trayActions{
    display:flex;
    flex-wrap:wrap;
    gap:10px;
    justify-content:flex-end;
  }

  .ms-hd__btn,
  .ms-hd__modalClose,
  .ms-hd__trayRemove{
    appearance:none;
    border:5px solid #000;
    border-radius:14px;
    background:#fff;
    color:#000;
    min-height:44px;
    padding:8px 14px;
    font-weight:900;
    cursor:pointer;
    font-family:inherit;
    line-height:1.1;
  }

  .ms-hd__btn:hover,
  .ms-hd__modalClose:hover,
  .ms-hd__trayRemove:hover{
    box-shadow:0 0 0 3px rgba(0,118,129,.18);
  }

  .ms-hd__btn[aria-pressed="true"],
  .ms-hd__btn:not([disabled])[data-action="view"]{
    background:var(--ms-hd-teal);
    color:#fff;
  }

  .ms-hd__btn[disabled]{
    opacity:.5;
    cursor:not-allowed;
    box-shadow:none;
  }

  .ms-hd__bench{
    border:1px solid rgba(0,0,0,.12);
    border-radius:16px;
    background:var(--ms-hd-soft);
    padding:16px;
  }

  .ms-hd__benchTop{
    display:flex;
    justify-content:space-between;
    gap:14px;
    align-items:flex-start;
    margin-bottom:14px;
  }

  .ms-hd__benchGrid{
    display:grid;
    grid-template-columns:1.1fr repeat(3, 1fr);
    gap:14px;
  }

  .ms-hd__benchVisual,
  .ms-hd__benchCard{
    border:1px solid rgba(0,0,0,.12);
    border-radius:14px;
    background:#fff;
    padding:14px;
  }

  .ms-hd__benchIcon{
    width:58px;
    height:58px;
    border-radius:999px;
    background:rgba(0,0,0,.08);
    display:flex;
    align-items:center;
    justify-content:center;
    margin-bottom:10px;
  }

  .ms-hd__benchLabel{
    margin:0 0 10px;
    font-weight:900;
    color:#000;
  }

  .ms-hd__benchBar{
    height:13px;
    border-radius:999px;
    overflow:hidden;
    background:rgba(0,0,0,.10);
  }

  .ms-hd__benchFill{
    height:100%;
    width:0;
    background:var(--ms-hd-teal);
    border-radius:999px;
    transition:width 220ms ease;
  }

  .ms-hd__benchFill--comp{ background:rgba(0,0,0,.35); }

  .ms-hd__benchValue{
    margin:10px 0 0;
    color:var(--ms-hd-muted);
    font-weight:700;
  }

  .ms-hd__tray{ padding:14px; }
  .ms-hd__trayInner{ display:grid; grid-template-columns:auto 1fr auto; gap:16px; align-items:center; }
  .ms-hd__traySlots{ display:grid; grid-template-columns:repeat(2, minmax(0, 1fr)); gap:12px; }
  .ms-hd__traySlot{ border:1px solid rgba(0,0,0,.14); border-radius:14px; padding:12px; background:#fff; }
  .ms-hd__traySlotTop{ display:flex; justify-content:space-between; gap:10px; align-items:center; margin-bottom:6px; }
  .ms-hd__traySlotLabel{ font-weight:900; color:#000; }
  .ms-hd__trayName{ font-weight:800; color:var(--ms-hd-teal); }
  .ms-hd__trayRemove{ border-width:2px; min-height:32px; padding:6px 9px; font-size:13px; }

  .ms-hd__wrap{
    overflow:auto;
    -webkit-overflow-scrolling:touch;
  }

  .ms-hd__table{
    width:100%;
    min-width:980px;
    border-collapse:separate;
    border-spacing:0;
    font-size:16px;
  }

  .ms-hd__table th,
  .ms-hd__table td{
    border-right:1px solid rgba(0,0,0,.12);
    border-bottom:1px solid rgba(0,0,0,.12);
    padding:14px 12px;
    vertical-align:top;
    text-align:center;
  }

  .ms-hd__table thead th{
    position:sticky;
    top:0;
    z-index:2;
    background:#fff;
    color:#000;
  }

  .ms-hd__table thead th:first-child,
  .ms-hd__rowLabel{
    text-align:left;
  }

  .ms-hd__table thead th:first-child,
  .ms-hd__rowLabel,
  .ms-hd__sectionRow th{
    position:sticky;
    left:0;
    z-index:3;
    background:#fff;
  }

  .ms-hd__sectionRow th{
    background:var(--ms-hd-teal);
    color:#fff;
    text-align:left;
    font-size:20px;
    letter-spacing:.2px;
  }

  .ms-hd__rowLabel{
    width:260px;
    font-weight:900;
    color:#000;
  }

  .ms-hd__modelHead{
    min-width:180px;
  }

  .ms-hd__modelImg{
    min-height:185px;
    display:flex;
    align-items:center;
    justify-content:center;
    margin-bottom:10px;
  }

  .ms-hd__modelImg img{
    max-width:150px;
    height:auto;
    object-fit:contain;
  }

  .ms-hd__modelName{
    display:block;
    margin-bottom:10px;
    font-size:18px;
  }

  .ms-hd__pick{
    display:inline-flex;
    align-items:center;
    gap:8px;
    cursor:pointer;
    font-weight:900;
    color:#000;
  }

  .ms-hd__pick input{
    width:20px;
    height:20px;
    accent-color:var(--ms-hd-teal);
  }

  .ms-hd__isHidden{ display:none !important; }

  .ms-hd__modal[hidden],
  .ms-hd__tray[hidden]{ display:none !important; }

  .ms-hd__modal{
    position:fixed;
    inset:0;
    z-index:9999;
    display:flex;
    align-items:center;
    justify-content:center;
    padding:18px;
  }

  .ms-hd__modalBackdrop{
    position:absolute;
    inset:0;
    background:rgba(0,0,0,.55);
  }

  .ms-hd__modalPanel{
    position:relative;
    width:min(980px, 96vw);
    max-height:88vh;
    overflow:auto;
    background:#fff;
    border-radius:20px;
    box-shadow:0 22px 70px rgba(0,0,0,.32);
  }

  .ms-hd__modalHeader{
    position:sticky;
    top:0;
    display:flex;
    justify-content:space-between;
    gap:14px;
    align-items:center;
    padding:16px;
    background:#fff;
    border-bottom:1px solid rgba(0,0,0,.12);
    z-index:1;
  }

  .ms-hd__modalTitle{
    font-size:22px;
    line-height:1.2;
    font-weight:900;
    color:#000;
  }

  .ms-hd__modalBody{ padding:16px; }

  .ms-hd__modalGrid{
    display:grid;
    grid-template-columns:repeat(2, minmax(0, 1fr));
    gap:14px;
  }

  .ms-hd__compareCard{
    border:1px solid rgba(0,0,0,.14);
    border-radius:16px;
    overflow:hidden;
    background:#fff;
  }

  .ms-hd__compareTitle{
    margin:0;
    padding:14px;
    background:var(--ms-hd-teal);
    color:#fff;
    font-size:20px;
    font-weight:900;
  }

  .ms-hd__compareList{
    margin:0;
    padding:0;
    list-style:none;
  }

  .ms-hd__compareList li{
    display:grid;
    grid-template-columns:1.25fr 1fr;
    gap:10px;
    padding:10px 14px;
    border-bottom:1px solid rgba(0,0,0,.10);
  }

  .ms-hd__compareKey{ font-weight:900; color:#000; }
  .ms-hd__compareVal{ color:var(--ms-hd-text); }

  @media (max-width: 960px){
    .ms-hd__controlsTop,
    .ms-hd__benchTop,
    .ms-hd__trayInner{ grid-template-columns:1fr; display:grid; }
    .ms-hd__btnRow,
    .ms-hd__trayActions{ justify-content:flex-start; }
    .ms-hd__benchGrid{ grid-template-columns:1fr 1fr; }
  }

  @media (max-width: 640px){
    .ms-hd{ padding-left:12px; padding-right:12px; }
    .ms-hd__intro{ font-size:16px; }
    .ms-hd__controls{ padding:14px; }
    .ms-hd__benchGrid,
    .ms-hd__traySlots,
    .ms-hd__modalGrid{ grid-template-columns:1fr; }
    .ms-hd__table{ font-size:15px; }
    .ms-hd__rowLabel{ width:220px; }
    .ms-hd__modal{ padding:10px; }
  }
</style>

<!-- Monroe Toner Finder Tool | Final Combined HTML + CSS + JS -->
<section class="msf-tool" id="msfTool">

  <!-- Top Accent Bar -->
  <div class="msf-topbar" aria-hidden="true"></div>

