{{ 'section-heavy-duty-comparison.css' | asset_url | stylesheet_tag }}
<script src="{{ 'section-heavy-duty-comparison.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign primary_link = section.settings.primary_link | default: '/collections/heavy-duty-calculators'
  assign secondary_link = section.settings.secondary_link | default: '/pages/calculator-manuals'
-%}

<section
  id="HeavyDutyComparison-{{ section.id }}"
  class="hdc"
  data-hd-comparison
  style="
    --hdc-accent: {{ section.settings.accent_color }};
    --hdc-accent-dark: {{ section.settings.accent_dark }};
    --hdc-ink: {{ section.settings.text_color }};
    --hdc-surface: {{ section.settings.surface_color }};
    --hdc-soft: {{ section.settings.soft_color }};
  "
  aria-labelledby="HeavyDutyComparisonTitle-{{ section.id }}"
>
  <script type="application/json" data-hdc-data>
    {% render 'heavy-duty-comparison-data' %}
  </script>

  <div class="hdc__shell">
    <header class="hdc__hero">
      <div class="hdc__hero-copy">
        {%- if section.settings.eyebrow != blank -%}
          <p class="hdc__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}

        <h2 id="HeavyDutyComparisonTitle-{{ section.id }}" class="hdc__title">
          {{ section.settings.heading | escape }}
        </h2>

        <div class="hdc__intro rte">
          {{ section.settings.intro }}
        </div>

        <div class="hdc__hero-actions">
          <a class="hdc__button hdc__button--primary" href="#HeavyDutyFinder-{{ section.id }}">
            Find your model
          </a>
          <a class="hdc__button hdc__button--secondary" href="{{ primary_link }}">
            {{ section.settings.primary_label | escape }}
          </a>
        </div>

        <ul class="hdc__hero-points" role="list">
          <li><strong>4</strong><span>heavy-duty models</span></li>
          <li><strong>5.0</strong><span>lines per second</span></li>
          <li><strong>2</strong><span>models at a time</span></li>
        </ul>
      </div>

      <div class="hdc__hero-visual" aria-label="Heavy-duty calculator comparison overview">
        {%- if section.settings.hero_image != blank -%}
          {{ section.settings.hero_image
            | image_url: width: 1200
            | image_tag:
              class: 'hdc__hero-image',
              loading: 'eager',
              widths: '480, 720, 960, 1200',
              sizes: '(min-width: 990px) 42vw, 100vw',
              alt: section.settings.hero_image.alt | default: section.settings.heading
          }}
        {%- else -%}
          <div class="hdc__hero-stack hdc__hero-stack--products">
  <a
    class="hdc__hero-product hdc__hero-card--one"
    href="/products/monroe-classicx-12-digit-heavy-duty-printing-calculator"
    aria-label="View Monroe ClassicX"
  >
    <img
      src="https://cdn.shopify.com/s/files/1/0653/0262/6407/files/ClassicX_-_Calc_Classroom.png?v=1784053898"
      alt="Monroe ClassicX heavy-duty printing calculator"
      width="240"
      height="263"
      loading="eager"
    >
    <span>ClassicX</span>
  </a>

  <a
    class="hdc__hero-product hdc__hero-card--two"
    href="/products/monroe-ultimatex-12-digit-programmable-heavy-duty-accounting-printing-calculator-with-edit-reprint-capabilities"
    aria-label="View Monroe UltimateX"
  >
    <img
      src="https://cdn.shopify.com/s/files/1/0653/0262/6407/files/UltimateX_-_Calc_Classroom.png?v=1784053898"
      alt="Monroe UltimateX heavy-duty printing calculator"
      width="240"
      height="263"
      loading="eager"
    >
    <span>UltimateX</span>
  </a>

  <a
    class="hdc__hero-product hdc__hero-card--three"
    href="/products/monroe-8145x-14-digit-dual-memory-heavy-duty-accounting-printing-calculator"
    aria-label="View Monroe 8145X"
  >
    <img
      src="https://cdn.shopify.com/s/files/1/0653/0262/6407/files/8145X_-_Calc_Classroom.png?v=1784053898"
      alt="Monroe 8145X heavy-duty printing calculator"
      width="240"
      height="263"
      loading="eager"
    >
    <span>8145X</span>
  </a>

  <a
    class="hdc__hero-product hdc__hero-card--four"
    href="/products/monroe-8130x-12-digit-heavy-duty-accounting-printing-calculator"
    aria-label="View Monroe 8130X"
  >
    <img
      src="https://cdn.shopify.com/s/files/1/0653/0262/6407/files/8130x-black-modified-1.png?v=1782938567"
      alt="Monroe 8130X heavy-duty printing calculator"
      width="240"
      height="263"
      loading="eager"
    >
    <span>8130X</span>
  </a>
</div>
        {%- endif -%}
      </div>
    </header>

    <nav class="hdc__jump" aria-label="Comparison page sections">
      <a href="#HeavyDutyFinder-{{ section.id }}">Model finder</a>
      <a href="#HeavyDutyModels-{{ section.id }}">Model overview</a>
      <a href="#HeavyDutyChart-{{ section.id }}">Full comparison</a>
      <a href="#HeavyDutySupport-{{ section.id }}">Need help?</a>
    </nav>

    <section id="HeavyDutyFinder-{{ section.id }}" class="hdc__panel hdc__finder" aria-labelledby="HeavyDutyFinderTitle-{{ section.id }}">
      <div class="hdc__section-heading">
        <div>
          <p class="hdc__section-kicker">Guided selection</p>
          <h3 id="HeavyDutyFinderTitle-{{ section.id }}">What matters most in your workflow?</h3>
          <p>Choose a priority to highlight the models with the matching capability.</p>
        </div>
        <button class="hdc__text-button" type="button" data-hdc-reset-priority hidden>Reset recommendation</button>
      </div>

      <div class="hdc__priority-grid" role="group" aria-label="Choose a calculator priority">
        <button type="button" class="hdc__priority" data-priority="reprint">
          <span class="hdc__priority-icon" aria-hidden="true">↺</span>
          <span><strong>Edit and reprint</strong><small>Review and correct prior entries</small></span>
        </button>
        <button type="button" class="hdc__priority" data-priority="14-digit">
          <span class="hdc__priority-icon" aria-hidden="true">14</span>
          <span><strong>14-digit capacity</strong><small>Work with larger displayed values</small></span>
        </button>
        <button type="button" class="hdc__priority" data-priority="financial-time">
          <span class="hdc__priority-icon" aria-hidden="true">ƒx</span>
          <span><strong>Financial and time tools</strong><small>Advanced calculation workflows</small></span>
        </button>
        <button type="button" class="hdc__priority" data-priority="dual-memory">
          <span class="hdc__priority-icon" aria-hidden="true">M2</span>
          <span><strong>Dual independent memory</strong><small>Keep two separate running values</small></span>
        </button>
        <button type="button" class="hdc__priority" data-priority="change-sign">
          <span class="hdc__priority-icon" aria-hidden="true">±</span>
          <span><strong>Change-sign function</strong><small>Reverse a value instantly</small></span>
        </button>
        <button type="button" class="hdc__priority" data-priority="core-functions">
          <span class="hdc__priority-icon" aria-hidden="true">+</span>
          <span><strong>Core heavy-duty functions</strong><small>Fast, straightforward accounting work</small></span>
        </button>
      </div>

      <div class="hdc__recommendation" data-hdc-recommendation hidden aria-live="polite"></div>
    </section>

    <section id="HeavyDutyModels-{{ section.id }}" class="hdc__models-section" aria-labelledby="HeavyDutyModelsTitle-{{ section.id }}">
      <div class="hdc__section-heading hdc__section-heading--models">
        <div>
          <p class="hdc__section-kicker">At a glance</p>
          <h3 id="HeavyDutyModelsTitle-{{ section.id }}">Meet the heavy-duty lineup</h3>
          <p>Select up to two models. Your choices will remain highlighted throughout the page.</p>
        </div>
        <span class="hdc__selection-count" data-hdc-selection-count>0 of 2 selected</span>
      </div>

      <div class="hdc__model-grid" data-hdc-model-grid></div>

      <noscript>
        <div class="hdc__noscript">
          JavaScript is required for interactive comparison. You can still browse all
          <a href="{{ primary_link }}">Monroe heavy-duty calculators</a>.
        </div>
      </noscript>
    </section>

    <aside class="hdc__compare-tray" data-hdc-tray hidden aria-label="Selected calculator models">
      <div class="hdc__compare-tray-inner">
        <div>
          <p class="hdc__compare-label">Your comparison</p>
          <div class="hdc__compare-chips" data-hdc-selected-chips></div>
        </div>
        <div class="hdc__compare-actions">
          <button type="button" class="hdc__button hdc__button--secondary" data-hdc-clear>Clear</button>
          <button type="button" class="hdc__button hdc__button--primary" data-hdc-open-compare disabled>
            Compare selected models
          </button>
        </div>
      </div>
    </aside>

    <section id="HeavyDutyChart-{{ section.id }}" class="hdc__chart-section" aria-labelledby="HeavyDutyChartTitle-{{ section.id }}">
      <div class="hdc__section-heading hdc__section-heading--chart">
        <div>
          <p class="hdc__section-kicker">Detailed specifications</p>
          <h3 id="HeavyDutyChartTitle-{{ section.id }}">Explore every function and specification</h3>
          <p>Use the controls to focus the chart. On smaller screens, swipe horizontally to see each model.</p>
        </div>
      </div>

      <div class="hdc__chart-controls" role="group" aria-label="Comparison chart controls">
        <div class="hdc__segmented" data-hdc-section-filter>
          <button type="button" class="is-active" data-section-filter="all" aria-pressed="true">All</button>
          <button type="button" data-section-filter="functions" aria-pressed="false">Functions</button>
          <button type="button" data-section-filter="specifications" aria-pressed="false">Specifications</button>
        </div>

        <label class="hdc__switch">
          <input type="checkbox" data-hdc-differences />
          <span class="hdc__switch-track" aria-hidden="true"></span>
          <span>Show only differences</span>
        </label>
      </div>

      <div class="hdc__table-status" data-hdc-table-status aria-live="polite"></div>
      <div class="hdc__table-wrap" tabindex="0" role="region" aria-label="Heavy-duty calculator comparison chart">
        <table class="hdc__table" data-hdc-table></table>
      </div>
    </section>

    <section id="HeavyDutySupport-{{ section.id }}" class="hdc__support" aria-labelledby="HeavyDutySupportTitle-{{ section.id }}">
      <div>
        <p class="hdc__section-kicker">Talk with a calculator specialist</p>
        <h3 id="HeavyDutySupportTitle-{{ section.id }}">Still deciding between two models?</h3>
        <p>{{ section.settings.support_text | escape }}</p>
      </div>
      <div class="hdc__support-actions">
        <a class="hdc__button hdc__button--primary" href="tel:{{ section.settings.phone_number | remove: '-' | remove: '(' | remove: ')' | remove: ' ' }}">
          Call {{ section.settings.phone_number | escape }}
        </a>
        <a class="hdc__button hdc__button--secondary" href="{{ secondary_link }}">
          {{ section.settings.secondary_label | escape }}
        </a>
      </div>
    </section>
  </div>

  <div class="hdc__toast" data-hdc-toast hidden role="status" aria-live="polite"></div>

  <div class="hdc__modal" data-hdc-modal hidden>
    <div class="hdc__modal-backdrop" data-hdc-close-modal></div>
    <div class="hdc__modal-dialog" role="dialog" aria-modal="true" aria-labelledby="HeavyDutyModalTitle-{{ section.id }}">
      <div class="hdc__modal-header">
        <div>
          <p class="hdc__section-kicker">Selected models</p>
          <h3 id="HeavyDutyModalTitle-{{ section.id }}">Side-by-side comparison</h3>
        </div>
        <button type="button" class="hdc__modal-close" data-hdc-close-modal aria-label="Close comparison">×</button>
      </div>
      <div class="hdc__modal-body" data-hdc-modal-body></div>
      <div class="hdc__modal-footer">
        <button type="button" class="hdc__button hdc__button--secondary" data-hdc-print>Print comparison</button>
        <button type="button" class="hdc__button hdc__button--primary" data-hdc-close-modal>Done</button>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Heavy-duty comparison",
  "tag": "section",
  "class": "section-heavy-duty-comparison",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Monroe heavy-duty calculator guide"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Find the Heavy-Duty Printing Calculator Built for Your Workflow"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Introduction",
      "default": "<p>Compare Monroe heavy-duty printing calculators by function, capacity, memory, display, and workflow. Use the guided model finder or select any two calculators for a focused side-by-side comparison.</p>"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Optional hero image"
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Collection button label",
      "default": "Shop heavy-duty calculators"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "Collection button link"
    },
    {
      "type": "text",
      "id": "support_text",
      "label": "Support text",
      "default": "Tell us how you use your calculator and our team will help narrow down the best match. We are available Monday through Friday, 8 AM to 5 PM Eastern Time."
    },
    {
      "type": "text",
      "id": "phone_number",
      "label": "Phone number",
      "default": "267-580-2600"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary button label",
      "default": "View calculator manuals"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Secondary button link"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#007681"
    },
    {
      "type": "color",
      "id": "accent_dark",
      "label": "Dark accent",
      "default": "#005c64"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#101820"
    },
    {
      "type": "color",
      "id": "surface_color",
      "label": "Surface",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "soft_color",
      "label": "Soft background",
      "default": "#eef7f7"
    }
  ],
  "presets": [
    {
      "name": "Heavy-duty comparison"
    }
  ]
}
{% endschema %}