        <tr data-section="functions">
          <th class="ms-hd__rowLabel" scope="row">Percent (%+ and %- capability)</th>
          <td data-col="1">Standard</td><td data-col="2">Standard</td><td data-col="3">Standard</td><td data-col="4">Standard</td>
        </tr>

        <tr data-section="functions">
          <th class="ms-hd__rowLabel" scope="row">Tax (%+ and %- capability)</th>
          <td data-col="1">Standard</td><td data-col="2">Standard</td><td data-col="3">Standard</td><td data-col="4">Standard</td>
        </tr>

        <tr data-section="functions">
          <th class="ms-hd__rowLabel" scope="row">Item count (intelligent item count, automatic averaging)</th>
          <td data-col="1">Standard</td><td data-col="2">Standard</td><td data-col="3">Standard</td><td data-col="4">Standard</td>
        </tr>

        <tr data-section="functions">
          <th class="ms-hd__rowLabel" scope="row">Change sign</th>
          <td data-col="1">Standard</td><td data-col="2">Standard</td><td data-col="3">Not Available</td><td data-col="4">Not Available</td>
