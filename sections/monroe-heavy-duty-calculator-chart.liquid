<style>
/* =====================================================
   MONROE HEAVY DUTY SPEC CHART (Interactive) – FULL BUILD
   Scoped: .ms-hd
   Accent: #007681
   Included fixes:
   - Differences only REMOVED
   - Theme-proof row hiding for section toggles (hidden attribute)
   - Hard width fix so chart spans full content width
   - All buttons styled with 5px solid #000000 + bold white text
   ===================================================== */

.ms-hd{
  --ms-accent:#007681;
  --ms-soft: rgba(0,118,129,.10);
  --ms-soft2: rgba(0,118,129,.06);
  font-family: Arial, sans-serif;
  font-size: 15pt;
  line-height: 1.6;
  color:#000;
}

.ms-hd *, .ms-hd *::before, .ms-hd *::after{ box-sizing:border-box; }

.ms-hd__bar{
  background: var(--ms-accent);
  height: 35px;
  width: 100%;
  margin: 0 0 18px 0;
}

.ms-hd__title{
  font-size: 40px;
  line-height: 1.2;
  margin: 0 0 12px 0;
  text-align: center;
  text-decoration: underline;
  color: #000000;
}

.ms-hd__intro{ margin: 0 0 18px 0; }

.ms-hd__link{
  color: var(--ms-accent);
  text-decoration: underline;
}

/* Controls */
.ms-hd__controls{
  border: 2px solid var(--ms-accent);
  padding: 12px;
  margin: 0 0 12px 0;
  position: relative;
  isolation: isolate;
  overflow: visible;
}

.ms-hd__controlsTop{
  display:flex;
  align-items:flex-start;
  justify-content:space-between;
  gap:12px;
  flex-wrap:wrap;
  margin:0 0 12px 0;
}

.ms-hd__controlsTitle{
  margin:0;
  font-weight:650;
  font-size:12pt;
}

.ms-hd__controlsHint{
  margin:0;
  font-size:10.5pt;
  opacity:.85;
  max-width: 720px;
}

.ms-hd__btnRow{
  display:flex;
  gap:10px;
  flex-wrap:wrap;
  align-items:center;
}

/* =====================================================
   BUTTON DESIGN REQUIREMENT
   - 5px solid #000000 border
   - Bold white text
   ===================================================== */
.ms-hd__btn,
.ms-hd__trayRemove,
.ms-hd__modalClose{
  border: 5px solid #000000 !important;
  background: var(--ms-accent) !important;
  color: #ffffff !important;
  font-weight: 800 !important;
  border-radius: 12px;
  padding: 10px 12px;
  cursor: pointer;
  font-size: 11pt;
  text-decoration: none !important;
  line-height: 1.1;
}

.ms-hd__btn[disabled]{
  opacity:.55;
  cursor:not-allowed;
}

/* Keep pressed-state obvious */
.ms-hd__btn[aria-pressed="true"]{
  filter: brightness(0.95);
}

/* Make Remove a bit tighter (still matches border + text requirements) */
.ms-hd__trayRemove{
  padding: 6px 10px;
  font-size: 10pt;
}

/* Benchmark panel with competitor visual */
.ms-hd__bench{
  border: 1px solid var(--ms-accent);
  border-radius: 14px;
  padding: 12px;
}

.ms-hd__benchTop{
  display:flex;
  align-items:flex-start;
  justify-content:space-between;
  gap:12px;
  flex-wrap:wrap;
  margin:0 0 10px 0;
}

.ms-hd__benchTitle{
  margin:0;
  font-weight:650;
  font-size:12pt;
}

.ms-hd__benchNote{
  margin:0;
  font-size:10.5pt;
  opacity:.85;
}

.ms-hd__benchGrid{
  display:grid;
  grid-template-columns: 1fr;
  gap:10px;
}

@media (min-width:900px){
  .ms-hd__benchGrid{ grid-template-columns: 300px 1fr 1fr 1fr; }
}

.ms-hd__benchVisual{
  border: 1px solid rgba(0,118,129,.45);
  border-radius: 14px;
  padding: 10px;
  display:flex;
  gap:12px;
  align-items:center;
}

.ms-hd__benchIcon{
  width:64px;
  height:64px;
  border-radius:14px;
  background: rgba(0,0,0,.06);
  display:grid;
  place-items:center;
  flex:0 0 auto;
}

.ms-hd__benchVisualText{
  margin:0;
  font-size:10.5pt;
  line-height:1.35;
}

.ms-hd__benchCard{
  border: 1px solid rgba(0,118,129,.45);
  border-radius: 14px;
  padding: 10px;
}

.ms-hd__benchLabel{
  margin:0 0 6px 0;
  font-size:10pt;
  font-weight:650;
}

.ms-hd__benchBar{
  height:10px;
  border-radius:999px;
  background: rgba(0,0,0,.10);
  overflow:hidden;
}

.ms-hd__benchFill{
  height:100%;
  width:0%;
  background: var(--ms-accent);
}

.ms-hd__benchFill--comp{
  background: rgba(0,0,0,.25);
}

.ms-hd__benchValue{
  margin:8px 0 0 0;
  font-size:10.5pt;
}

/* Table wrapper */
.ms-hd__wrap{
  border: 3px solid var(--ms-accent);
  padding: 12px;
  overflow-x: auto;
  overflow-y: hidden;
  -webkit-overflow-scrolling: touch;
  position: relative;
}

.ms-hd__wrap::before,
.ms-hd__wrap::after{
  content:"";
  position:sticky;
  top:0;
  width:22px;
  height:100%;
  pointer-events:none;
  display:block;
}

.ms-hd__wrap::before{
  left:0;
  background:linear-gradient(to right, rgba(0,118,129,.18), transparent);
  float:left;
}

.ms-hd__wrap::after{
  right:0;
  background:linear-gradient(to left, rgba(0,118,129,.18), transparent);
  float:right;
}

/* Table */
.ms-hd__table{
  width:100%;
  border-collapse:collapse;
  min-width: 1100px;
}

.ms-hd__table th,
.ms-hd__table td{
  border: 1px solid var(--ms-accent);
  padding: 10px;
  text-align:center;
  font-size: 14pt;
  background:#fff;
  vertical-align:middle;
}

.ms-hd__table thead th{
  background:#fff;
}

@media (min-width:751px){
  .ms-hd__table thead th{
    position:sticky;
    top:0;
    z-index:3;
  }
}

.ms-hd__rowLabel{
  text-align:left !important;
  font-weight:650;
}

.ms-hd__modelHead{
  min-width: 210px;
}

.ms-hd__modelName{
  display:block;
  font-weight:650;
  margin-top:8px;
}

.ms-hd__modelImg img{
  max-width:150px;
  height:auto;
  display:block;
  margin:0 auto;
}

.ms-hd__pick{
  display:inline-flex;
  align-items:center;
  gap:8px;
  border:1px solid var(--ms-accent);
  border-radius:999px;
  padding:6px 10px;
  margin-top:10px;
  font-size:11pt;
  cursor:pointer;
  user-select:none;
}

.ms-hd__pick input{
  width:16px;
  height:16px;
}

/* Section rows */
.ms-hd__sectionRow th{
  text-align:left;
  font-size: 20pt;
  background: #fff;
}

/* Selected column highlighting */
.ms-hd__colSelected{
  background: var(--ms-soft) !important;
}

.ms-hd__colSelected2{
  background: var(--ms-soft2) !important;
}

/* Tray */
.ms-hd__tray{
  position:sticky;
  top:0;
  z-index:5;
  background:#fff;
  border:2px solid var(--ms-accent);
  margin:0 0 12px 0;
}

.ms-hd__trayInner{
  display:grid;
  grid-template-columns: 160px 1fr 240px;
  gap:12px;
  align-items:center;
  padding:12px;
}

.ms-hd__trayTitle{
  font-weight:650;
  font-size:12pt;
}

.ms-hd__traySlots{
  display:grid;
  grid-template-columns: 1fr 1fr;
  gap:10px;
}

.ms-hd__traySlot{
  border:1px solid var(--ms-accent);
  border-radius:12px;
  padding:10px;
  min-height:64px;
}

.ms-hd__traySlotTop{
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:10px;
  margin:0 0 6px 0;
}

.ms-hd__traySlotLabel{
  font-size:10pt;
  font-weight:650;
}

.ms-hd__trayName{
  font-size:11pt;
  line-height:1.3;
}

.ms-hd__trayActions{
  display:flex;
  gap:10px;
  justify-content:flex-end;
  flex-wrap:wrap;
}

@media (max-width:980px){
  .ms-hd__trayInner{ grid-template-columns:1fr; }
  .ms-hd__trayActions{ justify-content:flex-start; }
}

/* Modal */
.ms-hd__modal{
  position:fixed;
  inset:0;
  z-index:9999;
}

.ms-hd__modalBackdrop{
  position:absolute;
  inset:0;
  background: rgba(0,0,0,.55);
}

.ms-hd__modalPanel{
  position:relative;
  max-width:1100px;
  width:calc(100% - 24px);
  margin:24px auto;
  background:#fff;
  border-radius:16px;
  overflow:hidden;
  border:2px solid var(--ms-accent);
  max-height:calc(100% - 48px);
  display:flex;
  flex-direction:column;
}

.ms-hd__modalHeader{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:12px;
  padding:14px 16px;
  border-bottom:1px solid var(--ms-accent);
}

.ms-hd__modalTitle{
  font-size:13pt;
  font-weight:650;
}

.ms-hd__modalBody{
  padding:14px 16px;
  overflow:auto;
}

.ms-hd__modalGrid{
  display:grid;
  grid-template-columns: 280px 1fr 1fr;
  border:1px solid var(--ms-accent);
  border-radius:14px;
  overflow:hidden;
}

.ms-hd__modalCell{
  border-right:1px solid var(--ms-accent);
  border-bottom:1px solid var(--ms-accent);
  padding:10px;
  font-size:11pt;
  line-height:1.35;
  background:#fff;
}

.ms-hd__modalCell:nth-child(3n){ border-right:0; }

.ms-hd__modalHead{
  font-weight:650;
  background: var(--ms-soft);
}

.ms-hd__modalKey{ font-weight:650; }

.ms-hd__modalLink{
  color:var(--ms-accent);
  text-decoration:underline;
}

/* Mobile */
@media (max-width:750px){
  .ms-hd{ font-size:12pt; }
  .ms-hd__wrap{ padding:6px; overflow:hidden; }
  .ms-hd__table{ min-width:0; }
}

/* =====================================================
   Theme-proof row hiding (for section toggles)
   ===================================================== */
.ms-hd tr[hidden]{ display:none !important; }

/* =====================================================
   HARD WIDTH FIX: Force chart to span full content width
   ===================================================== */
.ms-hd{
  display:block !important;
  width:100% !important;
  max-width:100% !important;
  clear:both !important;
}

.ms-hd__controls,
.ms-hd__wrap,
.ms-hd__bench{
  display:block !important;
  width:100% !important;
  max-width:100% !important;
}

.ms-hd__wrap{
  margin-left:0 !important;
  margin-right:0 !important;
}

.ms-hd__table{
  width:100% !important;
  max-width:none !important;
  table-layout:auto !important;
}
  /* =====================================================
   TIGHT MODE: Reduce width so table fits without scroll
   Paste at VERY END of CSS
   ===================================================== */

/* Slightly smaller base type for the module */
.ms-hd{
  font-size: 13pt !important;
  line-height: 1.35 !important;
}

/* Tighten controls + benchmark spacing */
.ms-hd__controls{ padding: 10px !important; }
.ms-hd__controlsTop{ gap: 10px !important; margin: 0 0 10px 0 !important; }
.ms-hd__bench{ padding: 10px !important; }
.ms-hd__benchGrid{ gap: 8px !important; }
.ms-hd__benchVisual{ padding: 8px !important; gap: 10px !important; }
.ms-hd__benchCard{ padding: 8px !important; }

/* Tighten table wrapper */
.ms-hd__wrap{ padding: 8px !important; }

/* Reduce table padding + font sizes */
.ms-hd__table th,
.ms-hd__table td{
  padding: 6px 6px !important;
  font-size: 12pt !important;
  line-height: 1.2 !important;
}

/* Narrow the model columns */
.ms-hd__modelHead{
  min-width: 170px !important;
  width: 170px !important;
}

/* Reduce image size inside headers */
.ms-hd__modelImg img{
  max-width: 105px !important;
  height: auto !important;
}

/* Tighten model name spacing */
.ms-hd__modelName{ margin-top: 6px !important; }

/* Make Select pills smaller */
.ms-hd__pick{
  padding: 4px 8px !important;
  font-size: 10pt !important;
  margin-top: 8px !important;
}

/* Make row labels slightly smaller and allow wrapping */
.ms-hd__rowLabel{
  font-size: 12pt !important;
  white-space: normal !important;
}

/* Reduce overall table minimum width so it can fit */
.ms-hd__table{
  min-width: 0 !important;
  table-layout: fixed !important; /* enables predictable fitting */
}

/* Let cells wrap instead of forcing width */
.ms-hd__table td{
  white-space: normal !important;
  word-break: break-word !important;
}

/* Optional: reduce title spacing */
.ms-hd__title{
  font-size: 26pt !important;
  margin-bottom: 10px !important;
}
  .page-heading{
    color: #000000;
  }
</style>

