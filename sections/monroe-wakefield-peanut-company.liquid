{{ 'section-wakefield-peanut-spotlight.css' | asset_url | stylesheet_tag }}
<script src="{{ 'section-wakefield-peanut-spotlight.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign wakefield_collection = section.settings.product_collection
  if wakefield_collection == blank
    assign wakefield_collection = collections['wakefield-peanut-company']
  endif

  assign peanut_collection = section.settings.peanut_collection
  if peanut_collection == blank
    assign peanut_collection = collections['wakefield-peanuts']
  endif

  assign shelter_collection = section.settings.shelter_collection
  if shelter_collection == blank
    assign shelter_collection = collections['wakefield-wooden-squirrel-houses']
  endif

  assign product_count = wakefield_collection.products_count | default: wakefield_collection.products.size
  assign phone_href = section.settings.phone | remove: '(' | remove: ')' | remove: '-' | remove: ' ' | remove: '.' | prepend: 'tel:'
  assign logo_alt = section.settings.logo.alt | default: 'Wakefield Peanut Company'
  assign hero_alt = section.settings.hero_image.alt | default: section.settings.heading
  assign blog_url = section.settings.blog_url | default: '/blogs/news/what-is-the-wakefield-peanut-company-why-is-it-good'

  assign shelter_product = blank
  assign shelter_alt = ''
  if wakefield_collection != blank
    for product in wakefield_collection.products
      assign product_title_down = product.title | downcase
      if product_title_down contains 'squirrel house' or product_title_down contains 'nesting box'
        assign shelter_product = product
        assign shelter_alt = product.featured_image.alt | default: product.title
        break
      endif
    endfor
  endif
-%}

<section
  id="WakefieldSpotlight-{{ section.id }}"
  class="wpf"
  data-wpf-section
  style="
    --wpf-accent: {{ section.settings.accent_color }};
    --wpf-accent-dark: {{ section.settings.accent_dark }};
    --wpf-sun: {{ section.settings.highlight_color }};
    --wpf-cream: {{ section.settings.cream_color }};
    --wpf-ink: {{ section.settings.text_color }};
    --wpf-max-width: {{ section.settings.max_width }}px;
  "
  aria-labelledby="WakefieldTitle-{{ section.id }}"
>
  <div class="wpf__shell">
    <header class="wpf__hero">
      <div class="wpf__hero-copy">
        <div class="wpf__brand-row">
          {%- if section.settings.logo != blank -%}
            {{ section.settings.logo
              | image_url: width: 700
              | image_tag:
                class: 'wpf__logo',
                loading: 'eager',
                widths: '320, 480, 700',
                sizes: '(min-width: 750px) 320px, 250px',
                alt: logo_alt
            }}
          {%- else -%}
            <img
              class="wpf__logo"
              src="https://cdn.shopify.com/s/files/1/0653/0262/6407/files/af5d7cae-b2c3-401d-b1fa-4b80f01a.png?v=1783023980"
              alt="Wakefield Peanut Company"
              width="600"
              height="180"
              loading="eager"
            >
          {%- endif -%}

          {%- if section.settings.eyebrow != blank -%}
            <p class="wpf__eyebrow">{{ section.settings.eyebrow | escape }}</p>
          {%- endif -%}
        </div>

        <h2 id="WakefieldTitle-{{ section.id }}" class="wpf__title">
          {{ section.settings.heading | escape }}
        </h2>

        <div class="wpf__intro rte">
          {{ section.settings.introduction }}
        </div>

        <div class="wpf__hero-actions">
          <a class="wpf__button wpf__button--primary" href="#WakefieldProducts-{{ section.id }}">
            {{ section.settings.primary_button_label | escape }}
          </a>
          {%- if wakefield_collection != blank -%}
            <a class="wpf__button wpf__button--secondary" href="{{ wakefield_collection.url }}">
              {{ section.settings.secondary_button_label | escape }}
            </a>
          {%- endif -%}
        </div>

        <ul class="wpf__trust-list" role="list">
          <li><strong>Virginia</strong><span>peanut products</span></li>
          <li><strong>Multiple</strong><span>package sizes</span></li>
          <li><strong>Backyard</strong><span>wildlife use</span></li>
          <li><strong>Since 2017</strong><span>Monroe partner</span></li>
        </ul>
      </div>

      <div class="wpf__hero-visual" aria-label="Wakefield Peanut Company products">
        {%- if section.settings.hero_image != blank -%}
          {{ section.settings.hero_image
            | image_url: width: 1400
            | image_tag:
              class: 'wpf__hero-image',
              loading: 'eager',
              widths: '600, 900, 1200, 1400',
              sizes: '(min-width: 990px) 46vw, 100vw',
              alt: hero_alt
          }}
        {%- elsif wakefield_collection != blank and wakefield_collection.products.size > 0 -%}
          <div class="wpf__product-collage" aria-hidden="true">
            {%- for product in wakefield_collection.products limit: 4 -%}
              {%- assign collage_alt = product.featured_image.alt | default: product.title -%}
              <div class="wpf__collage-card wpf__collage-card--{{ forloop.index }}">
                {%- if product.featured_image != blank -%}
                  {{ product.featured_image
                    | image_url: width: 620
                    | image_tag:
                      loading: 'eager',
                      widths: '260, 420, 620',
                      sizes: '250px',
                      alt: collage_alt
                  }}
                {%- endif -%}
              </div>
            {%- endfor -%}
          </div>
        {%- else -%}
          <div class="wpf__hero-fallback">
            <span>Nature’s Favorite Brand</span>
            <strong>Backyard wildlife<br>starts here.</strong>
          </div>
        {%- endif -%}
      </div>
    </header>

    <aside class="wpf__notice" aria-label="Animal feed notice">
      <span class="wpf__notice-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24"><path d="M12 3 2.8 20h18.4L12 3Zm0 5.5v5.8m0 3.1v.1" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </span>
      <div>
        <strong>{{ section.settings.notice_heading | escape }}</strong>
        <p>{{ section.settings.notice_text | escape }}</p>
      </div>
    </aside>

    <section class="wpf__story" aria-labelledby="WakefieldStory-{{ section.id }}">
      <div class="wpf__section-heading wpf__section-heading--left">
        <p class="wpf__kicker">The Wakefield difference</p>
        <h3 id="WakefieldStory-{{ section.id }}">A simple way to make your outdoor space more inviting</h3>
        <p>Wakefield products help customers stock feeders, offer supplemental animal feed, and create a more welcoming backyard habitat.</p>
      </div>

      <div class="wpf__story-grid">
        <article class="wpf__story-card">
          <span class="wpf__story-icon" aria-hidden="true">
            <svg viewBox="0 0 48 48"><path d="M13 31c4-12 14-18 25-18-1 11-7 21-20 23m-5-5c-1 5-1 9 0 12m6-14c5 0 9 1 13 4" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/></svg>
          </span>
          <h4>Virginia peanut tradition</h4>
          <p>Choose from in-shell, shelled, raw, and extra-large peanut options prepared for animal and wildlife feeding applications.</p>
        </article>

        <article class="wpf__story-card">
          <span class="wpf__story-icon" aria-hidden="true">
            <svg viewBox="0 0 48 48"><path d="M11 29c7-3 10-10 12-18 6 6 8 13 5 20m-17-2c-3 8 2 13 10 13 9 0 14-5 12-13m-22 0c5 2 17 2 22 0" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
          <h4>Built for practical use</h4>
          <p>Multiple bag sizes make it easier to choose an option for occasional backyard feeding or larger, more frequent feeding needs.</p>
        </article>

        <article class="wpf__story-card">
          <span class="wpf__story-icon" aria-hidden="true">
            <svg viewBox="0 0 48 48"><path d="M8 25 24 11l16 14v17H8V25Zm8 17V28h16v14m-11-8h6" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
          <h4>Feed and shelter</h4>
          <p>Pair Wakefield peanuts with a dedicated feeder or the handcrafted squirrel nesting box to build a more complete backyard setup.</p>
        </article>
      </div>
    </section>

    <section id="WakefieldProducts-{{ section.id }}" class="wpf__products" aria-labelledby="WakefieldProductsTitle-{{ section.id }}">
      <div class="wpf__section-heading">
        <p class="wpf__kicker">Shop the assortment</p>
        <h3 id="WakefieldProductsTitle-{{ section.id }}">
          Explore {{ product_count }} Wakefield products
        </h3>
        <p>Search by product, package size, or use, then narrow the assortment with the category filters.</p>
      </div>

      <div class="wpf__controls" role="search" aria-label="Search and filter Wakefield products">
        <div class="wpf__search-wrap">
          <label for="WakefieldSearch-{{ section.id }}">Search products</label>
          <div class="wpf__search-field">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m21 21-4.35-4.35m2.35-5.65a8 8 0 1 1-16 0 8 8 0 0 1 16 0Z" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
            <input
              id="WakefieldSearch-{{ section.id }}"
              type="search"
              placeholder="Try in-shell, 25 lb, shelled, squirrel house..."
              autocomplete="off"
              data-wpf-search
            >
          </div>
        </div>

        <div class="wpf__sort-wrap">
          <label for="WakefieldSort-{{ section.id }}">Sort products</label>
          <select id="WakefieldSort-{{ section.id }}" data-wpf-sort>
            <option value="featured">Featured order</option>
            <option value="az">Name: A–Z</option>
            <option value="za">Name: Z–A</option>
            <option value="price-low">Price: Low to high</option>
            <option value="price-high">Price: High to low</option>
          </select>
        </div>

        <div class="wpf__filter-group" aria-label="Filter Wakefield products">
          <button type="button" class="wpf__filter is-active" data-wpf-filter="all" aria-pressed="true">All products</button>
          <button type="button" class="wpf__filter" data-wpf-filter="peanuts" aria-pressed="false">All peanuts</button>
          <button type="button" class="wpf__filter" data-wpf-filter="inshell" aria-pressed="false">In-shell</button>
          <button type="button" class="wpf__filter" data-wpf-filter="shelled" aria-pressed="false">Shelled</button>
          <button type="button" class="wpf__filter" data-wpf-filter="habitat" aria-pressed="false">Habitat products</button>
        </div>

        <div class="wpf__results-bar">
          <p data-wpf-status aria-live="polite">Showing {{ product_count }} products</p>
          <button type="button" class="wpf__clear" data-wpf-clear hidden>Clear filters</button>
        </div>
      </div>

      {%- if wakefield_collection != blank and wakefield_collection.products.size > 0 -%}
        <div class="wpf__product-grid" data-wpf-grid>
          {%- for product in wakefield_collection.products -%}
            {% render 'wakefield-product-card',
              product: product,
              position: forloop.index,
              show_quick_add: section.settings.show_quick_add
            %}
          {%- endfor -%}
        </div>

        <div class="wpf__empty" data-wpf-empty hidden>
          <span class="wpf__empty-icon" aria-hidden="true">🥜</span>
          <h4>No products matched that search</h4>
          <p>Try a broader term or reset the category filters.</p>
          <button type="button" class="wpf__button wpf__button--primary" data-wpf-empty-reset>Show all products</button>
        </div>
      {%- else -%}
        <div class="wpf__setup-message">
          <h4>Select the Wakefield collection</h4>
          <p>Open this section in the Shopify Theme Editor and select the Wakefield Peanut Company collection.</p>
        </div>
      {%- endif -%}
    </section>

    <section class="wpf__wildlife" aria-labelledby="WakefieldGuideTitle-{{ section.id }}">
      <div class="wpf__section-heading">
        <p class="wpf__kicker">Backyard wildlife guide</p>
        <h3 id="WakefieldGuideTitle-{{ section.id }}">Choose an approach for the animals you hope to attract</h3>
        <p>Select an animal below for practical placement and feeding considerations.</p>
      </div>

      <div class="wpf__guide" data-wpf-guide>
        <div class="wpf__guide-tabs" role="tablist" aria-label="Wildlife feeding guidance">
          <button type="button" id="WakefieldTabBirds-{{ section.id }}" class="wpf__guide-tab is-active" role="tab" aria-selected="true" aria-controls="WakefieldPanelBirds-{{ section.id }}" data-wpf-guide-tab="birds">
            <span aria-hidden="true">🐦</span> Wild birds
          </button>
          <button type="button" id="WakefieldTabSquirrels-{{ section.id }}" class="wpf__guide-tab" role="tab" aria-selected="false" aria-controls="WakefieldPanelSquirrels-{{ section.id }}" data-wpf-guide-tab="squirrels">
            <span aria-hidden="true">🐿️</span> Squirrels
          </button>
          <button type="button" id="WakefieldTabDeer-{{ section.id }}" class="wpf__guide-tab" role="tab" aria-selected="false" aria-controls="WakefieldPanelDeer-{{ section.id }}" data-wpf-guide-tab="deer">
            <span aria-hidden="true">🦌</span> Deer
          </button>
          <button type="button" id="WakefieldTabFarm-{{ section.id }}" class="wpf__guide-tab" role="tab" aria-selected="false" aria-controls="WakefieldPanelFarm-{{ section.id }}" data-wpf-guide-tab="farm">
            <span aria-hidden="true">🐖</span> Farm animals
          </button>
        </div>

        <div class="wpf__guide-panels">
          <article id="WakefieldPanelBirds-{{ section.id }}" class="wpf__guide-panel" role="tabpanel" aria-labelledby="WakefieldTabBirds-{{ section.id }}" data-wpf-guide-panel="birds">
            <div class="wpf__guide-visual" aria-hidden="true">🐦</div>
            <div>
              <p class="wpf__guide-label">Best for feeder activity</p>
              <h4>Wild birds</h4>
              <p>Whole peanuts may appeal to larger backyard birds, while shelled pieces can be easier for smaller birds to manage. Use an appropriate feeder or a clean platform away from heavy foot traffic.</p>
              <ul>
                <li>Keep feeding stations clean and dry.</li>
                <li>Offer modest amounts and remove spoiled feed.</li>
                <li>Place feeders where you can observe without disturbing wildlife.</li>
              </ul>
            </div>
          </article>

          <article id="WakefieldPanelSquirrels-{{ section.id }}" class="wpf__guide-panel" role="tabpanel" aria-labelledby="WakefieldTabSquirrels-{{ section.id }}" data-wpf-guide-panel="squirrels" hidden>
            <div class="wpf__guide-visual" aria-hidden="true">🐿️</div>
            <div>
              <p class="wpf__guide-label">Best for dedicated backyard stations</p>
              <h4>Squirrels</h4>
              <p>Use in-shell peanuts in a squirrel feeder or designated area to encourage activity away from bird feeders. A dedicated nesting box can add shelter to the feeding setup.</p>
              <ul>
                <li>Use a consistent, easy-to-clean feeding location.</li>
                <li>Avoid placing feed directly beside doors or vehicle areas.</li>
                <li>Pair food with water and appropriate habitat where practical.</li>
              </ul>
            </div>
          </article>

          <article id="WakefieldPanelDeer-{{ section.id }}" class="wpf__guide-panel" role="tabpanel" aria-labelledby="WakefieldTabDeer-{{ section.id }}" data-wpf-guide-panel="deer" hidden>
            <div class="wpf__guide-visual" aria-hidden="true">🦌</div>
            <div>
              <p class="wpf__guide-label">Check local regulations first</p>
              <h4>Deer</h4>
              <p>Wildlife-feeding rules vary by location, and feeding deer may be restricted. Confirm local requirements before offering supplemental feed and avoid creating crowding or dependency.</p>
              <ul>
                <li>Never feed near roadways.</li>
                <li>Follow seasonal wildlife-agency guidance.</li>
                <li>Stop if feeding attracts unwanted animals or unsafe activity.</li>
              </ul>
            </div>
          </article>

          <article id="WakefieldPanelFarm-{{ section.id }}" class="wpf__guide-panel" role="tabpanel" aria-labelledby="WakefieldTabFarm-{{ section.id }}" data-wpf-guide-panel="farm" hidden>
            <div class="wpf__guide-visual" aria-hidden="true">🐖</div>
            <div>
              <p class="wpf__guide-label">Use professional feeding guidance</p>
              <h4>Farm animals</h4>
              <p>Dietary needs vary by species, age, and health. Before adding peanuts to a livestock or companion-animal diet, consult a veterinarian or qualified animal-nutrition professional.</p>
              <ul>
                <li>Introduce new feed gradually.</li>
                <li>Account for total calories and nutrient balance.</li>
                <li>Do not use moldy, damp, or spoiled feed.</li>
              </ul>
            </div>
          </article>
        </div>
      </div>
    </section>

    {%- if shelter_product != blank -%}
      <section class="wpf__shelter" aria-labelledby="WakefieldShelterTitle-{{ section.id }}">
        <div class="wpf__shelter-media">
          {%- if shelter_product.featured_image != blank -%}
            {{ shelter_product.featured_image
              | image_url: width: 1100
              | image_tag:
                loading: 'lazy',
                widths: '420, 720, 900, 1100',
                sizes: '(min-width: 900px) 42vw, 90vw',
                alt: shelter_alt
            }}
          {%- endif -%}
        </div>

        <div class="wpf__shelter-copy">
          <p class="wpf__kicker">Complete the backyard setup</p>
          <h3 id="WakefieldShelterTitle-{{ section.id }}">Add a dedicated place for squirrels to nest</h3>
          <p>The Wakefield squirrel nesting box complements the peanut assortment with a durable outdoor habitat product.</p>
          <ul class="wpf__check-list" role="list">
            <li>Handcrafted wooden construction</li>
            <li>Designed for outdoor use</li>
            <li>Pairs naturally with a dedicated squirrel-feeding area</li>
          </ul>
          <div class="wpf__shelter-actions">
            <a class="wpf__button wpf__button--primary" href="{{ shelter_product.url }}">View squirrel house</a>
            {%- if shelter_collection != blank -%}
              <a class="wpf__text-link" href="{{ shelter_collection.url }}">Browse habitat products</a>
            {%- endif -%}
          </div>
        </div>
      </section>
    {%- endif -%}

    <section class="wpf__learn" aria-labelledby="WakefieldLearnTitle-{{ section.id }}">
      <div>
        <p class="wpf__kicker">Learn more about the brand</p>
        <h3 id="WakefieldLearnTitle-{{ section.id }}">Why Wakefield has become a backyard favorite</h3>
        <p>Read the Monroe guide for more background on the brand, its Virginia peanut tradition, and common wildlife-feeding uses.</p>
      </div>
      <a class="wpf__button wpf__button--primary" href="{{ blog_url }}">Read the Wakefield guide</a>
    </section>

    <footer class="wpf__support" aria-labelledby="WakefieldSupportTitle-{{ section.id }}">
      <div>
        <p class="wpf__kicker">Need help choosing?</p>
        <h3 id="WakefieldSupportTitle-{{ section.id }}">Talk with the Monroe customer service team</h3>
        <p>{{ section.settings.support_text | escape }}</p>
      </div>

      <div class="wpf__support-actions">
        <a class="wpf__button wpf__button--primary" href="{{ phone_href }}">Call {{ section.settings.phone | escape }}</a>
        <a class="wpf__button wpf__button--secondary" href="mailto:{{ section.settings.email | escape }}">Email our team</a>
      </div>
    </footer>
  </div>
</section>

{% schema %}
{
  "name": "Wakefield spotlight",
  "tag": "section",
  "class": "section-wakefield-spotlight",
  "settings": [
    {
      "type": "collection",
      "id": "product_collection",
      "label": "Wakefield product collection"
    },
    {
      "type": "collection",
      "id": "peanut_collection",
      "label": "Peanut collection"
    },
    {
      "type": "collection",
      "id": "shelter_collection",
      "label": "Squirrel house collection"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Wakefield logo"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Optional hero image",
      "info": "Leave blank to create a collage from the selected collection."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Nature’s Favorite Brand"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Bring more life to your backyard"
    },
    {
      "type": "richtext",
      "id": "introduction",
      "label": "Introduction",
      "default": "<p>Wakefield Peanut Company offers Virginia peanut products and backyard habitat essentials for customers who enjoy feeding and observing wildlife.</p>"
    },
    {
      "type": "text",
      "id": "primary_button_label",
      "label": "Primary button label",
      "default": "Shop Wakefield products"
    },
    {
      "type": "text",
      "id": "secondary_button_label",
      "label": "Secondary button label",
      "default": "View full collection"
    },
    {
      "type": "checkbox",
      "id": "show_quick_add",
      "label": "Show Quick Add buttons",
      "default": true
    },
    {
      "type": "text",
      "id": "notice_heading",
      "label": "Feed notice heading",
      "default": "For animal feeding and wildlife use only"
    },
    {
      "type": "text",
      "id": "notice_text",
      "label": "Feed notice text",
      "default": "Not intended for human consumption. Follow local wildlife-feeding rules and keep feeding areas clean."
    },
    {
      "type": "url",
      "id": "blog_url",
      "label": "Wakefield guide link"
    },
    {
      "type": "text",
      "id": "support_text",
      "label": "Support text",
      "default": "We can help you compare package sizes, product formats, and habitat options."
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone number",
      "default": "(267) 580-2600"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email address",
      "default": "csr@monroe-systems.com"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#727f63"
    },
    {
      "type": "color",
      "id": "accent_dark",
      "label": "Dark accent",
      "default": "#33412e"
    },
    {
      "type": "color",
      "id": "highlight_color",
      "label": "Highlight color",
      "default": "#f1da7d"
    },
    {
      "type": "color",
      "id": "cream_color",
      "label": "Background color",
      "default": "#fbf8eb"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#182016"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Maximum content width",
      "min": 1000,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "default": 1450
    }
  ],
  "presets": [
    {
      "name": "Wakefield spotlight"
    }
  ]
}
{% endschema %}