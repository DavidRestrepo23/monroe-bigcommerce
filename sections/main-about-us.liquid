        { "type": "team_member", "settings": { "name": "Nicole Rosenblatt", "role": "Administrative Assistant" } },
        { "type": "team_member", "settings": { "name": "Brandon Leip", "role": "Digital Marketer" } },
        { "type": "team_member", "settings": { "name": "Maria Haney", "role": "Customer Service Representative" } },
        { "type": "team_member", "settings": { "name": "Gaby Larco", "role": "Customer Service Representative" } }
      ]
    }
