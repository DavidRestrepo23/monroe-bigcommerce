{{ 'component-hero-slider.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #HeroSlider-{{ section.id }} {
    --hero-bg: {{ section.settings.background_color | default: '#EDEDED' }};
    --hero-text: {{ section.settings.text_color | default: '#000000' }};
    --hero-accent: {{ section.settings.accent_color | default: '#007681' }};
    --hero-heading: {{ section.settings.heading_color | default: '#000000' }};
    --hero-subtext: {{ section.settings.subtext_color | default: '#000000' }};
    --hero-radius: {{ section.settings.border_radius | default: 24 }}px;
  }
  #HeroSlider-{{ section.id }} .hero-slider__slide {
    position: relative;
  }

  #HeroSlider-{{ section.id }} .hero-slider__full-link {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: block;
  }

  #HeroSlider-{{ section.id }} .hero-slider__inner {
    position: relative;
    z-index: 2;
    pointer-events: none;
  }

  #HeroSlider-{{ section.id }} .hero-slider__inner a,
  #HeroSlider-{{ section.id }} .hero-slider__button,
  #HeroSlider-{{ section.id }} .hero-slider__product-card {
    pointer-events: auto;
  }
{%- endstyle -%}

<section
  id="HeroSlider-{{ section.id }}"
  class="hero-slider"
  data-autoplay="{{ section.settings.autoplay }}"
  data-autoplay-delay="{{ section.settings.autoplay_delay | default: 5000 }}"
  data-show-arrows="{{ section.settings.show_arrows }}"
  data-loop="{{ section.settings.loop }}"
>
  <div class="swiper hero-slider__swiper">
    <div class="swiper-wrapper">
      {%- for block in section.blocks -%}
        {%- if block.type == 'slide' -%}
          {%- if block.settings.mobile_image != blank -%}
            {%- style -%}
              @media (max-width: 749px) {
                #HeroSlider-{{ section.id }} #HeroSlide-{{ block.id }} {
                  background-image: url('{{ block.settings.mobile_image | image_url: width: 900 }}') !important;
                  background-repeat: no-repeat;
                  background-position: center;
                  background-size: cover;
                }
              }
            {%- endstyle -%}
          {%- endif -%}
          <div
            id="HeroSlide-{{ block.id }}"
            class="swiper-slide hero-slider__slide{% if block.settings.main_image != blank or block.settings.mobile_image != blank %} hero-slider__slide--has-bg{% endif %}"
            {% if block.settings.main_image != blank %}
              style="background-image: url('{{ block.settings.main_image | image_url: width: 1920 }}');background-repeat: no-repeat;background-position: center;background-size: cover;"
            {% endif %}
            {{ block.shopify_attributes }}
          >
              {%- if block.settings.slide_link != blank -%}
    <a
      class="hero-slider__full-link"
      href="{{ block.settings.slide_link }}"
      aria-label="{% if block.settings.heading != blank %}{{ block.settings.heading | escape }}{% else %}View slide{% endif %}"
    ></a>
  {%- endif -%}
            <div class="hero-slider__inner">
              <div class="hero-slider__content">
                {%- if block.settings.heading != blank -%}
                  <h1 class="hero-slider__heading">{{ block.settings.heading }}</h1>
                {%- endif -%}
                {%- if block.settings.subtext != blank -%}
                  <p class="hero-slider__subtext">{{ block.settings.subtext }}</p>
                {%- endif -%}
                {%- if block.settings.button_text != blank -%}
                  <a class="hero-slider__button button-primary" href="{{ block.settings.button_link | default: '#' }}">
                    {{ block.settings.button_text }}
                  </a>
                {%- endif -%}
              </div>
              <div class="hero-slider__featured-product">
                {%- if block.settings.featured_product != blank -%}
                  {%- assign fp = all_products[block.settings.featured_product] -%}
                  <a class="hero-slider__product-card" href="{{ fp.url }}">
                    {%- if fp.featured_media -%}
                      <div class="hero-slider__product-thumb">
                        {{
                          fp.featured_media
                          | image_url: width: 160
                          | image_tag: width: 80, height: 80, alt: fp.title
                        }}
                      </div>
                    {%- endif -%}
                    <div class="hero-slider__product-info">
                      {%- if block.settings.rating > 0 -%}
                        <div class="hero-slider__rating" aria-label="Rating: {{ block.settings.rating }} out of 5">
                          <div>
                            {%- for i in (1..5) -%}
                              <span class="hero-slider__star {% if i <= block.settings.rating %}is-filled{% endif %}"
                                >★</span
                              >
                            {%- endfor -%}
                          </div>
                          <span class="hero-slider__product-arrow" aria-hidden="true">
                            {% render 'icon-arrow' %}
                          </span>
                        </div>
                      {%- endif -%}

                      <p class="hero-slider__product-title">{{ fp.title | escape }}</p>
                      <p class="hero-slider__product-price">{{ fp.price | money }}</p>
                    </div>
                  </a>
                {%- endif -%}
              </div>

              {%- if block.settings.main_image == blank -%}
                <div class="hero-slider__media">
                  <div class="hero-slider__media-placeholder">
                    {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
                  </div>
                </div>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- if section.settings.show_arrows -%}
      <button class="hero-slider__nav hero-slider__nav--prev swiper-button-prev" aria-label="Previous slide"></button>
      <button class="hero-slider__nav hero-slider__nav--next swiper-button-next" aria-label="Next slide"></button>
    {%- endif -%}
  </div>
  <div class="hero-slider__pagination swiper-pagination"></div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    var root = document.getElementById('HeroSlider-{{ section.id }}');
    if (!root || typeof Swiper === 'undefined') {
      // Swiper may load after DOMContentLoaded due to defer; retry once.
      window.addEventListener('load', function () { initHeroSlider{{ section.id | replace: '-', '_' }}(); });
      return;
    }
    initHeroSlider{{ section.id | replace: '-', '_' }}();
  });

  function initHeroSlider{{ section.id | replace: '-', '_' }}() {
    var root = document.getElementById('HeroSlider-{{ section.id }}');
    if (!root || root.dataset.initialized === 'true' || typeof Swiper === 'undefined') return;
    root.dataset.initialized = 'true';

    var autoplay = root.dataset.autoplay === 'true';
    var delay = parseInt(root.dataset.autoplayDelay, 10) || 5000;
    var showArrows = root.dataset.showArrows === 'true';
    var loop = root.dataset.loop === 'true';

    new Swiper(root.querySelector('.hero-slider__swiper'), {
      slidesPerView: 1,
      spaceBetween: 0,
      loop: loop,
      autoplay: autoplay ? { delay: delay, disableOnInteraction: false } : false,
      pagination: {
        el: root.querySelector('.hero-slider__pagination'),
        clickable: true
      },
      navigation: showArrows ? {
        nextEl: root.querySelector('.swiper-button-next'),
        prevEl: root.querySelector('.swiper-button-prev')
      } : false,
      a11y: { enabled: true }
    });
  }
</script>

{% schema %}
{
  "name": "Hero Slider",
  "tag": "section",
  "class": "section-hero-slider",
  "settings": [
    {
      "type": "header",
      "content": "Slider behavior"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_delay",
      "min": 2000,
      "max": 9500,
      "step": 500,
      "unit": "ms",
      "label": "Autoplay delay",
      "default": 5000
    },
    {
      "type": "checkbox",
      "id": "loop",
      "label": "Loop slides",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show prev/next arrows",
      "default": false
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#EDEDED"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent (button/active dot)",
      "default": "#007681"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "subtext_color",
      "label": "Subtext color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Corner radius",
      "default": 24
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "header",
          "content": "Copy"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Industry-Leading Printing Calculators and Business Supplies"
        },
        {
          "type": "textarea",
          "id": "subtext",
          "label": "Subtext",
          "default": "Trusted by professionals since 1912 for accuracy, durability, and reliability."
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button text",
          "default": "Shop Our Calculators"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        },
        {
          "type": "header",
          "content": "Main image"
        },
        {
          "type": "image_picker",
          "id": "main_image",
          "label": "Main image (right side)"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Mobile image",
          "info": "Optional. Replaces the main image on screens ≤ 749px. Falls back to the main image if empty."
        },
        {
  "type": "url",
  "id": "slide_link",
  "label": "Full hero image link",
  "info": "Optional. Makes the full hero slide clickable. Can link to a product, collection, page, or external URL."
},
        {
          "type": "header",
          "content": "Featured product card"
        },
        {
          "type": "product",
          "id": "featured_product",
          "label": "Featured product"
        },
        {
          "type": "range",
          "id": "rating",
          "min": 0,
          "max": 5,
          "step": 1,
          "label": "Rating (stars)",
          "default": 5
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero Slider",
      "blocks": [
        {
          "type": "slide"
        },
        {
          "type": "slide"
        }
      ]
    }
  ]
}
{% endschema %}