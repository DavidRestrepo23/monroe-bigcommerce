{{ 'component-hero-slider.css' | asset_url | stylesheet_tag }}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css">

{%- style -%}
  #HeroSlider-{{ section.id }} {
    --hero-bg: {{ section.settings.background_color | default: '#EDEDED' }};
    --hero-text: {{ section.settings.text_color | default: '#0A0A0A' }};
    --hero-accent: {{ section.settings.accent_color | default: '#1F6F75' }};
    --hero-heading: {{ section.settings.heading_color | default: '#000000' }};
    --hero-subtext: {{ section.settings.subtext_color | default: '#000000' }};
    --hero-radius: {{ section.settings.border_radius | default: 24 }}px;
    --button-radius: {{ section.settings.button_border_radius | default: 8 }}px;
    {%- if section.settings.product_card_variant == '2' -%}
      --hero-card-bg: rgba(255, 255, 255, 0.15);
      --hero-card-text: #ffffff;
      --hero-card-star-empty: rgba(255, 255, 255, 0.4);
      --hero-card-star-filled: #F8E623;
      --hero-card-arrow-color: #ffffff;
      --hero-card-arrow-opacity: 1;
      --hero-card-shadow: none;
    {%- else -%}
      --hero-card-bg: #ffffff;
      --hero-card-text: inherit;
      --hero-card-star-empty: #d8d8d8;
      --hero-card-star-filled: #C0B000;
      --hero-card-arrow-color: currentColor;
      --hero-card-arrow-opacity: 0.5;
      --hero-card-shadow: 0 6px 20px rgba(0, 0, 0, 0.06);
    {%- endif -%}
  }
{%- endstyle -%}

<section
  id="HeroSlider-{{ section.id }}"
  class="hero-slider"
  data-autoplay="{{ section.settings.autoplay }}"
  data-autoplay-delay="{{ section.settings.autoplay_delay | default: 5000 }}"
  data-show-arrows="{{ section.settings.show_arrows }}"
  data-loop="{{ section.settings.loop }}"
>
  <div class="swiper hero-slider__swiper">
    <div class="swiper-wrapper">
      {%- for block in section.blocks -%}
        {%- if block.type == 'slide' -%}
          <div
            class="swiper-slide hero-slider__slide{% if block.settings.main_image != blank %} hero-slider__slide--has-bg{% endif %}"
            {% if block.settings.main_image != blank %}
              style="background-image: url('{{ block.settings.main_image | image_url: width: 1920 }}');background-repeat: no-repeat;background-position: center;background-size: cover;"
            {% endif %}
            {{ block.shopify_attributes }}
          >
            <div class="hero-slider__inner">
              <div class="hero-slider__content">
                {%- if block.settings.heading != blank -%}
                  <h1 class="hero-slider__heading">{{ block.settings.heading }}</h1>
                {%- endif -%}
                {%- if block.settings.subtext != blank -%}
                  <p class="hero-slider__subtext">{{ block.settings.subtext }}</p>
                {%- endif -%}
                {%- if block.settings.button_text != blank -%}
                  <a class="hero-slider__button button-primary" href="{{ block.settings.button_link | default: '#' }}">
                    {{ block.settings.button_text }}
                  </a>
                {%- endif -%}
              </div>
              <div class="hero-slider__featured-product">
                {%- if block.settings.featured_product != blank -%}
                  {%- assign fp = all_products[block.settings.featured_product] -%}
                  <a class="hero-slider__product-card" href="{{ fp.url }}">
                    {%- if fp.featured_media -%}
                      <div class="hero-slider__product-thumb">
                        {{
                          fp.featured_media
                          | image_url: width: 160
                          | image_tag: width: 80, height: 80, alt: fp.title
                        }}
                      </div>
                    {%- endif -%}
                    <div class="hero-slider__product-info">
                      {%- if block.settings.rating > 0 -%}
                        <div class="hero-slider__rating" aria-label="Rating: {{ block.settings.rating }} out of 5">
                          <div>
                            {%- for i in (1..5) -%}
                              <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="16"
                                height="15"
                                viewBox="0 0 16 15"
                                fill="none"
                                style="margin: 0 1.5px"
                              >
                                <path d="M15.5967 6.86489L12.3805 9.56185L13.3604 13.5951C13.4145 13.8141 13.4005 14.0437 13.3204 14.255C13.2402 14.4662 13.0975 14.6497 12.9101 14.7821C12.7227 14.9145 12.4992 14.9901 12.2677 14.9991C12.0361 15.0081 11.8071 14.9503 11.6094 14.8328L8.00014 12.6742L4.38876 14.8328C4.19109 14.9496 3.9623 15.0069 3.73119 14.9975C3.50008 14.9882 3.27699 14.9126 3.09 14.7802C2.90302 14.6479 2.76051 14.4648 2.68041 14.2539C2.60031 14.043 2.58621 13.8138 2.63988 13.5951L3.62331 9.56185L0.407157 6.86489C0.232268 6.718 0.105785 6.52429 0.043504 6.30796C-0.0187769 6.09163 -0.0140954 5.86226 0.0569637 5.6485C0.128023 5.43473 0.26231 5.24605 0.443055 5.10602C0.6238 4.96598 0.842993 4.8808 1.07326 4.8611L5.29 4.53049L6.91666 0.704878C7.0047 0.496384 7.15456 0.318044 7.34717 0.19253C7.53978 0.0670169 7.76645 0 7.99836 0C8.23026 0 8.45693 0.0670169 8.64954 0.19253C8.84215 0.318044 8.99201 0.496384 9.08006 0.704878L10.706 4.53049L14.9227 4.8611C15.1535 4.88006 15.3733 4.96477 15.5547 5.10462C15.7361 5.24446 15.871 5.43321 15.9425 5.64724C16.014 5.86126 16.0189 6.09103 15.9567 6.30775C15.8944 6.52448 15.7677 6.71853 15.5924 6.86559L15.5967 6.86489Z" fill="#F8E623"/>
                              </svg>
                            {%- endfor -%}
                          </div>
                          <span  aria-hidden="true">
                            {% render 'icon-arrow' %}
                          </span>
                        </div>
                      {%- endif -%}

                      <h3 class="hero-slider__product-title">{{ fp.title | escape | truncate: 20, '...' }}</h3>
                      <p class="hero-slider__product-price">{{ fp.price | money }}</p>
                    </div>
                  </a>
                {%- endif -%}
              </div>

              {%- if block.settings.main_image == blank -%}
                <div class="hero-slider__media">
                  <div class="hero-slider__media-placeholder">
                    {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
                  </div>
                </div>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- if section.settings.show_arrows -%}
      <button class="hero-slider__nav hero-slider__nav--prev swiper-button-prev" aria-label="Previous slide"></button>
      <button class="hero-slider__nav hero-slider__nav--next swiper-button-next" aria-label="Next slide"></button>
    {%- endif -%}
  </div>
  <div class="hero-slider__pagination swiper-pagination"></div>
</section>

<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js" defer></script>
<script>
  document.addEventListener('DOMContentLoaded', function () {
    var root = document.getElementById('HeroSlider-{{ section.id }}');
    if (!root || typeof Swiper === 'undefined') {
      // Swiper may load after DOMContentLoaded due to defer; retry once.
      window.addEventListener('load', function () { initHeroSlider{{ section.id | replace: '-', '_' }}(); });
      return;
    }
    initHeroSlider{{ section.id | replace: '-', '_' }}();
  });

  function initHeroSlider{{ section.id | replace: '-', '_' }}() {
    var root = document.getElementById('HeroSlider-{{ section.id }}');
    if (!root || root.dataset.initialized === 'true' || typeof Swiper === 'undefined') return;
    root.dataset.initialized = 'true';

    var autoplay = root.dataset.autoplay === 'true';
    var delay = parseInt(root.dataset.autoplayDelay, 10) || 5000;
    var showArrows = root.dataset.showArrows === 'true';
    var loop = root.dataset.loop === 'true';

    new Swiper(root.querySelector('.hero-slider__swiper'), {
      slidesPerView: 1,
      spaceBetween: 0,
      loop: loop,
      autoplay: autoplay ? { delay: delay, disableOnInteraction: false } : false,
      pagination: {
        el: root.querySelector('.hero-slider__pagination'),
        clickable: true
      },
      navigation: showArrows ? {
        nextEl: root.querySelector('.swiper-button-next'),
        prevEl: root.querySelector('.swiper-button-prev')
      } : false,
      a11y: { enabled: true }
    });
  }
</script>

{% schema %}
{
  "name": "Hero Slider",
  "tag": "section",
  "class": "section-hero-slider",
  "settings": [
    {
      "type": "header",
      "content": "Slider behavior"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_delay",
      "min": 2000,
      "max": 9500,
      "step": 500,
      "unit": "ms",
      "label": "Autoplay delay",
      "default": 5000
    },
    {
      "type": "checkbox",
      "id": "loop",
      "label": "Loop slides",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show prev/next arrows",
      "default": false
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#EDEDED"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#0A0A0A"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent (button/active dot)",
      "default": "#1F6F75"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "subtext_color",
      "label": "Subtext color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Corner radius",
      "default": 24
    },
    {
      "type": "select",
      "id": "product_card_variant",
      "label": "Product card style",
      "default": "1",
      "options": [
        { "value": "1", "label": "Default (white card)" },
        { "value": "2", "label": "Glassmorphism (translucent)" }
      ]
    },
    {
      "type": "range",
      "id": "button_border_radius",
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px",
      "label": "Button border radius",
      "default": 8
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "header",
          "content": "Copy"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Industry-Leading Printing Calculators and Business Supplies"
        },
        {
          "type": "textarea",
          "id": "subtext",
          "label": "Subtext",
          "default": "Trusted by professionals since 1912 for accuracy, durability, and reliability."
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button text",
          "default": "Shop Our Calculators"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        },
        {
          "type": "header",
          "content": "Main image"
        },
        {
          "type": "image_picker",
          "id": "main_image",
          "label": "Main image (right side)"
        },
        {
          "type": "header",
          "content": "Featured product card"
        },
        {
          "type": "product",
          "id": "featured_product",
          "label": "Featured product"
        },
        {
          "type": "range",
          "id": "rating",
          "min": 0,
          "max": 5,
          "step": 1,
          "label": "Rating (stars)",
          "default": 5
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero Slider",
      "blocks": [
        {
          "type": "slide"
        },
        {
          "type": "slide"
        }
      ]
    }
  ]
}
{% endschema %}
