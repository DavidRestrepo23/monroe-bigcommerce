  <script>
  (function(){
  var root = document.querySelector(".mbt");
  if(!root) return;

  var toggleBtn = document.getElementById("mbtToggle");
  if(toggleBtn){
    toggleBtn.addEventListener("click", function(){
      root.classList.toggle("mbt--checkOn");
    });
  }

  var pills = root.querySelectorAll(".mbt__pill[data-filter]");
  var cards = root.querySelectorAll(".mbt__model[data-tier]");
  var live = document.getElementById("mbtLive");

  function setPressed(active){
    pills.forEach(function(p){
      p.setAttribute("aria-pressed", String(p.getAttribute("data-filter") === active));
    });
  }

  function applyFilter(filter){
    var shown = 0;

    cards.forEach(function(card){
      var tier = card.getAttribute("data-tier");
      var show = (filter === "all") || (tier === filter);

      card.style.display = show ? "" : "none";
      if(show) shown += 1;
    });

    setPressed(filter);

    if(live){
      var label = filter === "all" ? "all models" : (filter === "heavy" ? "heavy duty models" : "medium duty models");
      live.textContent = "Showing " + shown + " " + label + ".";
    }
  }

  pills.forEach(function(p){
    p.addEventListener("click", function(){
      applyFilter(p.getAttribute("data-filter"));
    });
  });

  applyFilter("heavy");
})();

  </script>

