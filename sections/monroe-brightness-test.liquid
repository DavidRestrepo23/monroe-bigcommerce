<style>
.mbt{
  --monroe-teal:#007681;
  --ink:#0b1b1c;
  --muted:#5a6a6b;
  --card:#ffffff;
  --bg:#f6faf9;
  --border:rgba(11,27,28,.14);
  --shadow:0 14px 34px rgba(0,0,0,.10);
  --radius:18px;

  font-family: Roboto, Arial, sans-serif;
  color: var(--ink);
  background: var(--bg);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  overflow: hidden;
}
.mbt *{ box-sizing: border-box; }

.mbt__bar{ background: var(--monroe-teal); height: 14px; }
.mbt__wrap{ max-width: 1040px; margin: 0 auto; padding: 22px 18px 26px; }

.mbt__hero{ text-align: center; padding: 10px 0 6px; }
.mbt__hero img{ width: min(520px, 92%); height: auto; display: block; margin: 0 auto; }
.mbt__title{ font-size: clamp(22px, 2.6vw, 34px); margin: 14px 0 6px; letter-spacing: .2px; }
.mbt__sub{ color: var(--muted); margin: 0 auto; max-width: 820px; line-height: 1.55; font-size: 15.5px; }

.mbt__card{
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  padding: 18px;
}

.mbt__card h2{ font-size: 18px; margin: 0 0 10px; }
.mbt__card p{ margin: 0 0 10px; line-height: 1.6; }
.mbt__card p:last-child{ margin-bottom: 0; }

/* Large Example module */
.mbt__example{
  margin-top: 18px;
  padding: 18px;
}
.mbt__exampleGrid{
  display: grid;
  gap: 14px;
  grid-template-columns: 1fr;
  align-items: start;
}
@media (min-width: 900px){
  .mbt__exampleGrid{
    grid-template-columns: 1.2fr .8fr;
  }
}
.mbt__imgLink{ display: block; text-decoration: none; }
.mbt__img{
  width: 100%;
  height: auto;
  display: block;
  border-radius: 16px;
  border: 1px solid var(--border);
}
.mbt__imgCaption{ margin-top: 10px; color: var(--muted); font-size: 14px; line-height: 1.5; }

.mbt__note{
  padding: 12px 14px;
  border-radius: 16px;
  border: 1px solid rgba(0,118,129,.22);
  background: rgba(0,118,129,.06);
}
.mbt__note strong{ color: var(--monroe-teal); }

/* Run the test + steps */
.mbt__run{ margin-top: 14px; }
.mbt__steps{ display: grid; gap: 10px; margin-top: 8px; }
.mbt__step{
  display: grid;
  grid-template-columns: 34px 1fr;
  gap: 10px;
  padding: 12px;
  border-radius: 14px;
  border: 1px solid var(--border);
  background: #fff;
  position: relative;
  overflow: hidden;
}
.mbt__num{
  width: 34px; height: 34px;
  display: grid; place-items: center;
  border-radius: 12px;
  background: rgba(0,118,129,.10);
  color: var(--monroe-teal);
  font-weight: 800;
}
.mbt__step strong{ display: block; margin-bottom: 3px; }

/* Buttons */
.mbt__controls{ display: flex; flex-wrap: wrap; gap: 10px; margin-top: 12px; }
.mbt__toggle,
.mbt__pill{
  appearance: none;
  border: 1px solid var(--border);
  background: #fff;
  color: var(--ink);
  border-radius: 999px;
  padding: 10px 14px;
  cursor: pointer;
  font-weight: 800;
  transition: transform .08s ease, box-shadow .18s ease, border-color .18s ease, background-color .18s ease;
  min-height: 44px;
}
.mbt__toggle:hover,
.mbt__pill:hover{ box-shadow: 0 10px 24px rgba(0,0,0,.08); }
.mbt__toggle:active,
.mbt__pill:active{ transform: translateY(1px); }
.mbt__toggle:focus,
.mbt__pill:focus{ outline: 3px solid rgba(0,118,129,.25); outline-offset: 2px; }

.mbt__pill[aria-pressed="true"]{
  background: rgba(0,118,129,.10);
  border-color: rgba(0,118,129,.35);
  color: var(--monroe-teal);
}

.mbt__ctaRow{ display: flex; flex-wrap: wrap; gap: 10px; margin-top: 14px; }
.mbt__btn{
  display: inline-flex; align-items: center; justify-content: center;
  border-radius: 999px;
  padding: 12px 18px;
  font-weight: 900;
  text-decoration: none;
  border: 3px solid rgba(0,0,0,.20);
  transition: transform .08s ease, box-shadow .18s ease;
  line-height: 1;
  min-height: 44px;
  white-space: nowrap;
}
.mbt__btnPrimary{
  background: var(--monroe-teal);
  color: #fff;
  border-color: rgba(0,0,0,.28);
}
.mbt__btnPrimary:hover{ box-shadow: 0 12px 28px rgba(0,0,0,.12); }
.mbt__btnSecondary{ background: #fff; color: var(--ink); }

.mbt__sectionTitle{ margin: 22px 0 10px; font-size: 18px; }
.mbt__compareIntro{ color: var(--muted); margin: 0 0 12px; line-height: 1.6; }

.mbt__filterRow{
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  align-items: center;
  margin: 8px 0 12px;
}
.mbt__filterLabel{ font-weight: 900; }

.mbt__compareGrid{ display: grid; gap: 12px; grid-template-columns: 1fr; }
@media (min-width: 900px){ .mbt__compareGrid{ grid-template-columns: repeat(3, 1fr); } }

.mbt__model{
  background: #fff;
  border: 1px solid var(--border);
  border-radius: 18px;
  box-shadow: 0 12px 28px rgba(0,0,0,.08);
  padding: 14px;
  display: grid;
  gap: 10px;
  align-content: start;
  min-height: 100%;
}
.mbt__modelTop{ display: grid; gap: 4px; }
.mbt__badge{
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: fit-content;
  padding: 6px 10px;
  border-radius: 999px;
  font-weight: 900;
  font-size: 12px;
  background: rgba(0,118,129,.10);
  color: var(--monroe-teal);
  border: 1px solid rgba(0,118,129,.20);
}
.mbt__modelName{ margin: 0; font-size: 18px; }
.mbt__modelDesc{ margin: 0; color: var(--muted); line-height: 1.55; font-size: 14.5px; }
.mbt__modelList{ margin: 0; padding-left: 18px; }
.mbt__modelList li{ margin: 8px 0; line-height: 1.55; }
.mbt__modelCtas{ display: flex; gap: 10px; flex-wrap: wrap; margin-top: 6px; }
.mbt__modelCtas a{ flex: 1 1 auto; }

.mbt__accordion details{
  background: #fff;
  border: 1px solid var(--border);
  border-radius: 16px;
  padding: 12px 14px;
  margin-top: 10px;
  box-shadow: 0 10px 26px rgba(0,0,0,.06);
}
.mbt__accordion summary{
  cursor: pointer;
  font-weight: 900;
  color: var(--ink);
  list-style: none;
}
.mbt__accordion summary::-webkit-details-marker{ display:none; }
.mbt__accordion summary::after{
  content: "+";
  float: right;
  color: var(--monroe-teal);
  font-weight: 900;
}
.mbt__accordion details[open] summary::after{ content: "x"; }
.mbt__accordion ul{ margin: 10px 0 0 18px; padding: 0; color: var(--ink); }
.mbt__accordion li{ margin: 8px 0; line-height: 1.55; }
.mbt__accordion a{ color: var(--monroe-teal); font-weight: 800; text-decoration: none; }
.mbt__accordion a:hover{ text-decoration: underline; }

.mbt__human{ text-align: center; margin-top: 18px; }
.mbt__human h3{ margin: 0 0 6px; font-size: 18px; }
.mbt__human p{ margin: 0; color: var(--muted); line-height: 1.55; }
.mbt__human a{ color: var(--monroe-teal); font-weight: 900; text-decoration: none; }
.mbt__human a:hover{ text-decoration: underline; }

.mbt__footerImg{ margin-top: 14px; }
.mbt__footerImg img{ width: 100%; height: auto; display: block; border-radius: 16px; border: 1px solid var(--border); }

.mbt__srOnly{
  position:absolute;
  width:1px;
  height:1px;
  padding:0;
  margin:-1px;
  overflow:hidden;
  clip:rect(0,0,0,0);
  border:0;
}

/* “Pop” effect toggle */
.mbt--checkOn .mbt__step{ border-color: rgba(0,118,129,.32); }
.mbt--checkOn .mbt__step::before{
  content:"";
  position: absolute;
  inset: -40% -60%;
  background: radial-gradient(circle, rgba(0,118,129,.16) 0%, rgba(0,118,129,0) 60%);
  animation: mbtPulse 1.7s ease-in-out infinite;
}
@keyframes mbtPulse{
  0%{ transform: translateX(-10%) translateY(8%); opacity: .55; }
  50%{ transform: translateX(8%) translateY(-6%); opacity: .85; }
  100%{ transform: translateX(-10%) translateY(8%); opacity: .55; }
}
.mbt--checkOn .mbt__step > *{ position: relative; z-index: 1; }
</style>

