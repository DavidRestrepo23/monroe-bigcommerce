{%- liquid
  assign product_form_id = 'product-form-' | append: section.id
  assign current_variant = product.selected_or_first_available_variant
  assign featured_media = current_variant.featured_media | default: product.featured_media
  assign product_media = product.media
  assign has_variants = false
  if product.has_only_default_variant == false
    assign has_variants = true
  endif
  assign paypal_pay_in_4_minimum = 3000
  assign paypal_pay_in_4_maximum = 150000
  assign paypal_installment_amount = current_variant.price | divided_by: 4.0
-%}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css">
{{ 'section-main-product.css' | asset_url | stylesheet_tag }}


<section class="main-product" 
  data-section-id="{{ section.id }}"
  data-add-to-cart-text="{{ 'products.product.add_to_cart' | t | escape }}"
  data-sold-out-text="{{ 'products.product.sold_out' | t | escape }}"
  data-in-stock-text="{{ 'products.product.in_stock' | t | escape }}"
  data-out-of-stock-text="{{ 'products.product.out_of_stock' | t | escape }}"
>
  <div class="main-product__container">
    <div class="main-product__gallery">
      <div class="product-gallery">
        <div class="swiper product-gallery__main">
          <div class="swiper-wrapper">
            {%- for media in product_media -%}
              <div class="swiper-slide product-gallery__slide" data-media-id="{{ media.id }}">
                {%- if media.media_type == 'video' or media.media_type == 'external_video' -%}
                  {{ media | media_tag: image_size: '1500', autoplay: false, loop: false, controls: true, preload: 'none' }}
                {%- else -%}
                  {{ media | image_url: width: 1500 | image_tag:
                    loading: 'lazy',
                    widths: '480, 720, 960, 1200, 1600',
                    sizes: '(min-width: 990px) 50vw, 100vw',
                    alt: media.alt | default: product.title,
                    class: 'product-gallery__image'
                  }}
                {%- endif -%}
              </div>
            {%- else -%}
              <div class="swiper-slide product-gallery__slide">
                {{ 'product-1' | placeholder_svg_tag: 'product-gallery__image placeholder-svg' }}
              </div>
            {%- endfor -%}
          </div>
          <button class="product-gallery__wishlist" type="button" data-wishlist-toggle data-product-handle="{{ product.handle }}" aria-label="Add to wishlist">
            {%- render 'icon-heart' -%}
          </button>
        </div>

        {%- if product_media.size > 1 -%}
          <div class="swiper product-gallery__thumbs">
            <div class="swiper-wrapper">
              {%- for media in product_media -%}
                <div class="swiper-slide product-gallery__thumb" data-media-id="{{ media.id }}">
                  {{ media.preview_image | image_url: width: 200 | image_tag:
                    loading: 'lazy',
                    widths: '120, 200, 300',
                    sizes: '120px',
                    alt: media.alt | default: product.title
                  }}
                </div>
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}
      </div>

      <div class="main-product__accordions hide--on-mobile">
        <details class="accordion">
          <summary class="accordion__summary">
            <span>{{ 'products.product.description' | t }}</span>
            {%- render 'icon-arrow-down' -%}
          </summary>
          <div class="accordion__content" >
            {{ product.description  }}
          </div>
        </details>

        {%- if product.metafields.custom.warranty_information.value != blank or section.settings.warranty_text != blank -%}
          <details class="accordion">
            <summary class="accordion__summary">
              <span>{{ 'products.product.warranty_information' | t }}</span>
               {%- render 'icon-arrow-down' -%}
            </summary>
            <div class="accordion__content" >
              {%- if product.metafields.custom.warranty_information.value != blank -%}
                {{ product.metafields.custom.warranty_information.value }}
              {%- else -%}
                {{ section.settings.warranty_text | strip_html }}
              {%- endif -%}
            </div>
          </details>
        {%- endif -%}

        {%- if product.metafields.custom.additional_information.value != blank -%}
          <details class="accordion">
            <summary class="accordion__summary">
              <span>{{ 'products.product.additional_information' | t }}</span>
               {%- render 'icon-arrow-down' -%}
            </summary>
            <div class="accordion__content">
              {{ product.metafields.custom.additional_information | metafield_tag }}
            </div>
          </details>
        {%- endif -%}
      </div>
    </div>

    <div class="main-product__info">
      <div class="main-product__availability" data-variant-availability>
        <span class="availability-dot"></span>
        <span data-variant-availability-text>{% if current_variant.available %}{{ 'products.product.in_stock' | t }}{% else %}{{ 'products.product.out_of_stock' | t }}{% endif %}</span>
      </div>

      {%- if product.vendor != blank -%}
        <p class="main-product__vendor">{{ product.vendor }}</p>
      {%- endif -%}

      <h1 class="main-product__title">{{ product.title }}</h1>

      <div class="main-product__meta">
        <span class="meta-pill" data-variant-sku{% if current_variant.sku == blank %} hidden{% endif %}>
          SKU: <span data-variant-sku-value>{{ current_variant.sku }}</span>
        </span>
        <span class="meta-pill" data-variant-upc{% if current_variant.barcode == blank %} hidden aria-hidden="true" style="display: none;"{% else %} aria-hidden="false"{% endif %}>
          UPC: <span data-variant-upc-value>{{ current_variant.barcode }}</span>
        </span>
        {%- if product.metafields.reviews.rating.value != blank -%}
          {%- assign rating = product.metafields.reviews.rating.value | round: 1 -%}
          {%- assign rating_count = product.metafields.reviews.rating_count.value | default: 0 -%}
          <span class="meta-rating" aria-label="Rating: {{ rating }} of 5">
            {%- assign rating_int = rating | floor -%}
            {%- for i in (1..5) -%}
              <svg width="14" height="14" viewBox="0 0 14 14" fill="{% if forloop.index0 < rating_int %}#F5A623{% else %}#E0E0E0{% endif %}" aria-hidden="true">
                <path d="M7 0l2.163 4.382L14 5.09l-3.5 3.413L11.326 14 7 11.732 2.674 14 3.5 8.503 0 5.09l4.837-.708L7 0z"/>
              </svg>
            {%- endfor -%}
            <span>({{ rating_count }} Reviews)</span>
          </span>
        {%- endif -%}
      </div>

      {%- if product.description != blank -%}
        <div class="main-product__short" data-raw-desc>
          {{ product.description | strip_html | truncatewords: 60 }}
        </div>
      {%- endif -%}

      <div class="main-product__notes">
  {%- assign availability_text = product.metafields.custom.availability_message | default: section.settings.availability_note -%}
  {%- if availability_text != blank -%}
    <div class="note-row">
      {% render 'icon-calendar' %}
      <strong>{{ 'products.product.availability' | t }}:</strong>
      <span>{{ availability_text }}</span>
    </div>
  {%- endif -%}
      </div>

      <product-form-pdp class="main-product__form-wrapper" data-section="{{ section.id }}">
        {%- form 'product', product, id: product_form_id, class: 'main-product__form', novalidate: 'novalidate' -%}
          <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-input>

          {%- if has_variants -%}
            {%- for option in product.options_with_values -%}
              {%- assign option_index = forloop.index0 -%}
              {%- assign raw_selected = option.selected_value.name | default: option.selected_value -%}
              {%- assign selected_parts = raw_selected | split: ':' -%}
              {%- assign selected_name = selected_parts[0] -%}
              <div class="variant-option" data-option-index="{{ option_index }}">
                <div class="variant-option__label">
                  <span class="variant-option__name">{{ option.name }}</span>
                
                </div>
                <div class="variant-option__values">
                  {%- for value in option.values -%}
                    {%- assign value_raw = value.name | default: value -%}
                    {%- assign value_parts = value_raw | split: ':' -%}
                    {%- assign value_name = value_parts[0] -%}
                    {%- assign value_color = value_parts[1] -%}
                    {%- assign variant_for_value = null -%}
                    {%- for variant in product.variants -%}
                      {%- assign opt_val = variant.options[option_index] -%}
                      {%- if opt_val == value_raw and variant_for_value == null -%}
                        {%- assign variant_for_value = variant -%}
                      {%- endif -%}
                    {%- endfor -%}
                    {%- assign variant_image = variant_for_value.featured_media -%}
                    <button
                      type="button"
                      class="variant-option__value{% if value_name == selected_name %} is-active{% endif %}{% if value_color %} variant-option__value--color{% endif %}"
                      data-option-index="{{ option_index }}"
                      data-option-value="{{ value_raw | escape }}"
                      {% if variant_image %}data-media-id="{{ variant_image.id }}"{% endif %}
                      {% if value_color %}style="--swatch-color: #{{ value_color | remove: '#' }}"{% endif %}
                      aria-label="{{ option.name }}: {{ value_name }}"
                      aria-pressed="{% if value_name == selected_name %}true{% else %}false{% endif %}"
                      title="{{ value_name }}"
                    >
                      {%- if value_color -%}
                        <span class="variant-option__swatch" aria-hidden="true"></span>
                      {%- elsif value.swatch -%}
                        {%- render 'swatch', swatch: value.swatch, shape: 'square' -%}
                      {%- else -%}
                        <span class="variant-option__text">{{ value_name }}</span>
                      {%- endif -%}
                    </button>
                  {%- endfor -%}
                </div>
              </div>
            {%- endfor -%}
          {%- endif -%}

          <div class="main-product__price" data-price>
            {%- if current_variant.compare_at_price > current_variant.price -%}
              <del class="price-compare">{{ current_variant.compare_at_price | money }}</del>
            {%- endif -%}
            <span class="price-current">{{ current_variant.price | money }}</span>
            <span
              class="price-financing"
              data-paypal-financing-message
              data-paypal-minimum="{{ paypal_pay_in_4_minimum }}"
              data-paypal-maximum="{{ paypal_pay_in_4_maximum }}"
              {% if current_variant.price <= 0 %}hidden{% endif %}
            >
              {%- if current_variant.price < paypal_pay_in_4_minimum -%}
                | About 4 payments of {{ paypal_installment_amount | money }} for this item when included in a qualifying $30+ order with PayPal.
              {%- elsif current_variant.price <= paypal_pay_in_4_maximum -%}
                | Split into 4 interest-free payments of {{ paypal_installment_amount | money }} with PayPal.
              {%- else -%}
                | PayPal Pay Monthly may be available at checkout.
              {%- endif -%}
            </span>
          </div>

          <div class="main-product__actions">
            <div class="qty-input">
              <button type="button" class="qty-input__btn" data-qty-action="increase" aria-label="Increase quantity">
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M7 2v10M2 7h10" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
              </button>
              <input type="number" class="qty-input__field" name="quantity" value="1" min="1" aria-label="Quantity">
              <button type="button" class="qty-input__btn" data-qty-action="decrease" aria-label="Decrease quantity">
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M2 7h10" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
              </button>
            </div>

            <button
              type="submit"
              name="add"
              class="btn-add-to-cart"
              data-add-to-cart-button
              {% unless current_variant.available %}disabled{% endunless %}
            >
              <span>
                {%- if current_variant.available -%}
                  {{ 'products.product.add_to_cart' | t }}
                {%- else -%}
                  {{ 'products.product.sold_out' | t }}
                {%- endif -%}
              </span>
            </button>
          </div>

          {%- if section.settings.show_paypal_button -%}
            <div class="main-product__paypal">
              {{ form | payment_button }}
            </div>
          {%- endif -%}
        {%- endform -%}
      </product-form-pdp>
    </div>
  </div>

  <div class="main-product__accordions hide--on-desktop">
        <details class="accordion">
          <summary class="accordion__summary">
            <span>{{ 'products.product.description' | t }}</span>
            {%- render 'icon-arrow-down' -%}
          </summary>
          <div class="accordion__content" data-raw-desc>
            {{ product.description | strip_html | escape }}
          </div>
        </details>

        {%- if product.metafields.custom.warranty_information.value != blank or section.settings.warranty_text != blank -%}
          <details class="accordion">
            <summary class="accordion__summary">
              <span>{{ 'products.product.warranty_information' | t }}</span>
               {%- render 'icon-arrow-down' -%}
            </summary>
            <div class="accordion__content" data-raw-desc>
              {%- if product.metafields.custom.warranty_information.value != blank -%}
                {{ product.metafields.custom.warranty_information.value }}
              {%- else -%}
                {{ section.settings.warranty_text | strip_html }}
              {%- endif -%}
            </div>
          </details>
        {%- endif -%}

        {%- if product.metafields.custom.additional_information.value != blank -%}
          <details class="accordion">
            <summary class="accordion__summary">
              <span>{{ 'products.product.additional_information' | t }}</span>
               {%- render 'icon-arrow-down' -%}
            </summary>
            <div class="accordion__content">
              {{ product.metafields.custom.additional_information | metafield_tag }}
            </div>
          </details>
        {%- endif -%}
      </div>


      {% comment %} <!-- Start of Judge.me code -->{% assign has_legacy = false %}{% if product.metafields.judgeme.widget.size > 20 %}{% assign has_legacy = true %}{% endif %}<div style='clear:both'></div><div id='judgeme_product_reviews' class='jdgm-widget jdgm-review-widget' data-product-title='{{ product.title | escape }}' data-id='{{ product.id }}' data-product-id='{{ product.id }}' data-widget='review' data-auto-install='false' data-shop-reviews-count='{{ shop.metafields.judgeme.shop_reviews_count | default: 0 | escape }}' data-entry-point='review_widget.js' data-entry-key='review-widget/main.js'>{% if has_legacy %}<div class='jdgm-legacy-widget-content' style='display: none;'>{{ product.metafields.judgeme.widget }}</div>{% endif %}</div>{% if product.metafields.judgeme.review_widget_data %}<script>jdgm.data ||= {}; jdgm.data.reviewWidget ||= {}; jdgm.data.reviewWidget[{{ product.id }}] = {{ product.metafields.judgeme.review_widget_data }}</script>{% endif %}<!-- End of Judge.me code --> {% endcomment %}

  <script type="application/json" data-product-json>
    {{ product.variants | json }}
  </script>
</section>



<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js" defer></script>
<script src="{{ 'main-product-v2.js' | asset_url }}" defer></script>
<script>
  (function () {
    var section = document.querySelector('.main-product[data-section-id="{{ section.id }}"]');
    if (!section) return;

    var financingMessage = section.querySelector('[data-paypal-financing-message]');
    if (!financingMessage) return;

    var minimumPrice = parseInt(financingMessage.dataset.paypalMinimum, 10) || 3000;
    var maximumPrice = parseInt(financingMessage.dataset.paypalMaximum, 10) || 150000;

    function formatUsd(cents) {
      return '$' + (cents / 100).toFixed(2);
    }

    function updatePayPalMessage(variant) {
      if (!variant || variant.price <= 0) {
        financingMessage.hidden = true;
        return;
      }

      financingMessage.hidden = false;
      var installmentAmount = formatUsd(variant.price / 4);

      if (variant.price < minimumPrice) {
        financingMessage.textContent =
          ' | About 4 payments of ' + installmentAmount +
          ' for this item when included in a qualifying $30+ order with PayPal.';
      } else if (variant.price <= maximumPrice) {
        financingMessage.textContent =
          ' | Split into 4 interest-free payments of ' + installmentAmount + ' with PayPal.';
      } else {
        financingMessage.textContent = ' | PayPal Pay Monthly may be available at checkout.';
      }
    }

    section.addEventListener('variant:change', function (event) {
      var variant = event.detail && event.detail.variant;
      updatePayPalMessage(variant);
    });
  })();
</script>

{% schema %}
{
  "name": "Product",
  "tag": "section",
  "class": "section-main-product",
  "settings": [
    {
      "type": "text",
      "id": "availability_note",
      "label": "Availability note",
      "default": "Orders placed by 11 am ET will ship same-day (Mon - Fri)"
    },
    {
      "type": "checkbox",
      "id": "show_paypal_button",
      "label": "Show PayPal button",
      "default": true
    },
    {
      "type": "richtext",
      "id": "warranty_text",
      "label": "Warranty information (fallback)"
    }
  ],
  "presets": [
    { "name": "Product" }
  ],
  "enabled_on": {
    "templates": ["product"]
  }
}
{% endschema %}