{{ 'component-solutions-accordion.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #Solutions-{{ section.id }} {
    --sol-bg: {{ section.settings.background_color }};
    --sol-text: {{ section.settings.text_color }};
    --sol-icon-bg: {{ section.settings.icon_background }};
    --sol-button: {{ section.settings.button_color }};
    --sol-stars: {{ section.settings.stars_color }};
    --sol-heading-size: {{ section.settings.heading_size }}px;
    --sol-pad-top: {{ section.settings.padding_top }}px;
    --sol-pad-bottom: {{ section.settings.padding_bottom }}px;
  }
  @media (max-width: 768px) {
    #Solutions-{{ section.id }} {
      --sol-pad-top: {{ section.settings.padding_top_mobile | default: 32 }}px;
      --sol-pad-bottom: {{ section.settings.padding_bottom_mobile | default: 32 }}px;
    }
  }
{%- endstyle -%}

<div id="Solutions-{{ section.id }}" class="solutions">
  {%- comment -%} Left: Accordion {%- endcomment -%}
  <div class="solutions__accordion" role="list">
    {%- for block in section.blocks -%}
      {%- if block.type == 'item' -%}
        <div
          class="solutions__item{% if forloop.first %} solutions__item--active{% endif %}"
          role="listitem"
          data-solutions-item
          {{ block.shopify_attributes }}
        >
          {%- comment -%} Collapsed header — shown when inactive {%- endcomment -%}
          <div class="solutions__item-header" data-solutions-trigger>
            <div class="solutions__item-header-left">
              {%- if block.settings.icon != blank -%}
                <div class="solutions__item-icon">
                  {{- block.settings.icon | image_url: width: 44 | image_tag: width: 22, alt: '' -}}
                </div>
              {%- endif -%}
              <p class="solutions__item-title">{{ block.settings.title }}</p>
            </div>
            <span class="solutions__item-toggle" aria-hidden="true">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M12 5v14M5 12h14"/>
              </svg>
            </span>
          </div>

          {%- comment -%} Expanded view — shown when active {%- endcomment -%}
          <div class="solutions__item-image-wrap">
            {%- if block.settings.image != blank -%}
              {{- block.settings.image | image_url: width: 600 | image_tag: width: 600, alt: block.settings.title -}}
            {%- else -%}
              {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
            <div class="solutions__item-overlay">
              <div class="solutions__item-overlay-top">
                <div class="solutions__item-overlay-left">
                  {%- if block.settings.icon != blank -%}
                    <div class="solutions__item-overlay-icon">
                      {{- block.settings.icon | image_url: width: 44 | image_tag: width: 22, alt: '' -}}
                    </div>
                  {%- endif -%}
                  <p class="solutions__item-overlay-title">{{ block.settings.title }}</p>
                </div>
                <button class="solutions__item-overlay-close" data-solutions-close aria-label="Collapse">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M5 12h14"/>
                  </svg>
                </button>
              </div>
              {%- if block.settings.description != blank -%}
                <p class="solutions__item-overlay-desc">{{ block.settings.description }}</p>
              {%- endif -%}
            </div>
          </div>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>

  {%- comment -%} Right: Content + Testimonial {%- endcomment -%}
  <div class="solutions__content">
    <div>
      {%- if section.settings.heading != blank -%}
        <h2 class="solutions__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}

      {%- if section.settings.button_label != blank and section.settings.button_url != blank -%}
        <a href="{{ section.settings.button_url }}" class="solutions__cta">
          {{ section.settings.button_label }}
        </a>
      {%- endif -%}
    </div>
    {%- if section.settings.testimonial_quote != blank -%}
      <div class="solutions__testimonial">
        <div class="solutions__testimonial-header">
          {%- if section.settings.testimonial_avatar != blank -%}
            {{-
              section.settings.testimonial_avatar
              | image_url: width: 88
              | image_tag:
                width: 44,
                height: 44,
                class: 'solutions__testimonial-avatar',
                alt: section.settings.testimonial_author
            -}}
          {%- endif -%}
          <div class="solutions__testimonial-stars" aria-label="5 out of 5 stars">
            {%- for i in (1..5) -%}
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
              </svg>
            {%- endfor -%}
          </div>
        </div>
        <p class="solutions__testimonial-quote">{{ section.settings.testimonial_quote }}</p>
        {%- if section.settings.testimonial_author != blank -%}
          <p class="solutions__testimonial-author">{{ section.settings.testimonial_author }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>

<script>
  (function () {
    var container = document.getElementById('Solutions-{{ section.id }}');
    if (!container) return;
    var items = container.querySelectorAll('[data-solutions-item]');

    function activate(target) {
      items.forEach(function (el) {
        el.classList.remove('solutions__item--active');
      });
      target.classList.add('solutions__item--active');
    }

    items.forEach(function (item) {
      var trigger = item.querySelector('[data-solutions-trigger]');
      var closeBtn = item.querySelector('[data-solutions-close]');

      if (trigger) {
        trigger.addEventListener('click', function () {
          activate(item);
        });
      }

      if (closeBtn) {
        closeBtn.addEventListener('click', function (e) {
          e.stopPropagation();
          item.classList.remove('solutions__item--active');
        });
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Solutions Accordion",
  "tag": "section",
  "class": "page-width",
  "settings": [
    {
      "type": "header",
      "content": "Right column"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Find the Right Solution for Your Business"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 28,
      "max": 72,
      "step": 2,
      "default": 48,
      "unit": "px",
      "label": "Heading size"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "View All Solutions"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button URL"
    },
    {
      "type": "header",
      "content": "Testimonial"
    },
    {
      "type": "image_picker",
      "id": "testimonial_avatar",
      "label": "Avatar"
    },
    {
      "type": "textarea",
      "id": "testimonial_quote",
      "label": "Quote"
    },
    {
      "type": "text",
      "id": "testimonial_author",
      "label": "Author name",
      "placeholder": "NICOLA T."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#F8F8F8"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#1C1C1C"
    },
    {
      "type": "color",
      "id": "icon_background",
      "label": "Icon background",
      "default": "#E6F3F4"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button",
      "default": "#007681"
    },
    {
      "type": "color",
      "id": "stars_color",
      "label": "Stars",
      "default": "#007681"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top (mobile)",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom (mobile)",
      "default": 32
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Accordion item",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon (circle)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Accounting Offices"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description (shown when expanded)"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Background image (shown when expanded)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Solutions Accordion",
      "blocks": [{ "type": "item" }, { "type": "item" }, { "type": "item" }, { "type": "item" }]
    }
  ]
}
{% endschema %}
