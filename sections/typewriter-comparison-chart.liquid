    <div class="tw-compare__modalBackdrop" data-close="true" aria-hidden="true"></div>

    <div class="tw-compare__modalPanel" role="document">
      <div class="tw-compare__modalHeader">
        <div class="tw-compare__modalTitle" id="tw-compare-modal-title-{{ section.id }}">Side by side comparison</div>
        <button type="button" class="tw-compare__modalClose" data-close="true" aria-label="Close comparison">
          Close
        </button>
      </div>

