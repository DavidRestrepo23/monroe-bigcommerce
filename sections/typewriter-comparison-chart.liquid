{{ 'section-typewriter-comparison.css' | asset_url | stylesheet_tag }}
<script src="{{ 'section-typewriter-comparison.js' | asset_url }}" defer="defer"></script>

<typewriter-comparison-explorer
  id="twc-{{ section.id }}"
  class="twc-explorer"
  data-section-id="{{ section.id }}"
  data-compare-limit="3"
  aria-labelledby="twc-title-{{ section.id }}"
  style="--twc-accent: {{ section.settings.accent_color }}; --twc-paper: {{ section.settings.paper_color }}; --twc-ink: {{ section.settings.ink_color }};"
>
  <div class="twc-explorer__shell">
    {% render 'typewriter-comparison-content', section: section %}

    <div id="typewriter-finder-{{ section.id }}" class="twc-explorer__workspace">
      <aside class="twc-explorer__filters" aria-label="Filter typewriter models">
        {% render 'typewriter-comparison-controls', section: section %}
      </aside>

      <div id="typewriter-results-{{ section.id }}" class="twc-explorer__results">
        <div class="twc-explorer__results-bar">
          <div>
            <p class="twc-explorer__results-kicker">The model library</p>
            <h2>Explore and compare</h2>
            <p class="twc-explorer__status" data-results-status role="status" aria-live="polite">
              {{ section.settings.models.size }} models shown
            </p>
          </div>

          <label class="twc-explorer__sort" for="twc-sort-{{ section.id }}">
            <span>Sort by</span>
            <select id="twc-sort-{{ section.id }}" data-sort>
              <option value="default">Featured order</option>
              <option value="title">Model name, A to Z</option>
              <option value="price-asc">Price, low to high</option>
              <option value="weight-asc">Weight, low to high</option>
              <option value="paper-desc">Paper capacity, wide to narrow</option>
            </select>
          </label>
        </div>

        <div class="twc-explorer__grid" data-card-grid>
          {%- for product in section.settings.models -%}
            {% render 'typewriter-comparison-data', product: product, section: section %}
          {%- else -%}
            <div class="twc-explorer__editor-empty">
              Select the comparison products in this section's Theme Editor settings.
            </div>
          {%- endfor -%}
        </div>

        <div class="twc-explorer__empty" data-empty-state hidden>
          <span aria-hidden="true">No match</span>
          <h3>No typewriters fit every selected filter.</h3>
          <p>Remove one feature or reset the finder to see the complete model library.</p>
          <button type="button" class="twc-explorer__button twc-explorer__button--primary" data-reset-filters>Reset filters</button>
        </div>
      </div>
    </div>

    {% render 'typewriter-comparison-resources', section: section %}

    <aside id="typewriter-help-{{ section.id }}" class="twc-explorer__contact-card">
      <div>
        <p class="twc-explorer__contact-kicker">Still deciding?</p>
        <h2>Talk with someone who knows typewriters.</h2>
        <p>Tell us what you plan to type, how much desk space you have, and which features matter most. We can help narrow the list.</p>
      </div>
      <div class="twc-explorer__contact-actions">
        <a class="twc-explorer__button twc-explorer__button--primary" href="tel:{{ section.settings.phone_link | escape }}">Call {{ section.settings.phone_label | escape }}</a>
        <a class="twc-explorer__button twc-explorer__button--paper" href="mailto:{{ section.settings.email | escape }}">Email our team</a>
      </div>
    </aside>
  </div>

  <div class="twc-explorer__compare-bar" data-compare-bar hidden>
    <div class="twc-explorer__compare-bar-inner">
      <div>
        <strong><span data-selected-count>0</span> selected</strong>
        <span>Choose at least two models and up to 3.</span>
      </div>
      <div class="twc-explorer__selected-list" data-selected-list aria-label="Selected typewriters"></div>
      <div class="twc-explorer__compare-actions">
        <button type="button" class="twc-explorer__text-button" data-clear-comparison>Clear</button>
        <button type="button" class="twc-explorer__button twc-explorer__button--primary" data-open-comparison disabled>
          Compare selected
        </button>
      </div>
    </div>
  </div>

  <dialog class="twc-explorer__dialog" data-comparison-dialog aria-labelledby="twc-dialog-title-{{ section.id }}">
    <div class="twc-explorer__dialog-frame">
      <header class="twc-explorer__dialog-header">
        <div>
          <p class="twc-explorer__dialog-kicker">Your shortlist</p>
          <h2 id="twc-dialog-title-{{ section.id }}">Side-by-side comparison</h2>
        </div>
        <button type="button" class="twc-explorer__dialog-close" data-dialog-close aria-label="Close comparison">Close</button>
      </header>

      <div class="twc-explorer__dialog-tools">
        <label>
          <input type="checkbox" data-differences-only>
          Show differences only
        </label>
        <p>Specifications are based on the comparison information currently maintained for this page.</p>
      </div>

      <div class="twc-explorer__dialog-scroll">
        <div class="twc-explorer__dialog-columns" data-dialog-columns></div>
      </div>
    </div>
  </dialog>

  <p class="twc-explorer__announcement" data-announcement role="status" aria-live="polite"></p>
</typewriter-comparison-explorer>

{% schema %}
{
  "name": "Typewriter Comparison",
  "tag": "section",
  "class": "section-typewriter-comparison-explorer",
  "settings": [
    {
      "type": "header",
      "content": "Page content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Find the right typewriter for the way you work"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Introduction",
      "default": "<p>Search, filter, and compare electric and electronic typewriters by the specifications that matter to you. Select up to three models to build a focused side-by-side shortlist.</p>"
    },
    {
      "type": "text",
      "id": "support_text",
      "label": "Support message",
      "default": "Our team can help with product recommendations, compatibility questions, and ordering support."
    },
    {
      "type": "text",
      "id": "phone_label",
      "label": "Phone number label",
      "default": "(404) 377-1884"
    },
    {
      "type": "text",
      "id": "phone_link",
      "label": "Phone link",
      "default": "+14043771884"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Support email",
      "default": "info@typewriters.com"
    },
    {
      "type": "checkbox",
      "id": "enable_quick_add",
      "label": "Enable Quick Add",
      "default": true
    },
    {
      "type": "product_list",
      "id": "models",
      "label": "Model products",
      "limit": 30,
      "info": "Select models that are mapped in typewriter-comparison-data.liquid."
    },
    {
      "type": "header",
      "content": "Recommended supplies"
    },
    {
      "type": "product",
      "id": "ibm_ribbon",
      "label": "IBM ribbon"
    },
    {
      "type": "product",
      "id": "ibm_correction",
      "label": "IBM correction tape"
    },
    {
      "type": "product",
      "id": "portable_ribbon",
      "label": "Nakajima and Royal ribbon"
    },
    {
      "type": "product",
      "id": "portable_correction",
      "label": "Nakajima and Royal lift-off tape"
    },
    {
      "type": "header",
      "content": "Retro color palette"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Ribbon red",
      "default": "#c94b42"
    },
    {
      "type": "color",
      "id": "paper_color",
      "label": "Paper",
      "default": "#f5eedc"
    },
    {
      "type": "color",
      "id": "ink_color",
      "label": "Ink",
      "default": "#29251f"
    }
  ],
  "presets": [
    {
      "name": "Typewriter Comparison",
      "settings": {
        "models": [
          "/collections/ibm-lexmark-personal-wheelwriter-1-electric-typewriter-reconditioned",
          "ibm-lexmark-personal-wheelwriter-2-electric-typewriter-reconditioned",
          "ibm-lexmark-wheelwriter-3-electric-typewriter-reconditioned",
          "ibm-lexmark-wheelwriter-5-reconditioned",
          "ibm-lexmark-wheelwriter-6-electronic-typewriter-reconditioned",
          "ibm-lexmark-wheelwriter-6-series-ii-electric-typewriter-reconditioned",
          "ibm-lexmark-wheelwriter-10-electric-typewriter-reconditioned",
          "ibm-lexmark-wheelwriter-15-electronic-typewriter-reconditioned",
          "ibm-lexmark-wheelwriter-30-electric-typewriter-reconditioned",
          "ibm-lexmark-wheelwriter-35-electric-typewriter-reconditioned",
          "ibm-lexmark-wheelwriter-50-reconditioned",
          "ibm-lexmark-wheelwriter-70-reconditioned",
          "ibm-lexmark-wheelwriter-1000-electronic-typewriter-reconditioned",
          "ibm-lexmark-wheelwriter-1500-electronic-typewriter-reconditioned",
          "ibm-lexmark-wheelwriter-2000-electric-typewriter-reconditioned",
          "ibm-lexmark-wheelwriter-2500-electric-typewriter-reconditioned",
          "ibm-lexmark-wheelwriter-3000-electric-typewriter-reconditioned",
          "ibm-lexmark-wheelwriter-3500-electric-typewriter-reconditioned",
          "ibm-lexmark-wheelwriter-5000-reconditioned",
          "ibm-lexmark-wheelwriter-7000-reconditioned",
          "nakajima-wpt-150-portable-electronic-word-processing-typewriter",
          "nakajima-wpt-160-portable-electronic-word-processing-typewriter",
          "royal-scriptor",
          "royal-scriptor-ii-typewriter"
        ],
        "ibm_ribbon": "grc-compatible-ibm-wheelwriter-ink-ribbon-fits-all-ibm-wheelwriters",
        "ibm_correction": "grc-compatible-ibm-wheelwriter-correction-tape",
        "portable_ribbon": "nakajima-correctable-ribbon-for-wpt-150-and-wpt-160-typewriters",
        "portable_correction": "nakajima-lift-off-tape-2-000-characters-6-units-fits-wpt-150-wpt-160"
      }
    }
  ]
}
{% endschema %}