{% comment %}
  Typewriters.com scoped Typewriter Comparison Chart section for Shopify.
  Built only from the CSS, HTML, and JavaScript provided for this page.
  Styles and script are scoped to #tw-compare-{{ section.id }} so they do not affect other pages.
{% endcomment %}

<style>
/* =====================================================
   Typewriters.com Comparison Chart - Shopify Scoped Section
   All visible page styling is scoped to this section ID only.
   ===================================================== */
#tw-compare-{{ section.id }},
#tw-compare-{{ section.id }} *{
  box-sizing:border-box;
  font-family:Arial, Helvetica, sans-serif;
  color:#000000;
  font-size:18px;
}

#tw-compare-{{ section.id }}{
  --tw-accent:#d24742;
  --tw-border:#d24742;
  --tw-bg:#ffffff;
  --tw-soft:rgba(210,71,66,.08);
  line-height:1.6;
  width:90%;
  max-width:100%;
  overflow:visible;
}

#tw-compare-{{ section.id }} h2{
  font-size:40px;
  line-height:1.2;
  margin:0 0 18px;
  color:#000000;
}

#tw-compare-{{ section.id }} h3{
  font-size:25px;
  line-height:1.25;
  color:#000000;
}

#tw-compare-{{ section.id }} h4{
  font-size:20px;
  line-height:1.3;
  color:#000000;
}

#tw-compare-{{ section.id }} a{
  color:#000000;
  text-decoration:underline;
  text-underline-offset:3px;
}

#tw-compare-{{ section.id }} a:hover,
#tw-compare-{{ section.id }} a:focus{
  color:#000000;
  text-decoration-thickness:2px;
}

#tw-compare-{{ section.id }} button,
#tw-compare-{{ section.id }} input{
  font-family:Arial, Helvetica, sans-serif;
  color:#000000;
  font-size:18px;
}

#tw-compare-{{ section.id }} .tw-compare__bar{
  background:var(--tw-accent);
  height:35px;
  width:100%;
  margin:0 0 18px;
}

#tw-compare-{{ section.id }} .tw-compare__intro{
  margin:0 0 18px;
}

#tw-compare-{{ section.id }} .tw-compare__intro p{
  margin:0 0 16px;
}

#tw-compare-{{ section.id }} .tw-compare__title{
  text-align:center;
  text-decoration:none;
}

#tw-compare-{{ section.id }} .tw-sr-only{
  position:absolute;
  width:1px;
  height:1px;
  padding:0;
  margin:-1px;
  overflow:hidden;
  clip:rect(0,0,0,0);
  white-space:nowrap;
  border:0;
}

/* Controls */
#tw-compare-{{ section.id }} .tw-compare__controls{
  position:relative;
  isolation:isolate;
  border:3px solid var(--tw-border);
  padding:14px;
  margin:0 0 14px;
  background:#ffffff;
  overflow:visible;
}

#tw-compare-{{ section.id }} .tw-compare__controlsRow{
  display:grid;
  grid-template-columns:1fr;
  gap:14px;
  align-items:stretch;
  width:100%;
  height:auto;
  min-height:0;
  overflow:visible;
}

#tw-compare-{{ section.id }} .tw-compare__field{
  display:block;
  width:100%;
  max-width:100%;
  margin:0;
  overflow:visible;
}

#tw-compare-{{ section.id }} .tw-compare__fieldLabel{
  display:block;
  font-weight:700;
  margin:0 0 8px;
}

#tw-compare-{{ section.id }} .tw-compare__search{
  display:block;
  width:100%;
  max-width:100%;
  padding:12px 14px;
  border:2px solid var(--tw-border);
  border-radius:10px;
  background:#ffffff;
  outline:none;
}

#tw-compare-{{ section.id }} .tw-compare__search:focus{
  box-shadow:0 0 0 3px rgba(210,71,66,.18);
}

#tw-compare-{{ section.id }} .tw-compare__toggles,
#tw-compare-{{ section.id }} .tw-compare__brands,
#tw-compare-{{ section.id }} .tw-compare__trayActions{
  display:flex;
  flex-wrap:wrap;
  gap:10px;
  align-items:center;
}

#tw-compare-{{ section.id }} .tw-compare__toggles{
  width:100%;
  margin:0;
  padding:0;
  clear:both;
  float:none;
  overflow:visible;
}

#tw-compare-{{ section.id }} .tw-compare__toggle,
#tw-compare-{{ section.id }} .tw-compare__chip,
#tw-compare-{{ section.id }} .tw-compare__pick,
#tw-compare-{{ section.id }} .tw-compare__trayBtn,
#tw-compare-{{ section.id }} .tw-compare__modalClose{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  gap:8px;
  border:2px solid var(--tw-border);
  border-radius:999px;
  background:#ffffff;
  padding:8px 12px;
  line-height:1.2;
  cursor:pointer;
  text-decoration:none;
  user-select:none;
  position:static;
  float:none;
  transform:none;
}

#tw-compare-{{ section.id }} .tw-compare__toggleInput,
#tw-compare-{{ section.id }} .tw-compare__pickInput{
  width:18px;
  height:18px;
  margin:0;
  position:static;
}

#tw-compare-{{ section.id }} .tw-compare__brands{
  margin-top:14px;
}

#tw-compare-{{ section.id }} .tw-compare__chip[aria-pressed="true"],
#tw-compare-{{ section.id }} .tw-compare__trayBtn--primary{
  background:var(--tw-accent);
  color:#000000;
}

#tw-compare-{{ section.id }} .tw-compare__status{
  margin:12px 0 0;
}

/* Compare tray */
#tw-compare-{{ section.id }} .tw-compare__tray{
  position:sticky;
  top:0;
  z-index:5;
  background:#ffffff;
  border:3px solid var(--tw-border);
  margin:0 0 14px;
}

#tw-compare-{{ section.id }} .tw-compare__trayInner{
  display:grid;
  grid-template-columns:150px 1fr 260px;
  gap:14px;
  align-items:center;
  padding:14px;
}

#tw-compare-{{ section.id }} .tw-compare__trayTitle,
#tw-compare-{{ section.id }} .tw-compare__traySlotLabel,
#tw-compare-{{ section.id }} .tw-compare__modalKey,
#tw-compare-{{ section.id }} .tw-compare__modalHead{
  font-weight:700;
}

#tw-compare-{{ section.id }} .tw-compare__traySlots{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:10px;
}

#tw-compare-{{ section.id }} .tw-compare__traySlot{
  border:2px solid var(--tw-border);
  border-radius:12px;
  padding:10px;
  min-height:70px;
}

#tw-compare-{{ section.id }} .tw-compare__traySlotTop{
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:10px;
  margin:0 0 8px;
}

#tw-compare-{{ section.id }} .tw-compare__trayRemove{
  border:0;
  background:transparent;
  color:#000000;
  text-decoration:underline;
  cursor:pointer;
  padding:0;
}

#tw-compare-{{ section.id }} .tw-compare__trayBtn{
  border-radius:12px;
  padding:10px 14px;
}

#tw-compare-{{ section.id }} .tw-compare__trayBtn[disabled]{
  opacity:.55;
  cursor:not-allowed;
}

/* Table */
#tw-compare-{{ section.id }} .tw-compare__tablewrap{
  border:3px solid var(--tw-border);
  padding:12px;
  overflow-x:auto;
  overflow-y:hidden;
  -webkit-overflow-scrolling:touch;
  position:relative;
  max-width:100%;
}

#tw-compare-{{ section.id }} .tw-compare__tablewrap:focus{
  outline:3px solid rgba(210,71,66,.22);
  outline-offset:3px;
}

#tw-compare-{{ section.id }} .tw-compare__table{
  width:100%;
  min-width:1100px;
  border-collapse:collapse;
  background:#ffffff;
}

#tw-compare-{{ section.id }} .tw-compare__caption{
  text-align:center;
  padding:12px;
  font-weight:700;
  color:#000000;
}

#tw-compare-{{ section.id }} .tw-compare__table th,
#tw-compare-{{ section.id }} .tw-compare__table td{
  border:2px solid var(--tw-border);
  padding:10px;
  text-align:center;
  vertical-align:middle;
  background:#ffffff;
  color:#000000;
}

#tw-compare-{{ section.id }} .tw-compare__model{
  font-weight:700;
  position:relative;
}

#tw-compare-{{ section.id }} .tw-compare__image img{
  max-width:150px;
  height:auto;
}

#tw-compare-{{ section.id }} .tw-compare__group th{
  text-align:left;
  background:var(--tw-soft);
  font-weight:700;
}

@media (min-width:751px){
  #tw-compare-{{ section.id }} .tw-compare__table thead th{
    position:sticky;
    top:0;
    background:#ffffff;
    z-index:3;
  }
}

@media (hover:hover) and (min-width:751px){
  #tw-compare-{{ section.id }} .tw-compare__row:hover td,
  #tw-compare-{{ section.id }} .tw-compare__row:hover th[scope="row"],
  #tw-compare-{{ section.id }} .tw-compare__table td.tw-compare__cellActive,
  #tw-compare-{{ section.id }} .tw-compare__table th.tw-compare__cellActive{
    background:var(--tw-soft);
  }
}

#tw-compare-{{ section.id }} .tw-compare__pick{
  margin:10px auto 0;
  width:max-content;
}

#tw-compare-{{ section.id }} .tw-compare__row[data-selected="true"] td,
#tw-compare-{{ section.id }} .tw-compare__row[data-selected="true"] th[scope="row"]{
  background:var(--tw-soft);
}

/* Modal */
#tw-compare-{{ section.id }} .tw-compare__modal{
  position:fixed;
  inset:0;
  z-index:9999;
}

#tw-compare-{{ section.id }} .tw-compare__modalBackdrop{
  position:absolute;
  inset:0;
  background:rgba(0,0,0,.55);
}

#tw-compare-{{ section.id }} .tw-compare__modalPanel{
  position:relative;
  max-width:1100px;
  width:calc(100% - 24px);
  margin:24px auto;
  background:#ffffff;
  border-radius:16px;
  overflow:hidden;
  border:3px solid var(--tw-border);
  max-height:calc(100% - 48px);
  display:flex;
  flex-direction:column;
}

#tw-compare-{{ section.id }} .tw-compare__modalHeader{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:12px;
  padding:14px 16px;
  border-bottom:2px solid var(--tw-border);
}

#tw-compare-{{ section.id }} .tw-compare__modalTitle{
  font-weight:700;
}

#tw-compare-{{ section.id }} .tw-compare__modalClose{
  border-radius:12px;
}

#tw-compare-{{ section.id }} .tw-compare__modalBody{
  padding:14px 16px;
  overflow:auto;
}

#tw-compare-{{ section.id }} .tw-compare__modalGrid{
  display:grid;
  grid-template-columns:240px 1fr 1fr;
  border:2px solid var(--tw-border);
  border-radius:14px;
  overflow:hidden;
}

#tw-compare-{{ section.id }} .tw-compare__modalCell{
  border-right:2px solid var(--tw-border);
  border-bottom:2px solid var(--tw-border);
  padding:10px;
  line-height:1.35;
  background:#ffffff;
  color:#000000;
}

#tw-compare-{{ section.id }} .tw-compare__modalCell:nth-child(3n){
  border-right:0;
}

#tw-compare-{{ section.id }} .tw-compare__modalHead{
  background:var(--tw-soft);
}

@media (min-width:1400px){
  #tw-compare-{{ section.id }} .tw-compare__controlsRow{
    grid-template-columns:minmax(560px, 1fr) auto;
    align-items:end;
  }
}

@media (max-width:980px){
  #tw-compare-{{ section.id }} .tw-compare__trayInner{
    grid-template-columns:1fr;
  }

  #tw-compare-{{ section.id }} .tw-compare__trayActions{
    justify-content:flex-start;
  }
}

@media (max-width:750px){
  #tw-compare-{{ section.id }} .tw-compare__bar{
    height:24px;
  }

  #tw-compare-{{ section.id }} h2{
    font-size:40px;
  }

  #tw-compare-{{ section.id }} .tw-compare__tablewrap{
    padding:8px;
    overflow:hidden;
  }

  #tw-compare-{{ section.id }} .tw-compare__table{
    min-width:0;
  }

  #tw-compare-{{ section.id }} .tw-compare__table thead{
    display:none;
  }

  #tw-compare-{{ section.id }} .tw-compare__caption{
    display:block;
    padding:10px;
    text-align:left;
  }

  #tw-compare-{{ section.id }} .tw-compare__table,
  #tw-compare-{{ section.id }} .tw-compare__table tbody,
  #tw-compare-{{ section.id }} .tw-compare__table tr,
  #tw-compare-{{ section.id }} .tw-compare__table td,
  #tw-compare-{{ section.id }} .tw-compare__table th{
    display:block;
    width:100%;
  }

  #tw-compare-{{ section.id }} .tw-compare__group th{
    border:0;
    padding:16px 0 8px;
  }

  #tw-compare-{{ section.id }} .tw-compare__row{
    border:3px solid var(--tw-border);
    margin:12px 0;
    padding:12px;
    background:#ffffff;
  }

  #tw-compare-{{ section.id }} .tw-compare__table td,
  #tw-compare-{{ section.id }} .tw-compare__table th[scope="row"]{
    border:0;
    text-align:left;
    padding:8px 0 10px;
  }

  #tw-compare-{{ section.id }} .tw-compare__image{
    padding-bottom:10px;
  }

  #tw-compare-{{ section.id }} .tw-compare__image img{
    max-width:100%;
  }

  #tw-compare-{{ section.id }} .tw-compare__table td[data-label],
  #tw-compare-{{ section.id }} .tw-compare__table th[data-label]{
    display:grid;
    grid-template-columns:minmax(120px,170px) minmax(0,1fr);
    gap:12px;
    align-items:start;
  }

  #tw-compare-{{ section.id }} .tw-compare__table td[data-label]::before,
  #tw-compare-{{ section.id }} .tw-compare__table th[data-label]::before{
    content:attr(data-label);
    font-weight:700;
  }

  #tw-compare-{{ section.id }} .tw-compare__row a{
    overflow-wrap:anywhere;
    word-break:break-word;
  }

  #tw-compare-{{ section.id }} .tw-compare__tray{
    position:static;
  }

  #tw-compare-{{ section.id }} .tw-compare__traySlots{
    grid-template-columns:1fr;
  }

  #tw-compare-{{ section.id }} .tw-compare__modalGrid{
    grid-template-columns:1fr;
  }

  #tw-compare-{{ section.id }} .tw-compare__modalCell{
    border-right:0;
  }
}
</style>

<section id="tw-compare-{{ section.id }}" class="tw-compare" aria-labelledby="tw-compare-title-{{ section.id }}">
  <div class="tw-compare__bar" aria-hidden="true"></div>

  <div class="tw-compare__intro">
    <p>
      Choosing the right typewriter does not have to be complicated. Our <strong>Typewriter Comparison Chart</strong> makes it easy to compare typewriter models side by side, helping you quickly evaluate key features, specifications, and functionality across a wide range of electric and electronic typewriters we offer.
    </p>
    <p>
      At Typewriters.com, we know that every user has different needs, whether you are purchasing a typewriter for an office, school, legal work, or personal use. This detailed comparison chart is designed to help you find the best typewriter for your specific requirements by clearly outlining important features such as paper capacity, display type, memory, correction options, battery backup, dimensions, and recommended supplies. Our selection includes trusted brands like IBM, Nakajima, Royal, and Brother, all known for their reliability, build quality, and long-term performance.
    </p>
    <p class="tw-compare__contact">
      If you need help selecting the right model or have questions about any typewriter listed in this comparison chart, our experienced customer support team is here to help. You can contact us via live chat, email us at
      <a class="tw-compare__link" href="mailto:info@typewriters.com" title="Typewriters.com Customer Service Email Address">info@typewriters.com</a>,
      or directly by phone at
      <a class="tw-compare__link" href="tel:+14043771884" title="Typewriters.com Customer Service Phone Number">(404) 377-1884</a>.
      Our team is available Monday through Friday from 8 AM to 5 PM ET and is happy to assist with product recommendations, compatibility questions, and ordering support.
    </p>
  </div>

  <h2 id="tw-compare-title-{{ section.id }}" class="tw-compare__title">Our Typewriter Comparison Chart</h2>

  <!-- Accessibility helper -->
  <p id="tw-compare-help-{{ section.id }}" class="tw-sr-only">
    This comparison table scrolls horizontally on smaller screens. Use arrow keys or swipe to view more columns.
  </p>

  <!-- Controls -->
  <div class="tw-compare__controls" role="region" aria-label="Comparison chart controls">
    <div class="tw-compare__controlsRow">
      <label class="tw-compare__field">
        <span class="tw-compare__fieldLabel">Search models</span>
        <input class="tw-compare__search" type="search" placeholder="Search by model name" autocomplete="off" />
      </label>

      <div class="tw-compare__toggles" aria-label="Feature filters">
        <label class="tw-compare__toggle">
          <input type="checkbox" class="tw-compare__toggleInput" data-filter="Spell Check" aria-controls="tw-compare-table-{{ section.id }}" />
          <span>Spell Check</span>
        </label>
        <label class="tw-compare__toggle">
          <input type="checkbox" class="tw-compare__toggleInput" data-filter="Battery Backup" aria-controls="tw-compare-table-{{ section.id }}" />
          <span>Battery Backup</span>
        </label>
        <label class="tw-compare__toggle">
          <input type="checkbox" class="tw-compare__toggleInput" data-filter="Bold" aria-controls="tw-compare-table-{{ section.id }}" />
          <span>Bold</span>
        </label>
      </div>
    </div>

    <div class="tw-compare__brands" role="group" aria-label="Brand filters">
      <!-- JS injects brand chips here -->
    </div>

    <p class="tw-compare__status" role="status" aria-live="polite"></p>
  </div>

  <!-- Compare tray -->
  <div class="tw-compare__tray" role="region" aria-label="Selected models for comparison" hidden>
    <div class="tw-compare__trayInner">
      <div class="tw-compare__trayTitle">Compare (up to 2)</div>

      <div class="tw-compare__traySlots" aria-label="Selected models">
        <div class="tw-compare__traySlot" data-slot="0" aria-label="Selected model 1">
          <div class="tw-compare__traySlotTop">
            <span class="tw-compare__traySlotLabel">Model 1</span>
            <button type="button" class="tw-compare__trayRemove" data-remove="0" aria-label="Remove model 1">Remove</button>
          </div>
          <div class="tw-compare__trayName">None selected</div>
        </div>

        <div class="tw-compare__traySlot" data-slot="1" aria-label="Selected model 2">
          <div class="tw-compare__traySlotTop">
            <span class="tw-compare__traySlotLabel">Model 2</span>
            <button type="button" class="tw-compare__trayRemove" data-remove="1" aria-label="Remove model 2">Remove</button>
          </div>
          <div class="tw-compare__trayName">None selected</div>
        </div>
      </div>

      <div class="tw-compare__trayActions">
        <button type="button" class="tw-compare__trayBtn tw-compare__trayBtn--primary" data-action="view" disabled>
          View side by side
        </button>
        <button type="button" class="tw-compare__trayBtn" data-action="clear">
          Clear
        </button>
      </div>
    </div>
  </div>

  <!-- Table -->
  <div
    class="tw-compare__tablewrap"
    role="region"
    aria-label="Typewriter feature comparison table"
    aria-describedby="tw-compare-help-{{ section.id }}"
    tabindex="0"
  >
    <table id="tw-compare-table-{{ section.id }}" class="tw-compare__table">
      <caption class="tw-compare__caption">
        Compare typewriter features by model, including paper capacity, display, memory, correction memory, battery backup, bold,
        spell check, dimensions, weight, warranty, and recommended supplies.
      </caption>

      <thead>
        <tr>
          <th scope="col">Image</th>
          <th scope="col">Model</th>
          <th scope="col">Paper Capacity</th>
          <th scope="col">Display</th>
          <th scope="col">Memory</th>
          <th scope="col">Correction Memory</th>
          <th scope="col">Battery Backup</th>
          <th scope="col">Bold</th>
          <th scope="col">Spell Check</th>
          <th scope="col">Dimensions</th>
          <th scope="col">Weight</th>
          <th scope="col">Warranty</th>
          <th scope="col">Recommended Supplies</th>
        </tr>
      </thead>

      <tbody>
        <!-- IBM -->
        <tr class="tw-compare__group">
          <th scope="rowgroup" colspan="13">IBM</th>
        </tr>

        <!-- Personal Wheelwriter 1 -->
        <tr class="tw-compare__row">
          <td class="tw-compare__image" data-label="Image">
            <a href="/typewriters/ibm-lexmark-personal-wheelwriter-1-electric-typewriter-reconditioned/" target="_blank" rel="noopener" title="IBM Personal Wheelwriter 1">
              <img src="https://cdn11.bigcommerce.com/s-r2o17ymkxr/images/stencil/original/image-manager/ibm-wheelwriter-1-cutout.png?t=1685628043" alt="IBM Wheelwriter 1 electric typewriter" width="150" height="79" loading="lazy" decoding="async" />
            </a>
          </td>
          <th scope="row" class="tw-compare__model" data-label="Model">
            <a href="/typewriters/ibm-lexmark-personal-wheelwriter-1-electric-typewriter-reconditioned/" target="_blank" rel="noopener">Personal Wheelwriter 1</a>
          </th>
          <td data-label="Paper Capacity">14.75 in</td>
          <td data-label="Display">No</td>
          <td data-label="Memory">No</td>
          <td data-label="Correction Memory">1 line</td>
          <td data-label="Battery Backup">No</td>
          <td data-label="Bold">Yes</td>
          <td data-label="Spell Check">No</td>
          <td data-label="Dimensions">5.7 in H x 19.1 in W x 17.1 in D</td>
          <td data-label="Weight">23 lb</td>
          <td data-label="Warranty">3 months</td>
          <td data-label="Recommended Supplies">
            <a href="/supplies/ibm-wheelwriter-3-5-ink-ribbon/" target="_blank" rel="noopener">T340 Ribbon</a><br />
            <a href="/supplies/ibm-wheelwriter-correction-tape/" target="_blank" rel="noopener">T350 Correction Tape</a>
          </td>
        </tr>

        <!-- Personal Wheelwriter 2 -->
        <tr class="tw-compare__row">
          <td class="tw-compare__image" data-label="Image">
            <a href="/new-and-reconditioned-typewriters/ibm-lexmark-personal-wheelwriter-2-electric-typewriter-reconditioned-/" target="_blank" rel="noopener" title="IBM Personal Wheelwriter 2">
              <img src="https://cdn11.bigcommerce.com/s-r2o17ymkxr/images/stencil/original/image-manager/ibm-wheelwriter-2-cutout.png?t=1685628246" alt="IBM Wheelwriter 2 electric typewriter" width="150" height="79" loading="lazy" decoding="async" />
            </a>
          </td>
          <th scope="row" class="tw-compare__model" data-label="Model">
            <a href="/new-and-reconditioned-typewriters/ibm-lexmark-personal-wheelwriter-2-electric-typewriter-reconditioned-/" target="_blank" rel="noopener">Personal Wheelwriter 2</a>
          </th>
          <td data-label="Paper Capacity">14.75 in</td>
          <td data-label="Display">No</td>
          <td data-label="Memory">No</td>
          <td data-label="Correction Memory">1K</td>
          <td data-label="Battery Backup">Yes</td>
          <td data-label="Bold">Yes</td>
          <td data-label="Spell Check">Yes</td>
          <td data-label="Dimensions">5.63 in H x 19.13 in W x 17.09 in D</td>
          <td data-label="Weight">24 lb</td>
          <td data-label="Warranty">3 months</td>
