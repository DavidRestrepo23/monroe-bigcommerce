<script>
(function () {
  function normalize(v) {
    return String(v || "").trim().toLowerCase();
  }

  function esc(value) {
    return String(value || "")
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#039;");
  }

  function safeHref(value) {
    var href = String(value || "").trim();
    if (!href) return "#";
    if (/^(https?:)?\/\//i.test(href) || href.charAt(0) === "/" || href.charAt(0) === "#" || href.indexOf("mailto:") === 0 || href.indexOf("tel:") === 0) {
      return href.replace(/"/g, "&quot;");
    }
    return "#";
  }

  function isYes(value) {
    var v = normalize(value);
    return v === "yes" || v === "true" || v === "y";
  }

  function getCellText(row, label) {
    var td = row.querySelector('td[data-label="' + label + '"]');
    if (!td) return "";
    return (td.textContent || "").trim();
  }

  function getModelName(row) {
    var modelTh = row.querySelector(".tw-compare__model");
    if (!modelTh) return "";
    var modelLink = modelTh.querySelector("a");
    if (modelLink) return (modelLink.textContent || "").trim();
    var clone = modelTh.cloneNode(true);
    var pick = clone.querySelector(".tw-compare__pick");
    if (pick && pick.parentNode) pick.parentNode.removeChild(pick);
    return (clone.textContent || "").trim();
  }

  function getModelLink(row) {
    var a = row.querySelector(".tw-compare__model a");
    return a ? a.getAttribute("href") : "";
  }

  function getModelImage(row) {
    var img = row.querySelector(".tw-compare__image img");
    if (!img) return { src: "", alt: "" };
    return { src: img.getAttribute("src") || "", alt: img.getAttribute("alt") || "" };
  }

  function setHidden(el, hidden) {
    if (!el) return;
    if (hidden) el.setAttribute("hidden", "");
    else el.removeAttribute("hidden");
  }

  function initTypewriterComparison(root) {
    if (!root || root.getAttribute("data-tw-compare-ready") === "true") return;
    root.setAttribute("data-tw-compare-ready", "true");

    var table = root.querySelector(".tw-compare__table");
    var tbody = table ? table.querySelector("tbody") : null;
    if (!tbody) return;

    var searchInput = root.querySelector(".tw-compare__search");
    var toggleInputs = Array.prototype.slice.call(root.querySelectorAll(".tw-compare__toggleInput"));
    var brandsWrap = root.querySelector(".tw-compare__brands");
    var status = root.querySelector(".tw-compare__status");

    var tray = root.querySelector(".tw-compare__tray");
    var traySlots = Array.prototype.slice.call(root.querySelectorAll(".tw-compare__traySlot"));
    var trayRemoves = Array.prototype.slice.call(root.querySelectorAll(".tw-compare__trayRemove"));
    var trayViewBtn = root.querySelector('.tw-compare__trayBtn[data-action="view"]');
    var trayClearBtn = root.querySelector('.tw-compare__trayBtn[data-action="clear"]');

    var modal = root.querySelector(".tw-compare__modal");
    var modalGrid = root.querySelector(".tw-compare__modalGrid");
    var modalCloseBtn = root.querySelector(".tw-compare__modalClose");

    var rows = Array.prototype.slice.call(tbody.querySelectorAll("tr"));
    var modelRows = [];
    var currentBrand = "";
    var brandSet = [];

    function addBrand(brand) {
      if (brand && brandSet.indexOf(brand) === -1) brandSet.push(brand);
    }

    rows.forEach(function (tr) {
      if (tr.classList.contains("tw-compare__group")) {
        var th = tr.querySelector("th");
        currentBrand = th ? th.textContent.trim() : "";
        addBrand(currentBrand);
        tr.dataset.brandGroup = currentBrand;
        return;
      }
      if (tr.classList.contains("tw-compare__row")) {
        tr.dataset.brand = currentBrand;
        modelRows.push(tr);
      }
    });

    function setStatus(visibleCount, totalCount) {
      if (!status) return;
      status.textContent = visibleCount + " of " + totalCount + " models shown";
    }

    var activeBrand = "__all__";

    function buildBrandChips() {
      if (!brandsWrap) return;
      brandsWrap.innerHTML = "";

      function addChip(label, value, pressed) {
        var btn = document.createElement("button");
        btn.type = "button";
        btn.className = "tw-compare__chip";
        btn.textContent = label;
        btn.setAttribute("aria-pressed", pressed ? "true" : "false");
        btn.dataset.brandValue = value;
        brandsWrap.appendChild(btn);
      }

      addChip("All brands", "__all__", true);

      brandSet.sort().forEach(function (b) {
        addChip(b, b, false);
      });
    }

    buildBrandChips();

    var selected = [];
    var lastFocusEl = null;

    function ensurePickUI(row) {
      var modelTh = row.querySelector(".tw-compare__model");
      if (!modelTh) return;
      if (modelTh.querySelector(".tw-compare__pick")) return;

      var label = document.createElement("label");
      label.className = "tw-compare__pick";
      label.setAttribute("title", "Select this model to compare");

      var input = document.createElement("input");
      input.type = "checkbox";
      input.className = "tw-compare__pickInput";
      input.setAttribute("aria-controls", "tw-compare-table-{{ section.id }}");

      var span = document.createElement("span");
      span.textContent = "Compare";

      label.appendChild(input);
      label.appendChild(span);
      modelTh.appendChild(label);

      input.addEventListener("change", function () {
        var id = row.dataset.rowId;
        var idx = selected.indexOf(id);

        if (input.checked) {
          if (selected.length >= 2) {
            input.checked = false;
            return;
          }
          if (idx === -1) selected.push(id);
        } else {
          if (idx !== -1) selected.splice(idx, 1);
        }
        syncSelectionState();
      });
    }

    modelRows.forEach(function (row, i) {
      row.dataset.rowId = "twc_{{ section.id }}_" + i;
      ensurePickUI(row);
    });

    function getRowById(id) {
      for (var i = 0; i < modelRows.length; i++) {
        if (modelRows[i].dataset.rowId === id) return modelRows[i];
      }
      return null;
    }

    function syncSelectionState() {
      modelRows.forEach(function (row) {
        var id = row.dataset.rowId;
        var checked = selected.indexOf(id) !== -1;
        row.dataset.selected = checked ? "true" : "false";
        var input = row.querySelector(".tw-compare__pickInput");
        if (input) input.checked = checked;
      });
      updateTray();
    }

    function updateTray() {
      var hasAny = selected.length > 0;
      setHidden(tray, !hasAny);

      traySlots.forEach(function (slot, idx) {
        var id = selected[idx];
        var nameEl = slot.querySelector(".tw-compare__trayName");
        var removeBtn = slot.querySelector(".tw-compare__trayRemove");

        if (!id) {
          if (nameEl) nameEl.textContent = "None selected";
          if (removeBtn) removeBtn.style.visibility = "hidden";
          return;
        }

        var row = getRowById(id);
        var name = row ? getModelName(row) : "Selected model";
        if (nameEl) nameEl.textContent = name;
        if (removeBtn) removeBtn.style.visibility = "visible";
      });

      if (trayViewBtn) trayViewBtn.disabled = selected.length !== 2;
    }

    trayRemoves.forEach(function (btn) {
      btn.addEventListener("click", function () {
        var slotIndex = parseInt(btn.getAttribute("data-remove"), 10);
        if (isNaN(slotIndex)) return;

        var id = selected[slotIndex];
        if (!id) return;

        selected = selected.filter(function (x) { return x !== id; });
        syncSelectionState();
      });
    });

    if (trayClearBtn) {
      trayClearBtn.addEventListener("click", function () {
        selected = [];
        syncSelectionState();
      });
    }

    function openModal() {
      if (!modal) return;
      lastFocusEl = document.activeElement;
      setHidden(modal, false);
      document.body.style.overflow = "hidden";
      renderComparison();

      if (modalCloseBtn) {
        setTimeout(function () { modalCloseBtn.focus(); }, 0);
      }
    }

    function closeModal() {
      if (!modal) return;
      setHidden(modal, true);
      document.body.style.overflow = "";
      if (lastFocusEl && typeof lastFocusEl.focus === "function") {
        setTimeout(function () { lastFocusEl.focus(); }, 0);
      }
    }

    if (trayViewBtn) {
      trayViewBtn.addEventListener("click", function () {
        if (selected.length !== 2) return;
        openModal();
      });
    }

    if (modal) {
      modal.addEventListener("click", function (e) {
        var close = e.target && e.target.getAttribute && e.target.getAttribute("data-close");
        if (close === "true") closeModal();
      });

      document.addEventListener("keydown", function (e) {
        if (modal.hasAttribute("hidden")) return;
        if (e.key === "Escape") closeModal();
      });
    }

    function renderComparison() {
      if (!modalGrid || selected.length !== 2) return;

      var rowA = getRowById(selected[0]);
      var rowB = getRowById(selected[1]);
      if (!rowA || !rowB) return;

      var labels = [
        "Brand",
        "Model",
        "Paper Capacity",
        "Display",
        "Memory",
        "Correction Memory",
        "Battery Backup",
        "Bold",
        "Spell Check",
        "Dimensions",
        "Weight",
        "Warranty",
        "Recommended Supplies"
      ];

      var nameA = getModelName(rowA);
      var nameB = getModelName(rowB);
      var linkA = getModelLink(rowA);
      var linkB = getModelLink(rowB);
      var imgA = getModelImage(rowA);
      var imgB = getModelImage(rowB);

      function cell(html, cls) {
        var d = document.createElement("div");
        d.className = "tw-compare__modalCell" + (cls ? " " + cls : "");
        d.innerHTML = html;
        return d;
      }

      modalGrid.innerHTML = "";

      modalGrid.appendChild(cell("Feature", "tw-compare__modalHead"));
      modalGrid.appendChild(cell(
        '<a class="tw-compare__modalLink" href="' + safeHref(linkA) + '" target="_blank" rel="noopener">' + esc(nameA) + '</a><br />' +
        (imgA.src ? '<img src="' + safeHref(imgA.src) + '" alt="' + esc(imgA.alt || "") + '" style="max-width:160px; height:auto; margin-top:8px;" />' : ""),
        "tw-compare__modalHead"
      ));
      modalGrid.appendChild(cell(
        '<a class="tw-compare__modalLink" href="' + safeHref(linkB) + '" target="_blank" rel="noopener">' + esc(nameB) + '</a><br />' +
        (imgB.src ? '<img src="' + safeHref(imgB.src) + '" alt="' + esc(imgB.alt || "") + '" style="max-width:160px; height:auto; margin-top:8px;" />' : ""),
        "tw-compare__modalHead"
      ));

      labels.forEach(function (label) {
        if (label === "Brand") {
          modalGrid.appendChild(cell('<span class="tw-compare__modalKey">Brand</span>'));
          modalGrid.appendChild(cell(esc(rowA.dataset.brand || "")));
          modalGrid.appendChild(cell(esc(rowB.dataset.brand || "")));
          return;
        }

        if (label === "Model") {
          modalGrid.appendChild(cell('<span class="tw-compare__modalKey">Model</span>'));
          modalGrid.appendChild(cell('<a class="tw-compare__modalLink" href="' + safeHref(linkA) + '" target="_blank" rel="noopener">' + esc(nameA) + "</a>"));
          modalGrid.appendChild(cell('<a class="tw-compare__modalLink" href="' + safeHref(linkB) + '" target="_blank" rel="noopener">' + esc(nameB) + "</a>"));
          return;
        }

        var valA = getCellText(rowA, label);
        var valB = getCellText(rowB, label);

        modalGrid.appendChild(cell('<span class="tw-compare__modalKey">' + esc(label) + "</span>"));
        modalGrid.appendChild(cell(esc(valA || "")));
        modalGrid.appendChild(cell(esc(valB || "")));
      });
    }

    function applyFilters() {
      var q = searchInput ? normalize(searchInput.value) : "";
      var activeToggles = toggleInputs
        .filter(function (i) { return i && i.checked; })
        .map(function (i) { return i.getAttribute("data-filter"); });

      var shown = 0;

      modelRows.forEach(function (tr) {
        var modelText = normalize(getModelName(tr));
        var brandOk = (activeBrand === "__all__") || (tr.dataset.brand === activeBrand);
        var searchOk = !q || modelText.indexOf(q) !== -1;

        var togglesOk = true;
        for (var i = 0; i < activeToggles.length; i++) {
          var label = activeToggles[i];
          var value = getCellText(tr, label);
          if (!isYes(value)) {
            togglesOk = false;
            break;
          }
        }

        var visible = brandOk && searchOk && togglesOk;
        tr.style.display = visible ? "" : "none";
        if (visible) shown++;
      });

      setStatus(shown, modelRows.length);

      rows.forEach(function (tr) {
        if (!tr.classList.contains("tw-compare__group")) return;
        var groupBrand = tr.dataset.brandGroup || "";
        if (!groupBrand) return;

        var anyVisible = modelRows.some(function (r) {
          return r.dataset.brand === groupBrand && r.style.display !== "none";
        });

        tr.style.display = anyVisible ? "" : "none";
      });
    }

    if (searchInput) searchInput.addEventListener("input", applyFilters);
    toggleInputs.forEach(function (i) { i.addEventListener("change", applyFilters); });

    if (brandsWrap) {
      brandsWrap.addEventListener("click", function (e) {
        var btn = e.target && e.target.closest ? e.target.closest(".tw-compare__chip") : null;
        if (!btn) return;

        activeBrand = btn.dataset.brandValue || "__all__";

        Array.prototype.slice.call(brandsWrap.querySelectorAll(".tw-compare__chip")).forEach(function (b) {
          b.setAttribute("aria-pressed", b === btn ? "true" : "false");
        });

        applyFilters();
      });
    }

    var thead = table.querySelector("thead");
    if (thead) {
      thead.addEventListener("mouseover", function (e) {
        var th = e.target && e.target.closest ? e.target.closest("th") : null;
        if (!th) return;

        var index = Array.prototype.indexOf.call(th.parentNode.children, th);
        if (index < 0) return;

        Array.prototype.slice.call(table.querySelectorAll("tr")).forEach(function (tr) {
          var cells = tr.children;
          if (!cells || !cells[index]) return;
          cells[index].classList.add("tw-compare__cellActive");
        });
      });

      thead.addEventListener("mouseout", function () {
        Array.prototype.slice.call(table.querySelectorAll(".tw-compare__cellActive")).forEach(function (c) {
          c.classList.remove("tw-compare__cellActive");
        });
      });
    }

    applyFilters();
    syncSelectionState();
  }

  function bootTypewriterComparison() {
    initTypewriterComparison(document.getElementById("tw-compare-{{ section.id }}"));
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", bootTypewriterComparison);
  } else {
    bootTypewriterComparison();
  }

  document.addEventListener("shopify:section:load", function (event) {
    var loadedRoot = event.target && event.target.querySelector ? event.target.querySelector("#tw-compare-{{ section.id }}") : null;
    initTypewriterComparison(loadedRoot);
  });
})();
</script>


