{{ 'template-collection.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign sort_by = search.sort_by | default: search.default_sort_by
-%}

{%- style -%}
  #MainSearch-{{ section.id }} {
    --cg-columns: 4;
    --cg-pad-top: 36px;
    --cg-pad-bottom: 36px;
    --cg-accent: #d24742;
    --cg-accent-hover: #b83d38;
  }
  @media (max-width: 749px) {
    #MainSearch-{{ section.id }} {
      --cg-columns: 2;
    }
  }
{%- endstyle -%}

{%- paginate search.results by 24 -%}

<section id="MainSearch-{{ section.id }}" class="collection-grid">
  <div class="collection-grid__container">

    {%- if search.performed -%}

      <div class="collection-grid__layout{% if search.filters == empty %} collection-grid__layout--no-sidebar{% endif %}">

        {%- unless search.filters == empty -%}
          <div class="collection-grid__sidebar">
            {%- render 'simple-facets', results: search, heading: 'Refine By' -%}
          </div>
        {%- endunless -%}

        <div class="collection-grid__main">

          <div class="collection-grid__header">
            <div class="collection-grid__heading-wrap">
              {%- if search.results_count == 0 -%}
                <h1 class="collection-grid__heading">No results for &ldquo;{{ search.terms | escape }}&rdquo;</h1>
              {%- elsif search.results_count == 1 -%}
                <h1 class="collection-grid__heading">1 result for &ldquo;{{ search.terms | escape }}&rdquo;</h1>
              {%- else -%}
                <h1 class="collection-grid__heading">{{ search.results_count }} results for &ldquo;{{ search.terms | escape }}&rdquo;</h1>
              {%- endif -%}
              {%- if search.results_count > 0 -%}
                <span class="collection-grid__count">
                  Showing {{ paginate.current_offset | plus: 1 }}&ndash;{{ paginate.current_offset | plus: paginate.page_size | at_most: search.results_count }}
                </span>
              {%- endif -%}
            </div>

            {%- if search.results_count > 0 -%}
              <div class="collection-grid__controls">
                <div class="collection-grid__sort">
                  <label for="SearchSortBy-{{ section.id }}" class="collection-grid__sort-label">Sort by</label>
                  <select
                    id="SearchSortBy-{{ section.id }}"
                    class="collection-grid__sort-select"
                    data-main-search-sort
                  >
                    {%- for option in search.sort_options -%}
                      <option value="{{ option.value | escape }}" {% if option.value == sort_by %}selected{% endif %}>
                        {{ option.name | escape }}
                      </option>
                    {%- endfor -%}
                  </select>
                </div>
              </div>
            {%- endif -%}
          </div>

          {%- if search.results_count > 0 -%}

            <ul class="collection-grid__list list-unstyled" role="list">
              {%- for item in search.results -%}
                {%- if item.object_type == 'product' -%}
                  <li class="collection-grid__item">
                    {%- render 'product-card', product: item -%}
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>

            {%- if paginate.pages > 1 -%}
              <nav class="collection-grid__pagination" role="navigation" aria-label="Pagination">
                <ul class="collection-grid__pagination-list list-unstyled" role="list">
                  {%- if paginate.previous -%}
                    <li>
                      <a href="{{ paginate.previous.url }}" class="collection-grid__pagination-arrow" aria-label="Previous page">&lsaquo;</a>
                    </li>
                  {%- endif -%}
                  {%- for part in paginate.parts -%}
                    <li>
                      {%- if part.is_link -%}
                        <a href="{{ part.url }}" class="collection-grid__pagination-item">{{ part.title }}</a>
                      {%- elsif part.title == paginate.current_page -%}
                        <span class="collection-grid__pagination-item collection-grid__pagination-item--current" aria-current="page">{{ part.title }}</span>
                      {%- else -%}
                        <span class="collection-grid__pagination-item collection-grid__pagination-item--disabled">{{ part.title }}</span>
                      {%- endif -%}
                    </li>
                  {%- endfor -%}
                  {%- if paginate.next -%}
                    <li>
                      <a href="{{ paginate.next.url }}" class="collection-grid__pagination-arrow" aria-label="Next page">&rsaquo;</a>
                    </li>
                  {%- endif -%}
                </ul>
              </nav>
            {%- endif -%}

          {%- else -%}

            <p class="collection-grid__empty">
              No products found for &ldquo;{{ search.terms | escape }}&rdquo;. Try a different search term or clear your filters.
            </p>

          {%- endif -%}

        </div>
      </div>

    {%- else -%}

      <div class="main-search-empty">
        <h1>Search</h1>
        <form action="{{ routes.search_url }}" method="get" role="search" class="main-search-empty__form">
          <input type="hidden" name="type" value="product">
          <div class="field">
            <input
              class="field__input"
              id="SearchPageInput-{{ section.id }}"
              type="search"
              name="q"
              value="{{ search.terms | escape }}"
              placeholder="Search products..."
              autocomplete="off"
            >
            <label class="field__label" for="SearchPageInput-{{ section.id }}">Search</label>
            <button type="submit" class="search__button field__button" aria-label="Search">
              {%- render 'icon-search' -%}
            </button>
          </div>
        </form>
      </div>

    {%- endif -%}

  </div>
</section>

{%- endpaginate -%}

<style>
  #MainSearch-{{ section.id }} .main-search-empty {
    max-width: 560px;
    margin: 0 auto;
    padding: 60px 0;
    text-align: center;
  }
  #MainSearch-{{ section.id }} .main-search-empty h1 {
    margin-bottom: 24px;
  }
</style>

<script>
  (function () {
    var sectionEl = document.getElementById('MainSearch-{{ section.id }}');
    if (!sectionEl) return;

    var facetForm = sectionEl.querySelector('.simple-facets__form');

    /* 1. Inject type=product so filter submissions stay product-only */
    if (facetForm && !facetForm.querySelector('[name="type"]')) {
      var typeInput = document.createElement('input');
      typeInput.type = 'hidden';
      typeInput.name = 'type';
      typeInput.value = 'product';
      facetForm.appendChild(typeInput);
    }

    /* 2. Fix "Clear all" link - simple-facets uses results.url which is
          undefined on the search object, so we patch it here */
    var clearLink = sectionEl.querySelector('.simple-facets__clear');
    if (clearLink) {
      clearLink.href = '/search?q={{ search.terms | url_encode }}&type=product';
    }

    /* 3. Auto-submit form on checkbox change */
    if (facetForm) {
      facetForm.querySelectorAll('input[type="checkbox"]').forEach(function (cb) {
        cb.addEventListener('change', function () { facetForm.submit(); });
      });
    }

    /* 4. Price slider - replicates paintSlider from collection grid JS,
          scoped to this section only so it can't conflict with collection pages */
    function fmtMoney(v) {
      return '$' + parseFloat(v).toFixed(2);
    }

    function paintSlider(slider) {
      if (!slider) return;
      var max = parseFloat(slider.dataset.max) || 1;
      var minInput = slider.querySelector('[data-role="min"]');
      var maxInput = slider.querySelector('[data-role="max"]');
      if (!minInput || !maxInput) return;
      var fill = slider.querySelector('.simple-facets__price-fill');
      var minLabel = slider.querySelector('.simple-facets__price-label--min');
      var maxLabel = slider.querySelector('.simple-facets__price-label--max');
      var gte = slider.querySelector('[data-role="gte"]');
      var lte = slider.querySelector('[data-role="lte"]');
      var lo = Math.min(parseFloat(minInput.value), parseFloat(maxInput.value));
      var hi = Math.max(parseFloat(minInput.value), parseFloat(maxInput.value));
      if (fill) {
        fill.style.left = (lo / max * 100) + '%';
        fill.style.right = (100 - hi / max * 100) + '%';
      }
      if (minLabel) minLabel.textContent = fmtMoney(lo);
      if (maxLabel) maxLabel.textContent = fmtMoney(hi);
      if (gte) gte.value = lo > 0 ? lo : '';
      if (lte) lte.value = hi < max ? hi : '';
    }

    sectionEl.addEventListener('input', function (e) {
      var slider = e.target.closest && e.target.closest('.simple-facets__price-slider');
      if (slider && e.target.matches('input[type="range"]')) paintSlider(slider);
    });

    sectionEl.addEventListener('change', function (e) {
      if (e.target.matches('.simple-facets__price-input')) {
        paintSlider(e.target.closest('.simple-facets__price-slider'));
        if (facetForm) facetForm.submit();
      }
    });

    /* 5. Sort select - updates URL preserving existing params */
    var sortSelect = sectionEl.querySelector('[data-main-search-sort]');
    if (sortSelect) {
      sortSelect.addEventListener('change', function () {
        var url = new URL(window.location.href);
        url.searchParams.set('sort_by', this.value);
        url.searchParams.delete('page');
        window.location.href = url.toString();
      });
    }

  })();
</script>