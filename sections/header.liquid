{{ 'component-header.css' | asset_url | stylesheet_tag }}
<script src="{{ 'predictive-search.js' | asset_url }}" defer></script>

<header class="site-header hide-mobile" role="banner">

  {%- comment -%} ======== TOP BAR ======== {%- endcomment -%}
  <div class="header__top-bar">

    {%- comment -%} Logo + store identity {%- endcomment -%}
    <a href="{{ routes.root_url }}" class="header__identity" aria-label="{{ shop.name }} — home">
      {%- if section.settings.logo != blank -%}
        <img
          class="header__logo-img"
          src="{{ section.settings.logo | image_url: width: 200 }}"
          alt="{{ shop.name }}"
          width="{{ section.settings.logo.width }}"
          height="{{ section.settings.logo.height }}"
          loading="eager"
        >
      {%- else -%}
        <span class="header__logo-placeholder">{{ shop.name }}</span>
      {%- endif -%}

      {%- if section.settings.store_name_image != blank or section.settings.store_tagline != blank -%}
        <div class="header__identity-divider" aria-hidden="true"></div>
        <div class="header__store-name-wrap">
          {%- if section.settings.store_name_image != blank -%}
            <img
              class="header__store-name-img"
              src="{{ section.settings.store_name_image | image_url: width: 300 }}"
              alt="{{ shop.name }}"
              width="{{ section.settings.store_name_image.width }}"
              height="{{ section.settings.store_name_image.height }}"
              loading="eager"
            >
          {%- endif -%}
          {%- if section.settings.store_tagline != blank -%}
            <span class="header__store-tagline">{{ section.settings.store_tagline }}</span>
          {%- endif -%}
        </div>
      {%- endif -%}
    </a>

    {%- comment -%} Search {%- endcomment -%}
    <div class="header__search-wrap">
      <predictive-search class="header__search" data-loading-text="{{ 'general.search.loading' | t | default: 'Loading...' }}">
        <form action="{{ routes.search_url }}" method="get" role="search" class="header__search-form" data-predictive-search-form>
          <button type="submit" class="header__search-btn header__search-btn--icon" aria-label="{{ 'general.search.search' | t | default: 'Search' }}">
            {% render 'icon-search' %}
          </button>
          <input
            class="header__search-input"
            type="search"
            name="q"
            placeholder="{{ 'general.search.placeholder' | t | default: 'Search...' }}"
            aria-label="{{ 'general.search.search' | t | default: 'Search' }}"
            aria-controls="predictive-search-results"
            aria-autocomplete="list"
            role="combobox"
            aria-expanded="false"
            autocomplete="off"
            spellcheck="false"
            data-predictive-search-input
          >
          <button type="button" class="header__search-clear" aria-label="Reset" hidden data-predictive-search-clear>
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
            </svg>
          </button>
        </form>

        <div
          id="predictive-search-results"
          class="header__search-results"
          role="listbox"
          aria-label="{{ 'general.search.search' | t | default: 'Search' }} results"
          hidden
          data-predictive-search-results
        >
          <div class="header__search-results-inner" data-predictive-search-content></div>
        </div>
      </predictive-search>
    </div>

    {%- comment -%} Right icons {%- endcomment -%}
    <div class="header__icons" role="navigation" aria-label="Utility navigation">

      {%- comment -%} Account {%- endcomment -%}
      <a href="{{ routes.account_url }}" class="header__icon-btn" aria-label="Account">
        {% render 'icon-account' %}
      </a>

      {%- comment -%} Wishlist (links to /pages/wishlist or custom) {%- endcomment -%}
      <a href="{{ section.settings.wishlist_url | default: '/pages/wishlist' }}" class="header__icon-btn" aria-label="Wishlist">
        {% render 'icon-heart' %}
      </a>

      {%- comment -%} Cart {%- endcomment -%}
      <a
        href="{{ routes.cart_url }}"
        id="cart-icon-bubble"
        class="header__icon-btn header__icon-btn--cart"
        aria-label="Cart ({{ cart.item_count }} items)"
      >
        {% render 'icon-cart' %}
        <span class="header__cart-badge" data-count="{{ cart.item_count }}" aria-hidden="true">
          {{ cart.item_count }}
        </span>
      </a>

    </div>
  </div>

  {%- comment -%} ======== NAVIGATION BAR ======== {%- endcomment -%}
  {%- if section.settings.menu != blank -%}
    {%- assign nav_menu = linklists[section.settings.menu] -%}
    {%- if nav_menu != blank -%}
      <nav class="header__nav-bar" role="navigation" aria-label="Main navigation">
        {%- for link in nav_menu.links -%}
          {%- if link.links != blank -%}
            {%- assign child_count = link.links.size -%}
            <details class="header__nav-item{% if child_count > 6 %} header__nav-item--wide{% endif %}">
              <summary class="header__nav-summary">
                {{ link.title }}
                <svg class="header__nav-caret" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                  <path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </summary>
              <div class="header__mega-dropdown{% if child_count > 6 %} header__mega-dropdown--wide{% endif %}">
                <p class="header__mega-category">{{ link.title }}</p>

                {%- assign has_collections = false -%}
                {%- for child in link.links -%}
                  {%- if child.type == 'collection_link' and child.object.image != blank -%}
                    {%- assign has_collections = true -%}
                    {%- break -%}
                  {%- endif -%}
                {%- endfor -%}

                <div class="header__mega-grid{% if child_count > 6 %} header__mega-grid--four-col{% elsif has_collections %} header__mega-grid--two-col{% endif %}">
                  {%- for child in link.links -%}
                    {%- capture mega_card_inner -%}
                      <div class="header__mega-card-inner">
                        {%- if child.type == 'collection_link' and child.object.image != blank -%}
                          <div class="header__mega-card-thumb">
                            <img
                              src="{{ child.object.image | image_url: width: 120 }}"
                              alt=""
                              width="60"
                              height="56"
                              loading="lazy"
                            >
                          </div>
                        {%- endif -%}
                        <div class="header__mega-card-text">
                          <span class="header__mega-card-title">{{ child.title }}</span>
                          {%- if child.type == 'collection_link' and child.object.description != blank -%}
                            <span class="header__mega-card-desc">{{ child.object.description | strip_html | truncate: 40 }}</span>
                          {%- endif -%}
                        </div>
                      </div>
                      <svg class="header__mega-card-chevron" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                        <path d="M7.5 4l5.5 6-5.5 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    {%- endcapture -%}

                    {%- if child.links != blank -%}
                      <details class="header__mega-card header__mega-card--group"{% if child.active %} open{% endif %}>
                        <summary class="header__mega-card-head">
                          {{ mega_card_inner }}
                        </summary>
                        <ul class="header__mega-sublist" role="list">
                          <li>
                            <a href="{{ child.url }}" class="header__mega-subitem header__mega-subitem--all"{% if child.active %} aria-current="page"{% endif %}>
                             <strong> See all {{ child.title }}</strong>
                            </a>
                          </li>
                          {%- for grandchild in child.links -%}
                            <li>  
                              <a href="{{ grandchild.url }}" class="header__mega-subitem"{% if grandchild.active %} aria-current="page"{% endif %}>
                                {{ grandchild.title }}
                              </a>
                            </li>
                          {%- endfor -%}
                        </ul>
                      </details>
                    {%- else -%}
                      <a href="{{ child.url }}" class="header__mega-card"{% if child.active %} aria-current="page"{% endif %}>
                        {{ mega_card_inner }}
                      </a>
                    {%- endif -%}
                  {%- endfor -%}
                </div>
              </div>
            </details>
          {%- else -%}
            <div class="header__nav-item">
              <a
                href="{{ link.url }}"
                class="header__nav-summary"
                {% if link.active %}aria-current="page"{% endif %}
              >
                {{ link.title }}
              </a>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </nav>
    {%- endif -%}
  {%- endif -%}

</header>


<script>
  // Close open <details> nav dropdowns when clicking outside
  document.addEventListener('click', function(e) {
    document.querySelectorAll('.header__nav-item[open]').forEach(function(el) {
      if (!el.contains(e.target)) el.removeAttribute('open');
    });
  });
</script>


{% schema %}
{
  "name": "Header",
  "class": "section-header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    },
    {
      "type": "image_picker",
      "id": "store_name_image",
      "label": "Store name image (beside logo)"
    },
    {
      "type": "text",
      "id": "store_tagline",
      "label": "Store tagline",
      "default": "your source for all things typewriters"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Navigation menu",
      "default": "main-menu"
    },
    {
      "type": "url",
      "id": "wishlist_url",
      "label": "Wishlist page URL"
    }
  ],
  "presets": [
    {
      "name": "Header"
    }
  ]
}
{% endschema %}
