{{ 'section-classic-cookie-spotlight.css' | asset_url | stylesheet_tag }}
<script src="{{ 'section-classic-cookie-spotlight.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign cookie_collection = section.settings.flavor_collection
  if cookie_collection == blank
    assign cookie_collection = collections['classic-cookie']
  endif

  assign variety_product = section.settings.variety_product
  if variety_product == blank
    assign variety_product = all_products['classic-cookie-soft-baked-variety-pack-48-individually-wrapped-cookies-3-oz-per-cookie']
  endif

  assign flavor_count = cookie_collection.products_count | default: cookie_collection.products.size
  assign logo_alt = section.settings.logo.alt | default: 'Classic Cookie logo'
  assign hero_alt = section.settings.hero_image.alt | default: section.settings.heading
  assign variety_alt = variety_product.featured_image.alt | default: variety_product.title
  assign phone_href = section.settings.phone | remove: '(' | remove: ')' | remove: '-' | remove: ' ' | prepend: 'tel:'
-%}

<section
  id="ClassicCookie-{{ section.id }}"
  class="ccb"
  data-ccb-section
  style="
    --ccb-accent: {{ section.settings.accent_color }};
    --ccb-accent-dark: {{ section.settings.accent_dark }};
    --ccb-cream: {{ section.settings.cream_color }};
    --ccb-ink: {{ section.settings.text_color }};
    --ccb-max-width: {{ section.settings.max_width }}px;
  "
  aria-labelledby="ClassicCookieTitle-{{ section.id }}"
>
  <div class="ccb__shell">
    <header class="ccb__hero">
      <div class="ccb__hero-copy">
        <div class="ccb__brand-row">
          {%- if section.settings.logo != blank -%}
            {{ section.settings.logo
              | image_url: width: 280
              | image_tag:
                class: 'ccb__logo',
                loading: 'eager',
                widths: '140, 210, 280',
                sizes: '140px',
                alt: logo_alt
            }}
          {%- else -%}
            <img
              class="ccb__logo"
              src="https://cdn.shopify.com/s/files/1/0653/0262/6407/files/classic-cookie-logo.png?v=1782936365"
              alt="Classic Cookie logo"
              width="160"
              height="160"
              loading="eager"
            >
          {%- endif -%}

          <div>
            {%- if section.settings.eyebrow != blank -%}
              <p class="ccb__eyebrow">{{ section.settings.eyebrow | escape }}</p>
            {%- endif -%}
            <p class="ccb__since">Soft-baked comfort since 1984</p>
          </div>
        </div>

        <h2 id="ClassicCookieTitle-{{ section.id }}" class="ccb__title">
          {{ section.settings.heading | escape }}
        </h2>

        <div class="ccb__intro rte">
          {{ section.settings.introduction }}
        </div>

        <div class="ccb__hero-actions">
          <a class="ccb__button ccb__button--primary" href="#ClassicCookieFlavors-{{ section.id }}">
            {{ section.settings.primary_button_label | escape }}
          </a>
          {%- if cookie_collection != blank -%}
            <a class="ccb__button ccb__button--secondary" href="{{ cookie_collection.url }}">
              {{ section.settings.secondary_button_label | escape }}
            </a>
          {%- endif -%}
        </div>

        <ul class="ccb__trust-list" role="list">
          <li><strong>3 oz.</strong><span>large cookies</span></li>
          <li><strong>Individually</strong><span>wrapped</span></li>
          <li><strong>Made in</strong><span>the USA</span></li>
          <li><strong>Family</strong><span>owned</span></li>
        </ul>
      </div>

      <div class="ccb__hero-visual" aria-label="Classic Cookie flavor assortment">
        {%- if section.settings.hero_image != blank -%}
          {{ section.settings.hero_image
            | image_url: width: 1400
            | image_tag:
              class: 'ccb__hero-image',
              loading: 'eager',
              widths: '600, 900, 1200, 1400',
              sizes: '(min-width: 990px) 46vw, 100vw',
              alt: hero_alt
          }}
        {%- elsif cookie_collection != blank and cookie_collection.products.size > 0 -%}
          <div class="ccb__cookie-collage" aria-hidden="true">
            {%- for product in cookie_collection.products limit: 4 -%}
              {%- assign collage_alt = product.featured_image.alt | default: product.title -%}
              <div class="ccb__collage-card ccb__collage-card--{{ forloop.index }}">
                {%- if product.featured_image != blank -%}
                  {{ product.featured_image
                    | image_url: width: 520
                    | image_tag:
                      loading: 'eager',
                      widths: '220, 360, 520',
                      sizes: '220px',
                      alt: collage_alt
                  }}
                {%- endif -%}
              </div>
            {%- endfor -%}
          </div>
        {%- else -%}
          <div class="ccb__hero-fallback">
            <span>Soft baked</span>
            <strong>Big cookies.<br>Classic comfort.</strong>
          </div>
        {%- endif -%}
      </div>
    </header>

    <section class="ccb__story" aria-labelledby="ClassicCookieStory-{{ section.id }}">
      <div class="ccb__section-heading ccb__section-heading--left">
        <p class="ccb__kicker">The Classic Cookie difference</p>
        <h3 id="ClassicCookieStory-{{ section.id }}">A bakery-style treat made for sharing</h3>
      </div>

      <div class="ccb__story-grid">
        <article class="ccb__story-card">
          <span class="ccb__story-number">01</span>
          <h4>Generously sized</h4>
          <p>Each soft-baked cookie weighs 3 ounces, creating a substantial snack for break rooms, lunches, events, and care packages.</p>
        </article>
        <article class="ccb__story-card">
          <span class="ccb__story-number">02</span>
          <h4>Ready to share</h4>
          <p>Individual wrapping makes the cookies easy to distribute while helping each serving stay protected until it is time to enjoy.</p>
        </article>
        <article class="ccb__story-card">
          <span class="ccb__story-number">03</span>
          <h4>Plenty of variety</h4>
          <p>From chocolate-forward favorites to cinnamon, fruit, nut, and celebration flavors, there is an option for nearly every craving.</p>
        </article>
      </div>
    </section>

    <section id="ClassicCookieFlavors-{{ section.id }}" class="ccb__flavors" aria-labelledby="ClassicCookieFlavorsTitle-{{ section.id }}">
      <div class="ccb__section-heading">
        <p class="ccb__kicker">Find your favorite</p>
        <h3 id="ClassicCookieFlavorsTitle-{{ section.id }}">
          Explore {{ flavor_count }} soft-baked flavors
        </h3>
        <p>Search by flavor or use the taste-profile filters to narrow the assortment.</p>
      </div>

      <div class="ccb__controls" role="search" aria-label="Search and filter Classic Cookie flavors">
        <div class="ccb__search-wrap">
          <label for="ClassicCookieSearch-{{ section.id }}">Search flavors</label>
          <div class="ccb__search-field">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m21 21-4.35-4.35m2.35-5.65a8 8 0 1 1-16 0 8 8 0 0 1 16 0Z" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
            <input
              id="ClassicCookieSearch-{{ section.id }}"
              type="search"
              placeholder="Try chocolate, cinnamon, oatmeal..."
              autocomplete="off"
              data-ccb-search
            >
          </div>
        </div>

        <div class="ccb__sort-wrap">
          <label for="ClassicCookieSort-{{ section.id }}">Sort flavors</label>
          <select id="ClassicCookieSort-{{ section.id }}" data-ccb-sort>
            <option value="featured">Featured order</option>
            <option value="az">Name: A–Z</option>
            <option value="za">Name: Z–A</option>
          </select>
        </div>

        <div class="ccb__filter-group" aria-label="Filter by taste profile">
          <button type="button" class="ccb__filter is-active" data-ccb-filter="all" aria-pressed="true">All flavors</button>
          <button type="button" class="ccb__filter" data-ccb-filter="chocolate" aria-pressed="false">Chocolate lovers</button>
          <button type="button" class="ccb__filter" data-ccb-filter="classic" aria-pressed="false">Bakery classics</button>
          <button type="button" class="ccb__filter" data-ccb-filter="spice-fruit" aria-pressed="false">Cinnamon &amp; fruit</button>
          <button type="button" class="ccb__filter" data-ccb-filter="nutty" aria-pressed="false">Nutty favorites</button>
          <button type="button" class="ccb__filter" data-ccb-filter="celebration" aria-pressed="false">Celebration</button>
        </div>

        <div class="ccb__results-bar">
          <p data-ccb-status aria-live="polite">Showing {{ flavor_count }} flavors</p>
          <button type="button" class="ccb__clear" data-ccb-clear hidden>Clear filters</button>
        </div>
      </div>

      {%- if cookie_collection != blank and cookie_collection.products.size > 0 -%}
        <div class="ccb__product-grid" data-ccb-grid>
          {%- for product in cookie_collection.products -%}
            {% render 'classic-cookie-card',
              product: product,
              position: forloop.index,
              show_quick_add: section.settings.show_quick_add
            %}
          {%- endfor -%}
        </div>

        <div class="ccb__empty" data-ccb-empty hidden>
          <span class="ccb__empty-icon" aria-hidden="true">🍪</span>
          <h4>No flavors matched that search</h4>
          <p>Try a broader search or reset the taste-profile filters.</p>
          <button type="button" class="ccb__button ccb__button--primary" data-ccb-empty-reset>Show all flavors</button>
        </div>
      {%- else -%}
        <div class="ccb__empty">
          <h4>Select the Classic Cookie collection</h4>
          <p>Open this section in the Theme Editor and choose the collection that contains the individual Classic Cookie flavors.</p>
        </div>
      {%- endif -%}

      <p class="ccb__allergen-note">
        <strong>Ingredient and allergen reminder:</strong> Review the individual product page and package labeling before purchasing or serving, especially when accommodating food allergies or dietary restrictions.
      </p>
    </section>

    <section class="ccb__variety" aria-labelledby="ClassicCookieVariety-{{ section.id }}">
      <div class="ccb__variety-copy">
        <p class="ccb__kicker">Can’t choose just one?</p>
        <h3 id="ClassicCookieVariety-{{ section.id }}">Bring home a Classic Cookie variety pack</h3>
        <p>{{ section.settings.variety_text }}</p>

        <ul class="ccb__check-list" role="list">
          <li>Multiple customer-favorite flavors</li>
          <li>48 individually wrapped cookies</li>
          <li>Ideal for offices, events, classrooms, and gifting</li>
        </ul>

        <div class="ccb__variety-actions">
          {%- if variety_product != blank -%}
            <a class="ccb__button ccb__button--primary" href="{{ variety_product.url }}">View variety pack</a>
            {%- if section.settings.show_quick_add and variety_product.available -%}
              <form method="post" action="{{ routes.cart_add_url }}" class="ccb__quick-form">
                <input type="hidden" name="id" value="{{ variety_product.selected_or_first_available_variant.id }}">
                <input type="hidden" name="quantity" value="1">
                <button type="submit" name="add" class="ccb__button ccb__button--secondary ccb__button--light">Add variety pack</button>
              </form>
            {%- endif -%}
          {%- else -%}
            <a class="ccb__button ccb__button--primary" href="/products/classic-cookie-soft-baked-variety-pack-48-individually-wrapped-cookies-3-oz-per-cookie">View variety pack</a>
          {%- endif -%}
        </div>
      </div>

      <div class="ccb__variety-product">
        <span class="ccb__burst">48 cookies</span>
        {%- if variety_product != blank and variety_product.featured_image != blank -%}
          <a href="{{ variety_product.url }}" aria-label="View {{ variety_product.title | escape }}">
            {{ variety_product.featured_image
              | image_url: width: 900
              | image_tag:
                loading: 'lazy',
                widths: '360, 560, 760, 900',
                sizes: '(min-width: 990px) 42vw, 90vw',
                alt: variety_alt
            }}
          </a>
          <div class="ccb__variety-meta">
            <strong>{{ variety_product.title }}</strong>
            <span>{{ variety_product.price | money }}</span>
          </div>
        {%- else -%}
          <img
            src="https://cdn.shopify.com/s/files/1/0653/0262/6407/files/classic-cookie-variety-bundle.png?v=1782936456"
            alt="Classic Cookie soft-baked variety pack"
            width="700"
            height="700"
            loading="lazy"
          >
        {%- endif -%}
      </div>
    </section>

    <section class="ccb__support" aria-labelledby="ClassicCookieSupport-{{ section.id }}">
      <div>
        <p class="ccb__kicker">Questions about an order?</p>
        <h3 id="ClassicCookieSupport-{{ section.id }}">Our team is ready to help</h3>
        <p>Contact Monroe Systems for Business for product, ordering, or shipping assistance.</p>
      </div>
      <div class="ccb__support-actions">
        {%- if section.settings.phone != blank -%}
          <a class="ccb__button ccb__button--primary" href="{{ phone_href }}">Call {{ section.settings.phone }}</a>
        {%- endif -%}
        {%- if section.settings.email != blank -%}
          <a class="ccb__button ccb__button--secondary ccb__button--light" href="mailto:{{ section.settings.email | escape }}">Email customer service</a>
        {%- endif -%}
      </div>
    </section>
  </div>
</section>

{% schema %}
{
  "name": "Classic Cookie spotlight",
  "tag": "section",
  "class": "section-classic-cookie",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "A Classic Cookie brand spotlight"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Big, soft-baked cookies made to brighten the day"
    },
    {
      "type": "richtext",
      "id": "introduction",
      "label": "Introduction",
      "default": "<p>Classic Cookie has been baking oversized, individually wrapped cookies since 1984. Explore comforting classics, chocolate-rich favorites, and playful flavors for the office, school lunches, events, gifting, or an anytime treat.</p>"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Classic Cookie logo"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Optional hero image",
      "info": "Leave blank to display a collage from the selected collection."
    },
    {
      "type": "collection",
      "id": "flavor_collection",
      "label": "Flavor collection"
    },
    {
      "type": "product",
      "id": "variety_product",
      "label": "Variety pack product"
    },
    {
      "type": "checkbox",
      "id": "show_quick_add",
      "label": "Show quick-add buttons",
      "default": true
    },
    {
      "type": "text",
      "id": "primary_button_label",
      "label": "Primary button label",
      "default": "Explore the flavors"
    },
    {
      "type": "text",
      "id": "secondary_button_label",
      "label": "Secondary button label",
      "default": "Shop all Classic Cookie"
    },
    {
      "type": "textarea",
      "id": "variety_text",
      "label": "Variety pack text",
      "default": "The variety pack makes it easy to sample several Classic Cookie favorites or stock a shared snack area with something for everyone."
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone number",
      "default": "(267) 580-2600"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Customer service email",
      "default": "csr@monroe-systems.com"
    },
    {
      "type": "header",
      "content": "Colors and width"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#d3252d"
    },
    {
      "type": "color",
      "id": "accent_dark",
      "label": "Dark accent",
      "default": "#98151c"
    },
    {
      "type": "color",
      "id": "cream_color",
      "label": "Cream background",
      "default": "#fff4e8"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#241916"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 1100,
      "max": 1700,
      "step": 50,
      "unit": "px",
      "label": "Maximum content width",
      "default": 1450
    }
  ],
  "presets": [
    {
      "name": "Classic Cookie spotlight"
    }
  ]
}
{% endschema %}