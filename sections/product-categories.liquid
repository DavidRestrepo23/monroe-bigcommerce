{{ 'component-product-categories.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #ProductCategories-{{ section.id }} {
    --pc-accent: {{ section.settings.accent_color | default: '#1F6F75' }};
    --pc-text: {{ section.settings.text_color | default: '#FFFFFF' }};
    --pc-radius: {{ section.settings.card_radius | default: 20 }}px;
    --pc-gap: {{ section.settings.gap | default: 16 }}px;
    --pc-card-height: {{ section.settings.card_height | default: 520 }}px;
    --pc-pad-v: {{ section.settings.padding_vertical | default: 48 }}px;
    --pc-pad-h: {{ section.settings.padding_horizontal | default: 16 }}px;
  }
  @media (max-width: 768px) {
    #ProductCategories-{{ section.id }} {
      --pc-pad-v: {{ section.settings.padding_vertical_mobile | default: 28 }}px;
      --pc-pad-h: {{ section.settings.padding_horizontal_mobile | default: 16 }}px;
    }
  }
{%- endstyle -%}

<section
  id="ProductCategories-{{ section.id }}"
  class="product-categories"
  style="padding: var(--pc-pad-v) var(--pc-pad-h);"
>
  {%- if section.settings.heading != blank -%}
    <h2 class="product-categories__heading">{{ section.settings.heading }}</h2>
  {%- endif -%}

  {%- if section.blocks.size > 0 -%}
    <div
      class="product-categories__grid"
      style="grid-template-columns: repeat({{ section.settings.columns_desktop | default: 4 }}, 1fr);"
    >
      {%- for block in section.blocks -%}
        {%- if block.type == 'category' -%}
          {%- assign card_link = block.settings.link | default: '#' -%}
          <a
            href="{{ card_link }}"
            class="product-categories__card"
            aria-label="{{ block.settings.title | default: 'Category' }}"
            {{ block.shopify_attributes }}
          >
            <div class="product-categories__media">
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 800
                  | image_tag:
                    loading: 'lazy',
                    sizes: '(min-width: 990px) 25vw, 50vw',
                    widths: '320, 480, 640, 800, 1000',
                    alt: block.settings.image.alt | default: block.settings.title,
                    class: 'product-categories__image'
                }}
              {%- else -%}
                {{ 'collection-1' | placeholder_svg_tag: 'product-categories__image placeholder-svg' }}
              {%- endif -%}
              <span class="product-categories__overlay" aria-hidden="true"></span>
            </div>

            <span class="product-categories__arrow" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="7" y1="17" x2="17" y2="7"></line>
                <polyline points="7 7 17 7 17 17"></polyline>
              </svg>
            </span>

            {%- if block.settings.title != blank -%}
              <h3 class="product-categories__title">{{ block.settings.title }}</h3>
            {%- endif -%}
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Product Categories",
  "tag": "section",
  "class": "section-product-categories page-width",
  "settings": [
    { "type": "header", "content": "Heading" },
    { "type": "text", "id": "heading", "label": "Section heading", "default": "OUR TOP PRODUCT CATEGORIES" },
    { "type": "header", "content": "Layout" },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "label": "Columns (desktop)",
      "default": 4
    },
    {
      "type": "range",
      "id": "gap",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Gap between cards",
      "default": 16
    },
    {
      "type": "range",
      "id": "card_height",
      "min": 320,
      "max": 720,
      "step": 20,
      "unit": "px",
      "label": "Card height",
      "default": 520
    },
    {
      "type": "range",
      "id": "card_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Card corner radius",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_vertical",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Vertical padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_vertical_mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Vertical padding (mobile)",
      "default": 28
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "min": 0,
      "max": 64,
      "step": 4,
      "unit": "px",
      "label": "Horizontal padding",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_horizontal_mobile",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "label": "Horizontal padding (mobile)",
      "default": 16
    },
    { "type": "header", "content": "Style" },
    { "type": "color", "id": "accent_color", "label": "Arrow background", "default": "#1F6F75" },
    { "type": "color", "id": "text_color", "label": "Title color", "default": "#FFFFFF" }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Background image" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Categories",
      "blocks": [
        { "type": "category", "settings": { "title": "Printing Calculators" } },
        { "type": "category", "settings": { "title": "Calculator Tape Rolls" } },
        { "type": "category", "settings": { "title": "Office Equipment" } },
        { "type": "category", "settings": { "title": "Calculator Ink Ribbons" } }
      ]
    }
  ]
}
{% endschema %}
