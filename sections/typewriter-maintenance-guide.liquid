  <script>
    (function(){
      var root = document.getElementById('tw-maintenance-{{ section.id }}');
      if(!root) return;

      var yearEl = root.querySelector('#twYear-{{ section.id }}');
      if(yearEl) yearEl.textContent = new Date().getFullYear();

      root.addEventListener('click', function(e){
        var a = e.target && e.target.closest ? e.target.closest('a[href^="#"]') : null;
        if(!a || !root.contains(a)) return;

        var id = a.getAttribute('href');
        if(!id || id === '#') return;

        var target;
        try{
          target = root.querySelector(id);
        }catch(err){
          return;
        }

        if(!target) return;
        e.preventDefault();
        target.scrollIntoView({ behavior:'smooth', block:'start' });
      });

      var copyBtn = root.querySelector('#twCopyLinkBtn-{{ section.id }}');
      if(copyBtn){
        copyBtn.addEventListener('click', function(){
          if(!navigator.clipboard){
            copyBtn.textContent = 'Copy unavailable';
            setTimeout(function(){ copyBtn.textContent = 'Copy page link'; }, 1600);
            return;
          }

          navigator.clipboard.writeText(window.location.href).then(function(){
            copyBtn.textContent = 'Link copied';
            setTimeout(function(){ copyBtn.textContent = 'Copy page link'; }, 1600);
          }).catch(function(){
            copyBtn.textContent = 'Copy failed';
            setTimeout(function(){ copyBtn.textContent = 'Copy page link'; }, 1600);
          });
        });
      }

      var dlBtn = root.querySelector('#twDownloadBtn-{{ section.id }}');
      if(dlBtn){
        dlBtn.addEventListener('click', function(){
          try{
            if(typeof window.gtag === 'function'){
              window.gtag('event', 'download', {
                event_category:'Guide',
                event_label:'Typewriter Maintenance Guide PDF'
              });
            }
          }catch(err){}
        });
      }
    })();
  </script>

