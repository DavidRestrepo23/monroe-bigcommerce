    background:#fff;
    padding: 16px;
    margin-top: 14px;
  }

  .msf-seo-title{
    margin:0 0 10px;
    font-size:22px;
    font-weight:700;
  }

  .msf-seo-text{
    margin:0 0 12px;
    line-height:1.55;
  }

  .msf-seo-callout{
    border:1px solid rgba(0,0,0,.18);
    border-radius: var(--msf-radius-sm);
    padding: 12px;
    background: rgba(102,102,102,.08);
    margin-bottom: 12px;
  }

  .msf-seo-callout-title{
    font-weight:700;
    margin-bottom: 8px;
  }

  .msf-seo-list{
    margin:0;
    padding-left: 18px;
    line-height:1.6;
  }

  .msf-seo-actions{
    display:flex;
    gap: 10px;
    flex-wrap:wrap;
    margin-top: 12px;
  }

  .msf-seo-btn{
    height:46px;
    border-radius: 14px;
    padding: 0 14px;
    border:5px solid #000000;
    display:inline-flex;
    align-items:center;
    justify-content:center;
    text-decoration:none;
    font-weight:900;
    background:#fff;
  }

  .msf-seo-btn-primary{
    background: var(--msf-main);
    border-color: var(--msf-main);
    color:#ffffff;
    border: 5px solid #000000;
  }

  .msf-seo-fine{
    margin: 10px 0 0;
    line-height:1.55;
  }

  .msf-seo-links{
    display:flex;
    gap: 12px;
    flex-wrap:wrap;
    margin-top: 12px;
  }

  .msf-seo-link{
    font-weight:700;
    text-decoration: underline;
  }

  .msf-kb-grid{
    display:grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    margin-top: 10px;
  }

  .msf-kb-item{
    border:1px solid rgba(0,0,0,.12);
    border-radius: var(--msf-radius-sm);
    padding: 12px;
    background:#fff;
  }

  .msf-kb-title{
    font-weight:700;
    margin-bottom: 6px;
  }

  .msf-kb-text{
    line-height:1.55;
  }

  .msf-seo-faq{
    margin-top: 14px;
    border:1px solid var(--msf-border);
    border-radius: var(--msf-radius);
    box-shadow: var(--msf-shadow);
    background:#fff;
    padding: 16px;
  }

  .msf-seo-qa{
    border-top:1px solid rgba(0,0,0,.12);
    padding-top: 10px;
    margin-top: 10px;
  }

  .msf-seo-qa:first-of-type{
    border-top:none;
    padding-top:0;
    margin-top:0;
  }

  .msf-seo-qa summary{
    cursor:pointer;
    font-weight:700;
    line-height:1.45;
  }

  .msf-seo-answer{
    padding-top: 10px;
    line-height:1.55;
  }

  @media (max-width: 1100px){
    .msf-hero-inner{ grid-template-columns: 1fr; }
    .msf-controls-grid{ grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .msf-grid{ grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .msf-seo-grid{ grid-template-columns: 1fr; }
    .msf-kb-grid{ grid-template-columns: 1fr; }
    .msf-status{ margin-left: 0; width:100%; }
