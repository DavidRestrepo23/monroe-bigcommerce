{{ 'monroe-toner-finder.css' | asset_url | stylesheet_tag }}
<script src="{{ 'monroe-toner-finder.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign heading_tag = section.settings.heading_tag | default: 'h1'
  assign support_email = section.settings.support_email | default: 'csr@monroe-systems.com'
  assign phone_display = section.settings.phone_display | default: '(267) 580-2600'
  assign phone_link = section.settings.phone_link | default: '+12675802600'
  assign email_subject = 'Toner Compatibility Request' | url_encode
-%}

<section
  id="MonroeTonerFinder-{{ section.id }}"
  class="msf-tool"
  data-msf-root
  data-section-id="{{ section.id }}"
  data-csv-url="{{ section.settings.csv_url | escape }}"
  data-page-size="{{ section.settings.page_size }}"
  style="--msf-main: {{ section.settings.main_color }}; --msf-accent: {{ section.settings.accent_color }}; --msf-section-pt: {{ section.settings.padding_top }}px; --msf-section-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="msf-topbar" aria-hidden="true"></div>

  <div class="msf-shell">
    <header class="msf-hero" id="toner-finder-top">
      <div class="msf-hero__grid">
        <div class="msf-hero__copy">
          <{{ heading_tag }} class="msf-title">{{ section.settings.heading | escape }}</{{ heading_tag }}>
          <p class="msf-subtitle">{{ section.settings.subheading | escape }}</p>

          <nav class="msf-jumps" aria-label="Toner finder page sections">
            <a class="msf-jump" href="#toner-finder-tool">Use the Finder</a>
            <a class="msf-jump" href="#toner-finder-results">View Results</a>
            <a class="msf-jump" href="#toner-compatibility-chart">Compatibility Chart</a>
            <a class="msf-jump" href="#toner-resources">Shop by Brand</a>
            <a class="msf-jump" href="#toner-finder-faq">FAQs</a>
          </nav>
        </div>

        <aside class="msf-hero-card" aria-label="Information needed for an exact toner match">
          <h2 class="msf-hero-card__title">Need an exact match?</h2>
          <ul class="msf-checklist">
            <li>Printer brand and exact model</li>
            <li>Toner part number or SKU</li>
            <li>Color and yield preference</li>
          </ul>
          <div class="msf-button-row">
            <a class="msf-button msf-button--primary" href="mailto:{{ support_email | escape }}?subject={{ email_subject }}">Email Us</a>
            <a class="msf-button msf-button--secondary" href="tel:{{ phone_link | escape }}">Call {{ phone_display | escape }}</a>
          </div>
          <p class="msf-fine-print">If your toner does not appear in the finder, it does not necessarily mean we do not carry it.</p>
        </aside>
      </div>
    </header>

    <section class="msf-panel" id="toner-finder-tool" aria-labelledby="msf-finder-title-{{ section.id }}">
      <div class="msf-panel__head">
        <h2 class="msf-heading" id="msf-finder-title-{{ section.id }}">Search Your Printer Supplies</h2>
        <p>Start with Printer Brand and Printer Model for the most accurate match. You can also search by toner name, SKU, color, or page yield.</p>
      </div>

      <form class="msf-filter-form" data-msf-form novalidate>
        <div class="msf-filter-grid">
          <div class="msf-field msf-field--brand">
            <label for="msf-brand-{{ section.id }}">Printer Brand</label>
            <select id="msf-brand-{{ section.id }}" data-msf-brand disabled>
              <option value="">All printer brands</option>
            </select>
          </div>

          <div class="msf-field msf-field--model">
            <label for="msf-model-{{ section.id }}">Printer Model</label>
            <select id="msf-model-{{ section.id }}" data-msf-model disabled>
              <option value="">All printer models</option>
            </select>
          </div>

          <div class="msf-field msf-field--search">
            <label for="msf-search-{{ section.id }}">Search Supplies</label>
            <input
              id="msf-search-{{ section.id }}"
              data-msf-search
              type="search"
              placeholder="Search by toner name, SKU, model, color, or yield"
              autocomplete="off"
              enterkeyhint="search"
            >
            <small>Enter at least two characters when using search by itself.</small>
          </div>

          <div class="msf-field msf-field--color">
            <label for="msf-color-{{ section.id }}">Color</label>
            <select id="msf-color-{{ section.id }}" data-msf-color disabled>
              <option value="">All colors</option>
            </select>
          </div>

          <div class="msf-field msf-field--yield">
            <label for="msf-yield-{{ section.id }}">Minimum Page Yield</label>
            <input id="msf-yield-{{ section.id }}" data-msf-min-yield type="number" min="0" step="1" placeholder="0" inputmode="numeric">
          </div>

          <div class="msf-field msf-field--sort">
            <label for="msf-sort-{{ section.id }}">Sort Results</label>
            <select id="msf-sort-{{ section.id }}" data-msf-sort disabled>
              <option value="yield_desc">Yield: high to low</option>
              <option value="yield_asc">Yield: low to high</option>
              <option value="name_asc">Name: A to Z</option>
              <option value="name_desc">Name: Z to A</option>
            </select>
          </div>
        </div>

        <div class="msf-actions">
          <button class="msf-button msf-button--primary" type="button" data-msf-download disabled>Download Model Chart</button>
          <button class="msf-button msf-button--secondary" type="button" data-msf-print disabled>Print Model Chart</button>
          <button class="msf-button msf-button--secondary" type="reset" data-msf-reset disabled>Clear Filters</button>
          <button class="msf-button msf-button--secondary" type="button" data-msf-retry hidden>Retry Data Load</button>
          <div class="msf-status" data-msf-status role="status" aria-live="polite">Loading toner data…</div>
        </div>
      </form>

      <div class="msf-help-callout">
        <div>
          <h3>Do not see your toner?</h3>
          <p>Send us the printer brand, exact model, and toner part number. We will confirm compatibility and help you choose the appropriate yield.</p>
        </div>
        <div class="msf-button-row">
          <a class="msf-button msf-button--primary" href="mailto:{{ support_email | escape }}?subject={{ email_subject }}">Email Your Model</a>
          <a class="msf-button msf-button--secondary" href="tel:{{ phone_link | escape }}">Call Support</a>
        </div>
      </div>
    </section>

    <section class="msf-panel" id="toner-finder-results" aria-labelledby="msf-results-title-{{ section.id }}">
      <div class="msf-results-head">
        <div>
          <h2 class="msf-heading" id="msf-results-title-{{ section.id }}">Matching Toner Supplies</h2>
          <p class="msf-results-context" data-msf-context></p>
        </div>
        <span class="msf-count" data-msf-count>0 results</span>
      </div>

      <div class="msf-empty-state" data-msf-gate>
        Choose a printer brand or model, apply a filter, or search by toner name or SKU to view matching supplies.
      </div>

      <div data-msf-results aria-live="polite" aria-busy="false"></div>

      <div class="msf-load-more" data-msf-load-more-wrap hidden>
        <button class="msf-button msf-button--secondary" type="button" data-msf-load-more>Load More</button>
      </div>
    </section>

    <section class="msf-panel" id="toner-compatibility-chart" data-msf-chart-card hidden aria-labelledby="msf-chart-title-{{ section.id }}">
      <div class="msf-panel__head">
        <h2 class="msf-heading" id="msf-chart-title-{{ section.id }}">Printer Model Compatibility Chart</h2>
        <p data-msf-chart-label></p>
      </div>

      <div class="msf-table-wrap" role="region" aria-label="Toner compatibility chart" tabindex="0">
        <table class="msf-table" data-msf-chart-table>
          <thead>
            <tr>
              <th scope="col">Printer Brand</th>
              <th scope="col">Printer Model</th>
              <th scope="col">Toner</th>
              <th scope="col">SKU</th>
              <th scope="col">Color</th>
              <th scope="col">Yield</th>
              <th scope="col">Product</th>
            </tr>
          </thead>
          <tbody data-msf-chart-body></tbody>
        </table>
      </div>
    </section>

    <section class="msf-content-grid" aria-label="Toner help and shopping resources">
      <article class="msf-content-card" id="toner-finder-help">
        <h2 class="msf-content-title">Can’t Find Your Toner Here?</h2>
        <p>If your toner does not appear in the results, it does not mean we do not carry it. Many replacements share part numbers across several printer models, and availability can change.</p>

        <div class="msf-info-box">
          <h3>Fastest way to get an exact match</h3>
          <ul>
            <li><strong>Printer brand and exact model</strong></li>
            <li><strong>Toner part number or SKU</strong></li>
            <li><strong>Color and preferred page yield</strong></li>
          </ul>
        </div>

        <div class="msf-button-row">
          <a class="msf-button msf-button--primary" href="mailto:{{ support_email | escape }}?subject={{ email_subject }}">Email Us Your Model</a>
          <a class="msf-button msf-button--secondary" href="tel:{{ phone_link | escape }}">Call {{ phone_display | escape }}</a>
        </div>
      </article>

      {%- if section.settings.show_resources -%}
        <article class="msf-content-card" id="toner-resources">
          <h2 class="msf-content-title">Shop Toner by Brand and Category</h2>
          <p>Prefer to browse? Use these links to explore printer supplies by brand or category.</p>

          <div class="msf-resource-links">
            <a href="/office-products/ink-toner/smart-print-supplies/">Smart Printer Supplies</a>
            <a href="/office-products/ink-and-toner/printer-drums-and-drum-kits/">Printer Drums and Drum Kits</a>
            <a href="/office-products/ink-and-toner/canon/">Canon Toner</a>
            <a href="/office-products/ink-and-toner/dell/">Dell Toner</a>
            <a href="/office-products/ink-and-toner/hp/">HP Toner</a>
            <a href="/office-products/ink-and-toner/kodak/">Kodak Toner</a>
            <a href="/office-products/ink-and-toner/kyocera/">Kyocera Toner</a>
            <a href="/office-products/ink-and-toner/lexmark/">Lexmark Toner</a>
            <a href="/office-products/ink-and-toner/okidata/">Okidata Toner</a>
            <a href="/office-products/ink-and-toner/pitney-bowes/">Pitney Bowes Toner</a>
            <a href="/office-products/ink-and-toner/ricoh/">Ricoh Toner</a>
            <a href="/office-products/ink-and-toner/samsung/">Samsung Toner</a>
            <a href="/office-products/ink-and-toner/xerox/">Xerox Toner</a>
          </div>
        </article>
      {%- endif -%}
    </section>

    <section class="msf-content-card msf-knowledge" aria-labelledby="msf-knowledge-title-{{ section.id }}">
      <h2 class="msf-content-title" id="msf-knowledge-title-{{ section.id }}">How to Find the Correct Printer Toner</h2>
      <p>Use the exact printer model whenever possible. Printer series can include similar submodels that use different cartridges, and standard-yield and high-yield cartridges may share similar names.</p>

      <div class="msf-knowledge-grid">
        <div>
          <h3>Standard vs. High Yield</h3>
          <p>High-yield toner prints more pages and may reduce cost per page for offices with frequent print volume.</p>
        </div>
        <div>
          <h3>Model Variations Matter</h3>
          <p>Check the complete model number printed on the front, back, or settings screen of the printer.</p>
        </div>
        <div>
          <h3>Search by SKU</h3>
          <p>The part number on an existing toner box, cartridge label, or prior invoice is often the fastest search method.</p>
        </div>
        <div>
          <h3>Ask Before Ordering</h3>
          <p>For uncommon submodels or uncertain part numbers, contact Monroe and we will confirm compatibility.</p>
        </div>
      </div>

      <div class="msf-text-links">
        <a href="/contact-monroe-printing-calculator-company/">Contact Monroe</a>
        <a href="/office-products/ink-and-toner/">Shop All Toner</a>
      </div>
    </section>

    {%- if section.settings.show_faq -%}
      <section class="msf-faq" id="toner-finder-faq" aria-labelledby="msf-faq-title-{{ section.id }}">
        <h2 class="msf-content-title" id="msf-faq-title-{{ section.id }}">Toner Compatibility FAQs</h2>

        <details>
          <summary>Why might my toner not appear in the finder?</summary>
          <p>Some listings share multiple part numbers, some printer models have regional variations, and availability can change. Contact us with the printer model and toner part number when a match does not appear.</p>
        </details>

        <details>
          <summary>What information should I send for the fastest match?</summary>
          <p>Send the printer brand and exact model, the toner part number from the box or cartridge label, the color, and whether you prefer standard or high yield.</p>
        </details>

        <details>
          <summary>Can Monroe help me choose between standard and high yield?</summary>
          <p>Yes. Share your approximate monthly print volume and we can help identify the most practical yield for your office.</p>
        </details>

        <details>
          <summary>How is the compatibility chart created?</summary>
          <p>The chart is generated from Monroe’s published toner data. For unusual printer submodels, contact us so we can verify compatibility before you order.</p>
        </details>
      </section>

      <script type="application/ld+json">
        {
          "@context": "https://schema.org",
          "@type": "FAQPage",
          "mainEntity": [
            {
              "@type": "Question",
              "name": "Why might my toner not appear in the finder?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Some listings share multiple part numbers, some printer models have regional variations, and availability can change. Contact Monroe with the printer model and toner part number when a match does not appear."
              }
            },
            {
              "@type": "Question",
              "name": "What information should I send for the fastest toner match?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Send the printer brand and exact model, the toner part number from the box or cartridge label, the color, and whether you prefer standard or high yield."
              }
            },
            {
              "@type": "Question",
              "name": "Can Monroe help me choose between standard and high yield toner?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Yes. Share your approximate monthly print volume and Monroe can help identify the most practical yield for your office."
              }
            },
            {
              "@type": "Question",
              "name": "How is the toner compatibility chart created?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "The chart is generated from Monroe's published toner data. For unusual printer submodels, contact Monroe to verify compatibility before ordering."
              }
            }
          ]
        }
      </script>
    {%- endif -%}

    <noscript>
      <div class="msf-panel">
        <h2 class="msf-heading">JavaScript Required</h2>
        <p>This finder requires JavaScript to load toner data. Call {{ phone_display | escape }} or email {{ support_email | escape }} for assistance.</p>
      </div>
    </noscript>
  </div>
</section>

{% schema %}
{
  "name": "Monroe toner finder",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Printer Toner Supply Finder"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag",
      "default": "h1",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" }
      ],
      "info": "Use H2 if the page template already displays the page title as an H1."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Intro text",
      "default": "Find the right toner fast. Filter by printer brand and model or search by toner name or SKU."
    },
    {
      "type": "text",
      "id": "csv_url",
      "label": "Published Google Sheets CSV URL",
      "default": "https://docs.google.com/spreadsheets/d/e/2PACX-1vRi_wzfF3eX5KmEkQhAVfSIrNln1bYHABlkYJceHzOa8tgV05pIb4Djj3zrDRyC1AP318vgXZlftDkx/pub?gid=0&single=true&output=csv",
      "info": "Use the published CSV URL. A pubhtml URL is automatically converted, but CSV is preferred."
    },
    {
      "type": "range",
      "id": "page_size",
      "label": "Results loaded at a time",
      "min": 8,
      "max": 24,
      "step": 4,
      "default": 12
    },
    {
      "type": "color",
      "id": "main_color",
      "label": "Main color",
      "default": "#007681"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#666666"
    },
    {
      "type": "text",
      "id": "support_email",
      "label": "Support email",
      "default": "csr@monroe-systems.com"
    },
    {
      "type": "text",
      "id": "phone_display",
      "label": "Displayed phone number",
      "default": "(267) 580-2600"
    },
    {
      "type": "text",
      "id": "phone_link",
      "label": "Phone link",
      "default": "+12675802600"
    },
    {
      "type": "checkbox",
      "id": "show_resources",
      "label": "Show brand and category links",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_faq",
      "label": "Show FAQ and FAQ structured data",
      "default": true
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 56
    }
  ],
  "presets": [
    {
      "name": "Monroe toner finder"
    }
  ]
}
{% endschema %}