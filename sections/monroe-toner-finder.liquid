<!-- Monroe Toner Finder Tool | Final Combined HTML + CSS + JS -->
<section class="msf-tool" id="msfTool">

  <!-- Top Accent Bar -->
  <div class="msf-topbar" aria-hidden="true"></div>

  <div class="msf-wrap">

    <!-- Hero -->
    <header class="msf-hero" id="toner-finder-top">
      <div class="msf-hero-inner">
        <div class="msf-hero-copy">
          <h1 class="msf-title">Printer Toner Supply Finder</h1>
          <p class="msf-subtitle">
            Find the right toner fast. Filter by printer brand and model or search by SKU. Results stay hidden until you filter or search to keep the page fast.
          </p>

          <!-- Quick Jump Links -->
          <nav class="msf-jumps" aria-label="Page sections">
            <a class="msf-jump" href="#toner-finder-tool">Use the Finder</a>
            <a class="msf-jump" href="#toner-finder-results">View Results</a>
            <a class="msf-jump" href="#toner-compatibility-chart-anchor">Compatibility Chart</a>
            <a class="msf-jump" href="#toner-resources">Shop by Brand</a>
            <a class="msf-jump" href="#toner-finder-faq">FAQs</a>
          </nav>
        </div>

        <div class="msf-hero-side">
          <div class="msf-hero-card">
            <div class="msf-hero-card-title">Need an exact match</div>
            <ul class="msf-hero-list">
              <li>Printer brand and model</li>
              <li>Toner part number or SKU</li>
              <li>Color and yield preference</li>
            </ul>
            <div class="msf-hero-actions">
              <a class="msf-btn msf-btn-primary" href="mailto:csr@monroe-systems.com?subject=Toner%20Compatibility%20Request">Email Us</a>
              <a class="msf-btn" href="tel:+12675802600">Call (267) 580-2600</a>
            </div>
            <div class="msf-hero-fine">
              If your toner does not appear here, it does not mean we do not carry it. Our sourcing options change frequently.
            </div>
          </div>
        </div>
      </div>
    </header>

    <!-- Finder -->
    <section class="msf-card" id="toner-finder-tool" aria-label="Finder filters">
      <div class="msf-card-head">
        <h2 class="msf-h2">Search Your Printer Supplies</h2>
        <p class="msf-muted">
          Start with Printer Brand and Model for the most accurate matches. You can also search by SKU or toner name.
        </p>
      </div>

      <div class="msf-controls-grid">
        <div class="msf-field">
          <label class="msf-label" for="msfBrand">Printer Brand</label>
          <select class="msf-select" id="msfBrand" disabled>
            <option value="">All</option>
          </select>
        </div>

        <div class="msf-field">
          <label class="msf-label" for="msfModel">Printer Model</label>
          <select class="msf-select" id="msfModel" disabled>
            <option value="">All</option>
          </select>
        </div>

        <div class="msf-field">
          <label class="msf-label" for="msfSearch">Search Supplies</label>
          <input class="msf-input" id="msfSearch" type="text" placeholder="Search by SKU or toner name" autocomplete="off" />
        </div>

        <div class="msf-field">
          <label class="msf-label" for="msfColor">Color</label>
          <select class="msf-select" id="msfColor" disabled>
            <option value="">All</option>
          </select>
        </div>

        <div class="msf-field">
          <label class="msf-label" for="msfMinYield">Min Yield</label>
          <input class="msf-input" id="msfMinYield" type="number" min="0" placeholder="0" inputmode="numeric" />
        </div>

        <div class="msf-field">
          <label class="msf-label" for="msfSort">Sort</label>
          <select class="msf-select" id="msfSort" disabled>
            <option value="yield_desc">Yield high to low</option>
            <option value="yield_asc">Yield low to high</option>
            <option value="name_asc">Name A to Z</option>
            <option value="name_desc">Name Z to A</option>
          </select>
        </div>
      </div>

      <div class="msf-actions">
        <button class="msf-btn msf-btn-primary" id="msfDownload" disabled>Download Chart (CSV)</button>
        <button class="msf-btn" id="msfPrint" disabled>Print Chart</button>
        <button class="msf-btn msf-btn-ghost" id="msfReset">Reset</button>

        <div class="msf-status" id="msfStatus" aria-live="polite">Loading toner data</div>
      </div>

      <div class="msf-callout">
        <div class="msf-callout-title">Do not see your toner</div>
        <p class="msf-callout-text">
          Send your printer brand and model plus the toner part number or SKU, and we will confirm the correct cartridge and best yield option.
        </p>
        <div class="msf-callout-actions">
          <a class="msf-btn msf-btn-primary" href="mailto:sales@monroe-systems.com?subject=Toner%20Finder%20Help">Email Your Model</a>
          <a class="msf-btn" href="tel:+12675802600">Call Support</a>
        </div>
      </div>
    </section>

    <!-- Results -->
    <section class="msf-card" id="toner-finder-results" aria-label="Results">
      <div class="msf-meta">
        <span class="msf-pill" id="msfCount">0 results</span>
        <span class="msf-muted" id="msfContext"></span>
      </div>

      <div class="msf-empty" id="msfGate">
        Use Printer Brand and Model filters or search by SKU to view results.
      </div>

      <div id="msfResults"></div>

      <div class="msf-loadmore" id="msfLoadMoreWrap" hidden>
        <button class="msf-btn" id="msfLoadMore">Load More</button>
      </div>
    </section>

    <!-- Chart Anchor -->
    <div id="toner-compatibility-chart-anchor"></div>

    <!-- Compatibility Chart -->
    <section class="msf-card" id="msfChartCard" hidden aria-label="Compatibility chart">
      <div class="msf-card-head">
        <h2 class="msf-h2">Compatibility Chart</h2>
        <p class="msf-muted" id="msfChartLabel"></p>
      </div>

      <div class="msf-table-wrap" role="region" aria-label="Chart table" tabindex="0">
        <table class="msf-table" id="msfChartTable">
          <thead>
            <tr>
              <th>Brand</th>
              <th>Model</th>
              <th>Toner</th>
              <th>SKU</th>
              <th>Color</th>
              <th>Yield</th>
              <th>Link</th>
            </tr>
          </thead>
          <tbody id="msfChartBody"></tbody>
        </table>
      </div>
    </section>

    <!-- SEO + Resource Section -->
    <div class="msf-seo">

