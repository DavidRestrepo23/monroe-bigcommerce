    display:grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
  }

  .msf-item{
    border:1px solid var(--msf-border);
    border-radius: var(--msf-radius);
    overflow:hidden;
    background:#fff;
    box-shadow: 0 10px 22px rgba(0,0,0,.08);
    display:flex;
    flex-direction:column;
    min-height: 100%;
  }

  .msf-item-top{
    padding: 12px 14px 0;
    display:flex;
    justify-content:space-between;
    gap: 10px;
    align-items:flex-start;
  }

  .msf-brand{
    font-weight:700;
  }

  .msf-badge{
    border:1px solid rgba(0,0,0,.18);
    border-radius: 999px;
    padding: 6px 10px;
    font-weight:700;
    font-size:16px;
    background:#fff;
  }

  .msf-media{
    padding: 10px 14px 0;
    display:flex;
    flex-direction:column;
    gap: 10px;
  }

  .msf-img-wrap{
    border:1px solid rgba(0,0,0,.15);
    border-radius: var(--msf-radius-sm);
    overflow:hidden;
    background:#fff;
    height: 200px;
    display:flex;
    align-items:center;
    justify-content:center;
  }

  .msf-img{
    width:100%;
    height:100%;
    object-fit:contain;
    display:block;
  }

  .msf-view{
    display:inline-flex;
    align-items:center;
    justify-content:center;
    height:46px;
    border-radius: 14px;
    border: 1px solid var(--msf-main);
    background: var(--msf-main);
    color:#ffffff;
    text-decoration:none;
    font-weight:700;
  }

  .msf-body{
    padding: 12px 14px 14px;
    display:flex;
    flex-direction:column;
    gap: 10px;
  }

  .msf-name{
    margin:0;
    font-size:20px;
    font-weight:700;
    line-height:1.35;
  }

  .msf-kv{
    display:grid;
    grid-template-columns: 1fr;
    gap: 10px;
  }

  .msf-kv-box{
    border:1px solid rgba(0,0,0,.15);
    border-radius: var(--msf-radius-sm);
    padding: 10px 12px;
    background:#fff;
  }

  .msf-kv-label{
    font-size:16px;
    font-weight:700;
    margin-bottom: 4px;
  }

  .msf-kv-value{
    font-weight:700;
  }

  .msf-loadmore{
    margin-top: 14px;
    display:flex;
    justify-content:center;
  }

  .msf-table-wrap{
    overflow:auto;
    border:1px solid rgba(0,0,0,.18);
    border-radius: var(--msf-radius-sm);
    background:#fff;
  }

  .msf-table{
    width:100%;
    border-collapse:collapse;
    min-width: 980px;
  }

  .msf-table thead th{
    position: sticky;
    top: 0;
    background:#fff;
    z-index: 1;
    text-align:left;
    padding: 12px;
    border-bottom: 2px solid rgba(0,0,0,.18);
    font-weight:700;
    white-space: nowrap;
  }

  .msf-table tbody td{
    padding: 12px;
    border-bottom: 1px solid rgba(0,0,0,.12);
    font-weight:700;
    vertical-align: top;
  }

  .msf-seo{
    margin-top: 18px;
  }

  .msf-seo-grid{
    display:grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }

  .msf-seo-card{
    border:1px solid var(--msf-border);
