        </p>
      </div>
    </noscript>

  </div>
</section>

<script>
(function(){
  "use strict";

  var MSF_CSV_URL = "https://docs.google.com/spreadsheets/d/e/2PACX-1vRi_wzfF3eX5KmEkQhAVfSIrNln1bYHABlkYJceHzOa8tgV05pIb4Djj3zrDRyC1AP318vgXZlftDkx/pubhtml";

  function onReady(fn){
    if(document.readyState === "loading"){
      document.addEventListener("DOMContentLoaded", fn);
    }else{
      fn();
    }
  }

  function norm(v){ return (v == null ? "" : String(v)).trim(); }
  function key(v){ return norm(v).toLowerCase(); }

  function toInt(v){
    var n = parseInt(String(v || "").replace(/[^\d]/g,""), 10);
    return isNaN(n) ? null : n;
  }

  function escapeHtml(s){
    return String(s || "")
      .replace(/&/g,"&amp;")
      .replace(/</g,"&lt;")
      .replace(/>/g,"&gt;")
      .replace(/"/g,"&quot;")
      .replace(/'/g,"&#39;");
  }

  function csvEscape(value){
    var s = String(value == null ? "" : value);
    if(/[,"\n]/.test(s)) s = '"' + s.replace(/"/g,'""') + '"';
    return s;
  }

  function uniqueSorted(arr){
    var seen = Object.create(null);
    var out = [];
    for(var i=0;i<arr.length;i++){
      var v = norm(arr[i]);
      if(!v) continue;
      var k = key(v);
      if(seen[k]) continue;
      seen[k] = true;
      out.push(v);
    }
    out.sort(function(a,b){ return a.localeCompare(b); });
    return out;
  }

  function setOptions(selectEl, values, placeholder){
    var current = selectEl.value;
    selectEl.innerHTML = "";
    var opt0 = document.createElement("option");
    opt0.value = "";
    opt0.textContent = placeholder || "All";
    selectEl.appendChild(opt0);

    values.forEach(function(v){
      var o = document.createElement("option");
      o.value = v;
      o.textContent = v;
      selectEl.appendChild(o);
    });

    if(current && values.indexOf(current) !== -1) selectEl.value = current;
  }

  function parseModelsList(s){
    var t = norm(s);
    if(!t) return [];
    return t.split(/[\|\n,;]+/).map(function(x){ return norm(x); }).filter(Boolean);
  }

  function detectDelimiter(firstLine){
    var commaCount = (firstLine.match(/,/g) || []).length;
    var tabCount = (firstLine.match(/\t/g) || []).length;
    return tabCount > commaCount ? "\t" : ",";
  }

  function parseDelimited(text){
    text = String(text || "").replace(/\r\n/g,"\n").replace(/\r/g,"\n");
    var firstLine = text.split("\n")[0] || "";
    var delim = detectDelimiter(firstLine);

    var rows = [];
    var i=0, field="", row=[], inQuotes=false;

    function pushField(){ row.push(field); field=""; }
    function pushRow(){
      if(row.length === 1 && norm(row[0]) === "") { row=[]; return; }
      rows.push(row); row=[];
    }

    while(i < text.length){
      var c = text[i];

      if(inQuotes){
        if(c === '"'){
          if(text[i+1] === '"'){ field += '"'; i += 2; continue; }
          inQuotes = false; i++; continue;
        }
        field += c; i++; continue;
      }

      if(c === '"'){ inQuotes = true; i++; continue; }
      if(c === delim){ pushField(); i++; continue; }
      if(c === "\n"){ pushField(); pushRow(); i++; continue; }

      field += c; i++;
    }
    pushField(); pushRow();

    if(rows.length < 2) return { headers: [], records: [], delimiter: delim };

    var headers = rows[0].map(function(h){ return key(h); });
    var records = [];

    for(var r=1; r<rows.length; r++){
      var obj = {};
      for(var c2=0; c2<headers.length; c2++){
        obj[headers[c2]] = norm(rows[r][c2]);
      }
      var any = Object.keys(obj).some(function(k){ return norm(obj[k]) !== ""; });
      if(any) records.push(obj);
    }

    return { headers: headers, records: records, delimiter: delim };
  }

  function normalizeRecords(records){
    var expanded = [];
    for(var i=0;i<records.length;i++){
      var r = records[i];

      var printerBrand = norm(r["printer_brand"]) || "(Brand not provided)";
      var models = parseModelsList(r["compatible_models"]);
      if(!models.length) models = ["(Model list not provided)"];

      var tonerName = norm(r["toner_model"]) || norm(r["sku"]) || "Toner";
      var sku = norm(r["sku"]) || "";
      var color = norm(r["color"]) || "—";
      var yieldPages = norm(r["yield_pages"]) || "—";
      var yieldNum = toInt(yieldPages);

      var imageUrl = norm(r["image_url"]) || "";
      var productUrl = norm(r["product_url"]) || "";

      for(var m=0;m<models.length;m++){
        expanded.push({
          printer_brand: printerBrand,
          printer_model: models[m],
          toner: tonerName,
          sku: sku,
          color: color,
          yield_pages: yieldPages,
          yield_num: yieldNum,
          image_url: imageUrl,
          product_url: productUrl
        });
      }
    }
    return expanded;
  }

  function placeholderImageSvg(){
    var svg =
      '<svg xmlns="http://www.w3.org/2000/svg" width="800" height="600" viewBox="0 0 800 600">'
      + '<rect width="800" height="600" fill="#ffffff"/>'
      + '<rect x="60" y="70" width="680" height="460" rx="28" fill="#f4f4f4" stroke="#000" stroke-width="6"/>'
      + '<text x="400" y="320" text-anchor="middle" font-family="Times New Roman" font-size="44" font-weight="700" fill="#000">Toner</text>'
      + '</svg>';
    return "data:image/svg+xml;charset=utf-8," + encodeURIComponent(svg);
  }

  function cardHtml(r){
    var img = r.image_url ? r.image_url : placeholderImageSvg();
    var viewBtn = r.product_url
      ? '<a class="msf-view" href="' + escapeHtml(r.product_url) + '">View Toner</a>'
      : '<span class="msf-view" style="opacity:.65; pointer-events:none;">View Toner</span>';

    return ''
      + '<article class="msf-item">'
        + '<div class="msf-item-top">'
          + '<div class="msf-brand">' + escapeHtml(r.printer_brand || "—") + '</div>'
          + (r.color ? '<div class="msf-badge">' + escapeHtml(r.color) + '</div>' : '')
        + '</div>'
        + '<div class="msf-media">'
          + '<div class="msf-img-wrap">'
            + '<img class="msf-img" src="' + escapeHtml(img) + '" alt="' + escapeHtml(r.toner) + '" loading="lazy" decoding="async" onerror="this.onerror=null;this.src=\'' + escapeHtml(placeholderImageSvg()) + '\';" />'
          + '</div>'
          + viewBtn
        + '</div>'
        + '<div class="msf-body">'
          + '<h3 class="msf-name">' + escapeHtml(r.toner) + '</h3>'
          + '<div class="msf-kv">'
            + '<div class="msf-kv-box"><div class="msf-kv-label">SKU</div><div class="msf-kv-value">' + escapeHtml(r.sku || "—") + '</div></div>'
            + '<div class="msf-kv-box"><div class="msf-kv-label">Yield</div><div class="msf-kv-value">' + escapeHtml(r.yield_pages || "—") + '</div></div>'
            + '<div class="msf-kv-box"><div class="msf-kv-label">Color</div><div class="msf-kv-value">' + escapeHtml(r.color || "—") + '</div></div>'
          + '</div>'
        + '</div>'
      + '</article>';
  }

  onReady(function(){
    var els = {
      brand: document.getElementById("msfBrand"),
      model: document.getElementById("msfModel"),
      search: document.getElementById("msfSearch"),
      color: document.getElementById("msfColor"),
      minYield: document.getElementById("msfMinYield"),
      sort: document.getElementById("msfSort"),
      reset: document.getElementById("msfReset"),
      download: document.getElementById("msfDownload"),
      print: document.getElementById("msfPrint"),
      status: document.getElementById("msfStatus"),
      count: document.getElementById("msfCount"),
      context: document.getElementById("msfContext"),
      gate: document.getElementById("msfGate"),
      results: document.getElementById("msfResults"),
      loadMoreWrap: document.getElementById("msfLoadMoreWrap"),
      loadMore: document.getElementById("msfLoadMore"),
      chartCard: document.getElementById("msfChartCard"),
      chartLabel: document.getElementById("msfChartLabel"),
      chartBody: document.getElementById("msfChartBody"),
      chartTable: document.getElementById("msfChartTable")
    };

    function setStatus(t){ if(els.status) els.status.textContent = t; }
    function fail(msg){
      setStatus(msg);
      if(els.results) els.results.innerHTML = '<div class="msf-empty">' + escapeHtml(msg) + '</div>';
    }

    // Hard guard: if HTML IDs are missing, we stop and show why
    var requiredIds = ["brand","model","search","color","minYield","sort","reset","download","print","status","count","context","gate","results","loadMoreWrap","loadMore","chartCard","chartLabel","chartBody","chartTable"];
    for(var i=0;i<requiredIds.length;i++){
      if(!els[requiredIds[i]]){
        return fail("Tool error: Missing HTML element for ID msf" + requiredIds[i].charAt(0).toUpperCase() + requiredIds[i].slice(1) + ". Make sure you pasted the full combined HTML block.");
      }
    }

    var state = {
      rows: [],
      filtered: [],
      visibleCount: 0,
      pageSize: 24,
      hasInteracted: false
    };

    function buildContextLine(){
      var parts = [];
      if(els.brand.value) parts.push(els.brand.value);
      if(els.model.value) parts.push(els.model.value);
      if(els.color.value) parts.push("Color: " + els.color.value);
      if(norm(els.minYield.value)) parts.push("Min yield: " + norm(els.minYield.value));
      if(norm(els.search.value)) parts.push("Search: " + norm(els.search.value));
      els.context.textContent = parts.length ? ("Showing matches for " + parts.join(" | ")) : "";
    }

    function hasAnyFilter(){
      var q = norm(els.search.value);
      var hasSearch = q.length >= 2;
      return !!(norm(els.brand.value) || norm(els.model.value) || norm(els.color.value) || norm(els.minYield.value) || hasSearch);
    }

    function rowMatches(r){
      var br = norm(els.brand.value);
      var mo = norm(els.model.value);
      var col = norm(els.color.value);
      var minY = toInt(els.minYield.value);

      var q = key(els.search.value);
      var useSearch = q.length >= 2;

      if(br && r.printer_brand !== br) return false;
      if(mo && r.printer_model !== mo) return false;
      if(col && r.color !== col) return false;

      if(minY != null){
        if(r.yield_num == null || r.yield_num < minY) return false;
      }

      if(useSearch){
        var hay = [r.toner, r.sku, r.printer_brand, r.printer_model, r.color, r.yield_pages].map(key).join(" ");
        if(hay.indexOf(q) === -1) return false;
      }
      return true;
    }

    function applySort(list){
      var mode = norm(els.sort.value) || "yield_desc";
      var arr = list.slice();

      arr.sort(function(a,b){
        if(mode === "yield_asc"){
          var ay = (a.yield_num == null ? 999999999 : a.yield_num);
          var by = (b.yield_num == null ? 999999999 : b.yield_num);
          return ay - by || a.toner.localeCompare(b.toner);
        }
        if(mode === "yield_desc"){
          var ay2 = (a.yield_num == null ? -1 : a.yield_num);
          var by2 = (b.yield_num == null ? -1 : b.yield_num);
          return by2 - ay2 || a.toner.localeCompare(b.toner);
        }
        if(mode === "name_desc") return b.toner.localeCompare(a.toner);
        return a.toner.localeCompare(b.toner);
      });

      return arr;
    }

    function updateModelOptions(){
      var br = norm(els.brand.value);
      var models = uniqueSorted(
        state.rows
          .filter(function(r){ return !br || r.printer_brand === br; })
          .map(function(r){ return r.printer_model; })
      );

      setOptions(els.model, models, "All");
      els.model.disabled = models.length === 0;
    }

    function rebuildDropdowns(){
      var brands = uniqueSorted(state.rows.map(function(r){ return r.printer_brand; }));
      setOptions(els.brand, brands, "All");
      els.brand.disabled = brands.length === 0;

      updateModelOptions();

      var colors = uniqueSorted(state.rows.map(function(r){ return r.color; }));
      setOptions(els.color, colors, "All");
      els.color.disabled = colors.length === 0;

      els.sort.disabled = false;
    }

    function setChartButtonsEnabled(enabled){
      els.download.disabled = !enabled;
      els.print.disabled = !enabled;
    }

    function renderChart(){
      var br = norm(els.brand.value);
      var mo = norm(els.model.value);

      if(!mo || mo === "(Model list not provided)"){
        els.chartCard.hidden = true;
        els.chartBody.innerHTML = "";
        return;
      }

      var chartRows = state.rows.filter(function(r){
        if(br && r.printer_brand !== br) return false;
        return r.printer_model === mo;
      });

      chartRows = chartRows.slice().sort(function(a,b){
        var ay = (a.yield_num == null ? -1 : a.yield_num);
        var by = (b.yield_num == null ? -1 : b.yield_num);
        return by - ay || a.toner.localeCompare(b.toner);
      });

      els.chartLabel.textContent = (br ? br + " " : "") + mo;

      var body = "";
      for(var i=0;i<chartRows.length;i++){
        var r = chartRows[i];
        var link = r.product_url ? '<a href="' + escapeHtml(r.product_url) + '">View</a>' : "—";
        body += "<tr>"
          + "<td>" + escapeHtml(r.printer_brand) + "</td>"
          + "<td>" + escapeHtml(r.printer_model) + "</td>"
          + "<td>" + escapeHtml(r.toner) + "</td>"
          + "<td>" + escapeHtml(r.sku || "—") + "</td>"
          + "<td>" + escapeHtml(r.color || "—") + "</td>"
          + "<td>" + escapeHtml(r.yield_pages || "—") + "</td>"
          + "<td>" + link + "</td>"
        + "</tr>";
      }

      els.chartBody.innerHTML = body || '<tr><td colspan="7">No chart rows available for this model.</td></tr>';
      els.chartCard.hidden = false;
    }

    function renderResults(){
      buildContextLine();

      if(!state.hasInteracted && !hasAnyFilter()){
        els.count.textContent = "0 results";
        els.gate.style.display = "block";
        els.results.innerHTML = "";
        els.loadMoreWrap.hidden = true;
        els.chartCard.hidden = true;
        setChartButtonsEnabled(false);
        return;
      }

      els.gate.style.display = "none";

      var filtered = state.rows.filter(rowMatches);
      filtered = applySort(filtered);
      state.filtered = filtered;

      els.count.textContent = filtered.length + (filtered.length === 1 ? " result" : " results");

      if(filtered.length === 0){
        els.results.innerHTML = '<div class="msf-empty">No matches found. Try clearing filters or searching by SKU. If you still do not see it, call or email us and we will help match it.</div>';
        els.loadMoreWrap.hidden = true;
        els.chartCard.hidden = true;
        setChartButtonsEnabled(false);
        return;
      }

      if(state.visibleCount === 0) state.visibleCount = Math.min(state.pageSize, filtered.length);

      var slice = filtered.slice(0, state.visibleCount);
      var html = '<div class="msf-grid">';
      for(var i=0;i<slice.length;i++) html += cardHtml(slice[i]);
      html += '</div>';

      els.results.innerHTML = html;

      if(state.visibleCount < filtered.length){
        els.loadMoreWrap.hidden = false;
        els.loadMore.textContent = "Load More (" + (filtered.length - state.visibleCount) + " remaining)";
      }else{
        els.loadMoreWrap.hidden = true;
      }

      renderChart();
      setChartButtonsEnabled(!!norm(els.model.value) && els.model.value !== "(Model list not provided)");
    }

    function downloadChart(){
      if(els.download.disabled) return;

      var br = norm(els.brand.value);
      var mo = norm(els.model.value);
      if(!mo) return;

      var rows = state.rows.filter(function(r){
        if(br && r.printer_brand !== br) return false;
        return r.printer_model === mo;
      });

      rows = rows.slice().sort(function(a,b){
        var ay = (a.yield_num == null ? -1 : a.yield_num);
        var by = (b.yield_num == null ? -1 : b.yield_num);
        return by - ay || a.toner.localeCompare(b.toner);
      });

      var headers = ["printer_brand","printer_model","toner","sku","color","yield_pages","product_url"];
      var lines = [headers.join(",")];

      for(var i=0;i<rows.length;i++){
        var r = rows[i];
        lines.push(headers.map(function(h){ return csvEscape(r[h] || ""); }).join(","));
      }

      var blob = new Blob([lines.join("\n")], { type: "text/csv;charset=utf-8;" });
      var filename = ["monroe", br || "all-brands", mo, "compatibility-chart"].join("_")
        .replace(/\s+/g,"_").replace(/[^a-zA-Z0-9_]+/g,"") + ".csv";

      var a = document.createElement("a");
      a.href = URL.createObjectURL(blob);
      a.download = filename;
      document.body.appendChild(a);
      a.click();
      setTimeout(function(){ URL.revokeObjectURL(a.href); a.remove(); }, 80);
    }

    function printChart(){
      if(els.print.disabled) return;

      var title = els.chartLabel.textContent || "Compatibility Chart";
      var html = '<!doctype html><html><head><meta charset="utf-8">'
        + '<title>' + escapeHtml(title) + '</title>'
        + '<style>'
        + 'body{font-family:"Times New Roman",Times,serif;color:#000;padding:16px;font-size:18px;}'
        + 'h1{margin:0 0 10px;font-size:22px;font-weight:700;}'
        + 'p{margin:0 0 14px;}'
        + 'table{width:100%;border-collapse:collapse;font-size:16px;}'
        + 'th,td{border:1px solid rgba(0,0,0,.35);padding:8px;text-align:left;vertical-align:top;}'
        + 'th{background:#f3f3f3;}'
        + '</style></head><body>'
        + '<h1>Monroe Compatibility Chart</h1>'
        + '<p>' + escapeHtml(title) + '</p>'
        + els.chartTable.outerHTML
        + '</body></html>';

      var w = window.open("", "_blank");
      if(!w) return;
      w.document.open(); w.document.write(html); w.document.close();
      w.focus(); w.print();
    }

    function debounce(fn, wait){
      var t;
      return function(){
        clearTimeout(t);
        t = setTimeout(fn, wait);
      };
    }

    function applyFilters(){
      state.hasInteracted = true;
      state.visibleCount = 0;
      renderResults();
    }

    function resetAll(){
      els.brand.value = "";
      els.model.value = "";
      els.search.value = "";
      els.color.value = "";
      els.minYield.value = "";
      els.sort.value = "yield_desc";

      state.hasInteracted = false;
      state.visibleCount = 0;

      updateModelOptions();
      renderResults();
    }

    function wire(){
      els.brand.addEventListener("change", function(){
        state.hasInteracted = true;
        els.model.value = "";
        updateModelOptions();
        applyFilters();
      });

      els.model.addEventListener("change", applyFilters);
      els.color.addEventListener("change", applyFilters);
      els.minYield.addEventListener("input", debounce(applyFilters, 140));
      els.sort.addEventListener("change", applyFilters);
      els.search.addEventListener("input", debounce(applyFilters, 160));

      els.reset.addEventListener("click", resetAll);

      els.loadMore.addEventListener("click", function(){
        var max = state.filtered.length;
        state.visibleCount = Math.min(max, state.visibleCount + state.pageSize);
        renderResults();
      });

      els.download.addEventListener("click", downloadChart);
      els.print.addEventListener("click", printChart);
    }

    setStatus("Loading toner data");
    setChartButtonsEnabled(false);

    fetch(MSF_CSV_URL, { credentials:"omit", cache:"no-store" })
      .then(function(res){
        if(!res.ok) throw new Error("Fetch failed: " + res.status);
        return res.text();
      })
      .then(function(text){
        var parsed = parseDelimited(text);

        if(!parsed.records.length){
          throw new Error("Parsed 0 rows. Delimiter detected: " + parsed.delimiter);
        }

        state.rows = normalizeRecords(parsed.records);

        rebuildDropdowns();
        wire();

        setStatus("Ready (" + state.rows.length + " rows)");
        renderResults();
      })
      .catch(function(err){
        fail("Unable to load toner data: " + (err && err.message ? err.message : "Unknown error"));
      });
  });
})();
</script>

