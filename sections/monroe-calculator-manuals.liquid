{{ 'section-calculator-manuals.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign support_phone = section.settings.support_phone | default: '267-580-2600'
  assign support_phone_href = support_phone | replace: '(', '' | replace: ')', '' | replace: '-', '' | replace: ' ', '' | replace: '.', ''
  assign classroom_url = section.settings.classroom_url
  if classroom_url == blank
    assign classroom_url = '/pages/calculator-classroom'
  endif
-%}

<section
  id="CalculatorManuals-{{ section.id }}"
  class="calculator-manuals"
  data-calculator-manuals
  style="
    --manuals-accent: {{ section.settings.accent_color }};
    --manuals-accent-dark: {{ section.settings.accent_dark_color }};
    --manuals-page-bg: {{ section.settings.page_background }};
    --manuals-card-bg: {{ section.settings.card_background }};
  "
  aria-labelledby="CalculatorManualsHeading-{{ section.id }}"
>
  <div class="calculator-manuals__hero">
    <div class="calculator-manuals__hero-grid page-width">
      <div class="calculator-manuals__hero-copy">
        {%- if section.settings.eyebrow != blank -%}
          <p class="calculator-manuals__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}

        <h2 id="CalculatorManualsHeading-{{ section.id }}" class="calculator-manuals__heading">
          {{ section.settings.heading | escape }}
        </h2>

        {%- if section.settings.introduction != blank -%}
          <div class="calculator-manuals__intro rte">
            {{ section.settings.introduction }}
          </div>
        {%- endif -%}

        <div class="calculator-manuals__hero-actions">
          <a class="calculator-manuals__button calculator-manuals__button--light" href="#ManualFinder-{{ section.id }}">
            Find your manual
            <svg aria-hidden="true" viewBox="0 0 24 24">
              <path d="m7 10 5 5 5-5"/>
            </svg>
          </a>

          <a class="calculator-manuals__text-link" href="{{ classroom_url }}">
            Visit Calculator Classroom
            <svg aria-hidden="true" viewBox="0 0 24 24">
              <path d="M5 12h14M13 6l6 6-6 6"/>
            </svg>
          </a>
        </div>

        <dl class="calculator-manuals__stats" aria-label="Manual library statistics">
          <div>
            <dt>23</dt>
            <dd>Total manuals</dd>
          </div>
          <div>
            <dt>8</dt>
            <dd>Current models</dd>
          </div>
          <div>
            <dt>15</dt>
            <dd>Previous models</dd>
          </div>
        </dl>
      </div>

      <div class="calculator-manuals__hero-visual" aria-hidden="true">
        <div class="calculator-manuals__document calculator-manuals__document--back">
          <span></span><span></span><span></span><span></span>
        </div>
        <div class="calculator-manuals__document calculator-manuals__document--front">
          <div class="calculator-manuals__pdf-badge">PDF</div>
          <span class="calculator-manuals__document-title">OPERATING<br>INSTRUCTIONS</span>
          <span></span><span></span><span></span>
        </div>

        <div class="calculator-manuals__hero-product">
          {%- if section.settings.hero_image != blank -%}
            {{
              section.settings.hero_image
              | image_url: width: 720
              | image_tag:
                widths: '320, 480, 640, 720',
                sizes: '(min-width: 990px) 420px, 70vw',
                loading: 'eager',
                alt: section.settings.hero_image.alt
            }}
          {%- else -%}
            <img
              src="https://cdn.shopify.com/s/files/1/0653/0262/6407/files/UltimateX_-_Calc_Classroom.png?v=1784053898"
              alt=""
              width="480"
              height="525"
              loading="eager"
            >
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>

  <div class="calculator-manuals__body page-width">
    <div id="ManualFinder-{{ section.id }}" class="calculator-manuals__finder">
      <div class="calculator-manuals__finder-heading">
        <div>
          <p class="calculator-manuals__kicker">Manual finder</p>
          <h3>Search by calculator model</h3>
        </div>
        <p data-manual-results-count aria-live="polite">23 manuals shown</p>
      </div>

      <div class="calculator-manuals__controls">
        <label class="calculator-manuals__search">
          <span class="visually-hidden">Search calculator manuals by model</span>
          <svg aria-hidden="true" viewBox="0 0 24 24">
            <circle cx="11" cy="11" r="7"></circle>
            <path d="m20 20-4-4"></path>
          </svg>
          <input
            type="search"
            inputmode="search"
            autocomplete="off"
            placeholder="Try 8130X, UltimateX, 2020Plus..."
            data-manual-search
          >
          <button type="button" data-manual-clear-search aria-label="Clear manual search" hidden>
            <svg aria-hidden="true" viewBox="0 0 24 24">
              <path d="m6 6 12 12M18 6 6 18"></path>
            </svg>
          </button>
        </label>

        <div class="calculator-manuals__filters" role="group" aria-label="Filter calculator manuals">
          <button type="button" data-manual-filter="all" aria-pressed="true">
            All models
            <span>23</span>
          </button>
          <button type="button" data-manual-filter="current" aria-pressed="false">
            Current
            <span>8</span>
          </button>
          <button type="button" data-manual-filter="previous" aria-pressed="false">
            Previous
            <span>15</span>
          </button>
        </div>
      </div>
    </div>

    <noscript>
      <p class="calculator-manuals__noscript">
        JavaScript is disabled. All calculator manuals are displayed below and remain available.
      </p>
    </noscript>

    {% render 'calculator-manuals-content' %}

    <div class="calculator-manuals__empty" data-manual-empty hidden>
      <div class="calculator-manuals__empty-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24">
          <path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H18a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6.5A2.5 2.5 0 0 1 4 18.5v-13Z"></path>
          <path d="M8 7h8M8 11h6"></path>
        </svg>
      </div>
      <h3>No calculator manuals matched your search</h3>
      <p>Check the model number or clear the filters to view the complete manual library.</p>
      <button type="button" class="calculator-manuals__button calculator-manuals__button--primary" data-manual-reset>
        Clear search and filters
      </button>
    </div>

    <aside class="calculator-manuals__help" aria-labelledby="ManualHelpHeading-{{ section.id }}">
      <div class="calculator-manuals__help-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.69 2.8a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.28-1.28a2 2 0 0 1 2.11-.45c.9.33 1.84.56 2.8.69A2 2 0 0 1 22 16.92Z"></path>
        </svg>
      </div>

      <div class="calculator-manuals__help-copy">
        <p class="calculator-manuals__kicker">Need help identifying your calculator?</p>
        <h3 id="ManualHelpHeading-{{ section.id }}">{{ section.settings.support_heading | escape }}</h3>
        {%- if section.settings.support_text != blank -%}
          <div class="rte">{{ section.settings.support_text }}</div>
        {%- endif -%}
      </div>

      <a
        class="calculator-manuals__button calculator-manuals__button--primary"
        href="tel:{{ support_phone_href }}"
      >
        Call {{ support_phone }}
        <svg aria-hidden="true" viewBox="0 0 24 24">
          <path d="M5 12h14M13 6l6 6-6 6"/>
        </svg>
      </a>
    </aside>
  </div>
</section>

<script src="{{ 'section-calculator-manuals.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Calculator manuals",
  "tag": "section",
  "class": "section-calculator-manuals",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Monroe support library"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Calculator Manuals & Product Guides"
    },
    {
      "type": "richtext",
      "id": "introduction",
      "label": "Introduction",
      "default": "<p>Find operating instructions for current and previous Monroe calculator models. Search by model number, then open the corresponding PDF manual in a new window.</p>"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero calculator image"
    },
    {
      "type": "url",
      "id": "classroom_url",
      "label": "Calculator Classroom link"
    },
    {
      "type": "header",
      "content": "Support callout"
    },
    {
      "type": "text",
      "id": "support_heading",
      "label": "Support heading",
      "default": "Our calculator specialists are ready to help"
    },
    {
      "type": "richtext",
      "id": "support_text",
      "label": "Support text",
      "default": "<p>If your model is not listed or you are unsure which manual you need, call us Monday through Friday from 8 a.m. to 5 p.m. Eastern Time.</p>"
    },
    {
      "type": "text",
      "id": "support_phone",
      "label": "Support phone number",
      "default": "267-580-2600"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#007681"
    },
    {
      "type": "color",
      "id": "accent_dark_color",
      "label": "Dark accent",
      "default": "#074f57"
    },
    {
      "type": "color",
      "id": "page_background",
      "label": "Page background",
      "default": "#f3f7f7"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Calculator manuals"
    }
  ]
}
{% endschema %}