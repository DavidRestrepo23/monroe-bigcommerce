{{ 'section-typewriter-reconditioning.css' | asset_url | stylesheet_tag }}
<script src="{{ 'section-typewriter-reconditioning.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign review_image = section.settings.review_image
  assign featured_collection = section.settings.featured_collection
  assign shop_url = section.settings.shop_link
  if featured_collection != blank
    assign shop_url = featured_collection.url
  endif
  if shop_url == blank
    assign shop_url = '/collections/ibm-wheelwriters'
  endif
-%}

<typewriter-reconditioning-process
  id="TypewriterReconditioning-{{ section.id }}"
  class="tw-reconditioning"
  data-section-id="{{ section.id }}"
  data-default-phase="all"
>
  <div class="tw-reconditioning__ink-line" aria-hidden="true"></div>

  <div class="tw-reconditioning__page">
    {% render 'typewriter-reconditioning-content', section: section %}

    {% render 'typewriter-reconditioning-steps', section: section %}

    {% render 'typewriter-reconditioning-reviews',
      section: section,
      review_image: review_image
    %}

    {%- if featured_collection != blank and featured_collection.products_count > 0 -%}
      <section class="tw-reconditioning__products" aria-labelledby="tw-products-title-{{ section.id }}">
        <div class="tw-reconditioning__section-heading tw-reconditioning__section-heading--split">
          <div>
            <p class="tw-reconditioning__kicker">From the workshop</p>
            <h2 id="tw-products-title-{{ section.id }}">{{ section.settings.products_heading | escape }}</h2>
          </div>
          <a class="tw-reconditioning__text-link" href="{{ featured_collection.url }}">
            View all {{ featured_collection.title | escape }}
          </a>
        </div>

        <ul class="tw-reconditioning__product-grid" role="list">
          {%- for product in featured_collection.products limit: section.settings.product_limit -%}
            <li>
              {% render 'typewriter-reconditioning-product-card', product: product %}
            </li>
          {%- endfor -%}
        </ul>
      </section>
    {%- endif -%}

    <section class="tw-reconditioning__closing" aria-labelledby="tw-closing-title-{{ section.id }}">
      <div>
        <p class="tw-reconditioning__kicker">Ready for the next page?</p>
        <h2 id="tw-closing-title-{{ section.id }}">{{ section.settings.closing_heading | escape }}</h2>
        <p>{{ section.settings.closing_text | escape }}</p>
      </div>
      <div class="tw-reconditioning__actions">
        <a class="tw-reconditioning__button tw-reconditioning__button--primary" href="{{ shop_url }}">
          {{ section.settings.shop_label | escape }}
        </a>
        <a class="tw-reconditioning__button tw-reconditioning__button--secondary" href="tel:4043771884">
          Call (404) 377-1884
        </a>
        <a class="tw-reconditioning__text-link" href="/pages/our-warranty-1">Read our warranty</a>
      </div>
    </section>
  </div>
</typewriter-reconditioning-process>

{% schema %}
{
  "name": "TW 21-step process",
  "tag": "section",
  "class": "section-tw-reconditioning-process",
  "settings": [
    {
      "type": "header",
      "content": "Introduction"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Inside the Typewriters.com workshop"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": "How a reconditioned typewriter gets ready to work"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Introduction",
      "default": "<p>Our 21-step process brings careful inspection, cleaning, adjustment, testing, and protective packing together in one workshop routine. Explore each phase to see what our technicians check before a reconditioned machine ships.</p>"
    },
    {
      "type": "text",
      "id": "experience_note",
      "label": "Experience note",
      "default": "More than half a century of typewriter experience"
    },
    {
      "type": "header",
      "content": "Customer review artwork"
    },
    {
      "type": "image_picker",
      "id": "review_image",
      "label": "Review collage (optional override)",
      "info": "Leave blank to use the packaged review image."
    },
    {
      "type": "header",
      "content": "Featured typewriters"
    },
    {
      "type": "collection",
      "id": "featured_collection",
      "label": "Featured collection",
      "info": "Optional. Product data remains current through Shopify."
    },
    {
      "type": "text",
      "id": "products_heading",
      "label": "Products heading",
      "default": "Reconditioned machines ready to type"
    },
    {
      "type": "range",
      "id": "product_limit",
      "min": 3,
      "max": 6,
      "step": 1,
      "default": 3,
      "label": "Products to show"
    },
    {
      "type": "header",
      "content": "Closing call to action"
    },
    {
      "type": "text",
      "id": "closing_heading",
      "label": "Heading",
      "default": "Find the reconditioned typewriter that fits your work"
    },
    {
      "type": "textarea",
      "id": "closing_text",
      "label": "Text",
      "default": "Browse current IBM Wheelwriters or contact our team for help choosing a model."
    },
    {
      "type": "text",
      "id": "shop_label",
      "label": "Shop button label",
      "default": "Shop IBM Wheelwriters"
    },
    {
      "type": "url",
      "id": "shop_link",
      "label": "Shop button link",
      "info": "Used when no featured collection is selected."
    }
  ],
  "presets": [
    {
      "name": "TW 21-step process"
    }
  ]
}
{% endschema %}